---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import WhatsApp from "../components/WhatsApp.astro";
import { getLocale, type Locale } from "../i18n/config";
import { getUi } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const lang = getLocale(Astro.props.lang ?? Astro.currentLocale);
const t = getUi(lang);
const { 
  title = t.layout.defaultTitle, 
  description = t.layout.defaultDescription,
} = Astro.props;
const gtmId = import.meta.env.GTM;
const shouldLoadGtm = Boolean(gtmId) && (import.meta.env.NODE_ENV !== "development");
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.webp" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{shouldLoadGtm && (
			<script is:inline define:vars={{ gtmId }}>
				(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
				new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
				j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
				'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
				})(window,document,'script','dataLayer',gtmId);
			</script>
		)}
	</head>
	<body class="bg-white text-slate-800 antialiased overflow-x-hidden selection:bg-accent selection:text-white">
		{shouldLoadGtm && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
				>
				</iframe>
			</noscript>
		)}

		<!-- Global Navigation Header -->
		<Header lang={lang} />

		<!-- Dynamic Page Injection Slot -->
		<slot />

		<!-- Global Brand Footer & Awards -->
		<Footer lang={lang} />

		<!-- Global Floating Back to Top Button -->
		<BackToTop lang={lang} />
		<WhatsApp lang={lang} />
	</body>
</html>
