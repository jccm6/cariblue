---
import { getLocale, type Locale } from "../i18n/config";
import { getUi } from "../i18n/ui";

interface Props {
  lang?: Locale;
}

const lang = getLocale(Astro.props.lang);
const t = getUi(lang).home.welcome;
---

<section id="bienvenido" class="relative bg-white pt-24 pb-20 px-6 md:px-12 lg:px-24">
  <div class="max-w-7xl mx-auto">
    <!-- Main Welcome Split Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-16">
      
      <!-- Left side: Image layout -->
      <div class="col-span-1 lg:col-span-5 relative">
        <div class="absolute -top-4 -left-4 w-12 h-12 border-t-2 border-l-2 border-accent"></div>
        <div class="absolute -bottom-4 -right-4 w-12 h-12 border-b-2 border-r-2 border-[#0f2e59]"></div>
        
        <div class="overflow-hidden rounded shadow-2xl relative group">
          <img 
            src="/bienvenido.webp" 
            alt={t.imageAlt} 
            class="w-full h-100 object-cover hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
            <span class="text-white text-xs font-semibold uppercase tracking-wider">{t.imageCaption}</span>
          </div>
        </div>
      </div>

      <!-- Right side: Text copy -->
      <div class="col-span-1 lg:col-span-7 text-left flex flex-col justify-center">
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight mb-6">
          {t.title} <span class="text-accent italic font-semibold">{t.titleAccent}</span>
        </h2>
        
        <div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal">
          {t.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>

    <!-- Statistics Overlapping Card -->
    <div class="w-full bg-white rounded-lg border border-slate-100 shadow-xl p-6 md:p-8 mt-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-4 divide-y md:divide-y-0 md:divide-x divide-slate-100">
        
        <!-- Stat 1 -->
        <div class="flex flex-col items-center justify-center text-center p-1">
          <div class="w-12 h-12 bg-blue-50 text-[#0f2e59] rounded-full flex items-center justify-center mb-3">
            <!-- Bed icon -->
             <img src="https://i.imgur.com/E74cztA.png" alt="Bed icon" class="w-8 h-8">
          </div>
          <span class="text-3xl md:text-4xl font-serif font-extrabold text-[#0f2e59]">51</span>
          <span class="text-sm uppercase tracking-wider font-semibold text-slate-400 mt-1">{t.stats[0]}</span>
        </div>

        <!-- Stat 2 -->
        <div class="flex flex-col items-center justify-center text-center p-1">
          <div class="w-12 h-12 bg-blue-50 text-[#0f2e59] rounded-full flex items-center justify-center mb-3">
            <!-- Pool / Waves icon -->
             <img src="https://i.imgur.com/E873Xz5.png" alt="Bed icon" class="w-8 h-8">
          </div>
          <span class="text-3xl md:text-4xl font-serif font-extrabold text-[#0f2e59]">3</span>
          <span class="text-sm uppercase tracking-wider font-semibold text-slate-400 mt-1">{t.stats[1]}</span>
        </div>

        <!-- Stat 3 -->
        <div class="flex flex-col items-center justify-center text-center p-1">
          <div class="w-12 h-12 bg-blue-50 text-[#0f2e59] rounded-full flex items-center justify-center mb-3">
            <!-- Restaurant icon -->
             <img src="https://i.imgur.com/Cobu7Hp.png" alt="Bed icon" class="w-8 h-8">
          </div>
          <span class="text-3xl md:text-4xl font-serif font-extrabold text-[#0f2e59]">3</span>
          <span class="text-sm uppercase tracking-wider font-semibold text-slate-400 mt-1">{t.stats[2]}</span>
        </div>

        <!-- Stat 4 -->
        <div class="flex flex-col items-center justify-center text-center p-1">
          <div class="w-12 h-12 bg-blue-50 text-[#0f2e59] rounded-full flex items-center justify-center mb-3">
            <!-- SPA / Flower icon -->
             <img src="https://i.imgur.com/x3oXCNs.png" alt="Bed icon" class="w-8 h-8">
          </div>
          <span class="text-3xl md:text-4xl font-serif font-extrabold text-[#0f2e59]">1</span>
          <span class="text-sm uppercase tracking-wider font-semibold text-slate-400 mt-1">{t.stats[3]}</span>
        </div>

        <!-- Stat 5 -->
        <div class="flex flex-col items-center justify-center text-center p-1">
          <div class="w-12 h-12 bg-blue-50 text-[#0f2e59] rounded-full flex items-center justify-center mb-3">
            <!-- Gym icon -->
             <img src="https://i.imgur.com/PZFYJ5K.png" alt="Bed icon" class="w-8 h-8">
          </div>
          <span class="text-3xl md:text-4xl font-serif font-extrabold text-[#0f2e59]">1</span>
          <span class="text-sm uppercase tracking-wider font-semibold text-slate-400 mt-1">{t.stats[4]}</span>
        </div>

      </div>
    </div>
  </div>
</section>
