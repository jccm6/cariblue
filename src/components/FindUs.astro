<section id="donde-encontrarnos" class="w-full bg-primary text-white">
  <div class="grid grid-cols-1 lg:grid-cols-12">
    
    <!-- Left Column: Google Map Embed (7 columns) -->
    <div class="lg:col-span-7 h-87.5 lg:h-125 w-full relative">
      <!-- Real high quality Google Map centered on Cocles Beach Puerto Viejo -->
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3933.360680052805!2d-82.74184302332371!3d9.650190490438069!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa650013b7fc357%3A0xcb6e0cea110c81dc!2sCariblue%20Beach%20and%20Jungle%20Resort!5e0!3m2!1ses-419!2scl!4v1780005084967!5m2!1ses-419!2scl" 
        class="w-full h-full border-0 grayscale hover:grayscale-0 transition-all duration-700" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="Cariblue Resort Location Map"
      ></iframe>
    </div>

    <!-- Right Column: Contact Details Card (5 columns) -->
    <div class="lg:col-span-5 bg-primary py-16 px-8 md:p-16 lg:p-20 flex flex-col justify-center text-left">
      <h2 class="text-3xl md:text-5xl font-serif font-bold mb-8 tracking-wide">
        Dónde encontrarnos
      </h2>
      
      <div class="space-y-8 text-xs md:text-sm">
        <!-- Physical Address -->
        <div class="flex items-start space-x-4">
          <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center shrink-0 text-[#e60067]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4.5 h-4.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
          </div>
          <div class="text-left">
            <h4 class="font-bold text-slate-100 uppercase tracking-widest text-[10px] mb-1">Dirección</h4>
            <p class="text-slate-300 font-light leading-relaxed">
              Cocles Beach, 1.5 Km, South Puerto Viejo,<br />
              70403 Puerto Viejo, Costa Rica.
            </p>
          </div>
        </div>

        <!-- Phone Lines -->
        <div class="flex items-start space-x-4">
          <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center shrink-0 text-[#e60067]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4.5 h-4.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.035 12.035 0 0 1-7.108-7.108c-.145-.44.02-.927.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
          </div>
          <div class="text-left">
            <h4 class="font-bold text-slate-100 uppercase tracking-widest text-[10px] mb-1">Contacto</h4>
            <ul class="space-y-1.5 text-slate-300 font-light">
              <li class="flex items-center space-x-2">
                <span class="font-semibold text-white/90">Fijo:</span>
                <a href="tel:+50627500035" class="hover:text-[#e60067] transition-colors">+506 2750 0035</a>
              </li>
              <li class="flex items-center space-x-2">
                <span class="font-semibold text-white/90">Whatsapp:</span>
                <a href="https://wa.me/50683141965" target="_blank" class="hover:text-green-400 transition-colors">+506 8314 1965</a>
              </li>
              <li class="flex items-center space-x-2">
                <span class="font-semibold text-white/90">TollFree:</span>
                <a href="tel:18886499773" class="hover:text-[#e60067] transition-colors">1-888-6499-773</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
