---
import { getLocale, type Locale } from "../i18n/config";
import { getRooms } from "../i18n/rooms";
import { getUi } from "../i18n/ui";

interface Props {
  lang?: Locale;
}

const lang = getLocale(Astro.props.lang);
const rooms = getRooms(lang);
const t = getUi(lang).home.rooms;
---

<section id="habitaciones" class="bg-slate-50/65 py-24 px-6 md:px-12 lg:px-24">
  <div class="max-w-7xl mx-auto text-center">
    
    <!-- Section Header -->
    <div class="mb-14">
      <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-3">{t.title}</h2>
      <p class="text-[10px] md:text-xs font-bold tracking-[0.25em] text-accent uppercase">
        {t.eyebrow}
      </p>
    </div>

    <!-- Carousel Container -->
    <div class="relative max-w-6xl mx-auto overflow-hidden px-4">
      <!-- Track -->
      <div id="room-track" class="flex transition-transform duration-500 ease-out gap-6" style="transform: translateX(0px);">
        {rooms.map((room) => (
          <div class="room-card min-w-full md:min-w-[calc(50%-12px)] bg-white rounded-md overflow-hidden border border-slate-100 shadow-lg flex flex-col hover:shadow-xl transition-all duration-300">
            <!-- Image Frame -->
            <div class="relative h-62.5 overflow-hidden group">
              <img 
                src={room.image} 
                alt={room.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 right-4 bg-primary/90 backdrop-blur-xs text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-xs">
                {t.onlineBooking}
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 md:p-8 flex-1 flex flex-col justify-between text-left">
              <div>
                <h3 class="text-xl md:text-2xl font-serif font-bold text-[#0f2e59] mb-4 text-center md:text-left">{room.title}</h3>
                
                <p class="text-xs text-slate-500 leading-relaxed text-center md:text-left mb-6 font-normal italic">
                  {room.description}
                </p>
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-1 text-center">
                <p class="text-xs text-slate-600 leading-relaxed font-normal mb-4">
                  <span class="font-bold">{t.acreage}</span><br>{room.acreage}
                </p>
                <p class="text-xs text-slate-600 leading-relaxed font-normal mb-4">
                  <span class="font-bold">{t.capacity}</span><br>{room.guests} {t.people}
                </p>
                <p class="text-xs text-slate-600 leading-relaxed font-normal mb-4">
                  <span class="font-bold">{t.beds}</span><br>{room.beds} {t.bedsUnit}
                </p>
              </div>

              <div class="text-center md:text-left">
                <a href={`${lang === "en" ? "/en/" : "/"}room/${room.slug}/`} class="inline-block text-accent hover:text-[#c20056] font-bold text-xs tracking-wider uppercase border-b-2 border-accent pb-1 transition-all">
                  {t.details} &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      <button 
        id="room-prev" 
        class="absolute left-0 top-[40%] -translate-y-1/2 bg-white/90 hover:bg-white text-[#0f2e59] p-3 rounded-full shadow-md z-20 border border-slate-100 hover:scale-105 transition-all focus:outline-none"
        aria-label={t.previous}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button 
        id="room-next" 
        class="absolute right-0 top-[40%] -translate-y-1/2 bg-white/90 hover:bg-white text-[#0f2e59] p-3 rounded-full shadow-md z-20 border border-slate-100 hover:scale-105 transition-all focus:outline-none"
        aria-label={t.next}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>

    <!-- Indicator Dots -->
    <div class="flex justify-center space-x-2.5 mt-10">
      {rooms.map((_, index) => (
        <button 
          class="room-dot w-2.5 h-2.5 rounded-full border border-[#0f2e59] transition-all focus:outline-none"
          data-index={index}
          aria-label={`${t.goToSlide} ${index + 1}`}
        ></button>
      ))}
    </div>

  </div>
</section>

<script>
  const track = document.getElementById('room-track');
  const cards = document.querySelectorAll('.room-card');
  const prevBtn = document.getElementById('room-prev');
  const nextBtn = document.getElementById('room-next');
  const dots = document.querySelectorAll('.room-dot');
  
  let currentIndex = 0;
  
  function getSlidesCount() {
    // 2 cards per slide on desktop, 1 on mobile
    return window.innerWidth >= 768 ? cards.length - 1 : cards.length;
  }

  function updateSlider() {
    if (!track || cards.length === 0) return;
    
    const maxIndex = getSlidesCount();
    if (currentIndex >= maxIndex) {
      currentIndex = maxIndex - 1;
    }
    if (currentIndex < 0) {
      currentIndex = 0;
    }

    const cardWidth = cards[0].clientWidth;
    // Account for gap (24px)
    const offset = currentIndex * (cardWidth + 24);
    track.style.transform = `translateX(-${offset}px)`;

    // Update dots
    dots.forEach((dot, idx) => {
      if (idx === currentIndex) {
        dot.classList.add('bg-primary');
      } else {
        dot.classList.remove('bg-primary');
      }
    });
  }

  if (prevBtn && nextBtn && track) {
    nextBtn.addEventListener('click', () => {
      const maxIndex = getSlidesCount();
      if (currentIndex < maxIndex - 1) {
        currentIndex++;
      } else {
        currentIndex = 0; // wrap around
      }
      updateSlider();
    });

    prevBtn.addEventListener('click', () => {
      const maxIndex = getSlidesCount();
      if (currentIndex > 0) {
        currentIndex--;
      } else {
        currentIndex = maxIndex - 1; // wrap to end
      }
      updateSlider();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const index = parseInt(target.getAttribute('data-index') || '0');
        const maxIndex = getSlidesCount();
        if (index < maxIndex) {
          currentIndex = index;
          updateSlider();
        }
      });
    });

    // Resize listener to adapt columns
    window.addEventListener('resize', updateSlider);
    
    // Initial call
    updateSlider();
  }
</script>
