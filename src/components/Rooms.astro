---
const rooms = [
  {
    id: 1,
    title: "Junior Suite",
    image: "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80",
    acreage: "80 m²",
    guests: "5",
    beds: "2",
    description: "Ubicada en el sector de la jungla, cerca de la piscina principal, esta habitación especial es - con sus 80 metros cuadrados - la más espaciosa que ofrecemos."
  },
  {
    id: 2,
    title: "Bungalow con 2 camas Queen",
    image: "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=800&q=80",
    acreage: "35 m²",
    guests: "4",
    beds: "2",
    description: "Nuestros bungalow jungle rooms con 2 camas queen se encuentran en el sector selva del resort, son una excelente opción para parejas."
  },
  {
    id: 3,
    title: "Villas Familiares Deluxe",
    image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
    acreage: "110 m²",
    guests: "6",
    beds: "3",
    description: "Amplias villas rodeadas de exuberante selva tropical. Cuentan con balcón privado, hamacas y todas las comodidades modernas para grupos y familias."
  }
];
---

<section id="habitaciones" class="bg-slate-50/65 py-24 px-6 md:px-12 lg:px-24">
  <div class="max-w-7xl mx-auto text-center">
    
    <!-- Section Header -->
    <div class="mb-14">
      <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-3">Habitaciones</h2>
      <p class="text-[10px] md:text-xs font-bold tracking-[0.25em] text-[#e60067] uppercase">
        TENEMOS LAS MEJORES HABITACIONES PARA TI
      </p>
    </div>

    <!-- Carousel Container -->
    <div class="relative max-w-6xl mx-auto overflow-hidden px-4">
      <!-- Track -->
      <div id="room-track" class="flex transition-transform duration-500 ease-out gap-6" style="transform: translateX(0px);">
        {rooms.map((room) => (
          <div class="room-card min-w-full md:min-w-[calc(50%-12px)] bg-white rounded-md overflow-hidden border border-slate-100 shadow-lg flex flex-col hover:shadow-xl transition-all duration-300">
            <!-- Image Frame -->
            <div class="relative h-[250px] overflow-hidden group">
              <img 
                src={room.image} 
                alt={room.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 right-4 bg-[#0f2e59]/90 backdrop-blur-xs text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-xs">
                Reserva Online
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 md:p-8 flex-1 flex flex-col justify-between text-left">
              <div>
                <h3 class="text-xl md:text-2xl font-serif font-bold text-[#0f2e59] mb-4 text-center md:text-left">{room.title}</h3>
                
                <!-- Specs Row -->
                <div class="flex items-center justify-center md:justify-start space-x-6 text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-5 border-y border-slate-100 py-3">
                  <span class="flex items-center space-x-1.5">
                    <!-- Acreage SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-[#e60067]">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v16.5h16.5M12 7.5h7.5m-7.5 3h7.5m-7.5 3h7.5m-7.5 3h7.5" />
                    </svg>
                    <span>{room.acreage}</span>
                  </span>
                  
                  <span class="flex items-center space-x-1.5">
                    <!-- Guests SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-[#e60067]">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.109A11.386 11.386 0 0 1 8.625 18a11.369 11.369 0 0 1-4.654-2.224 4.125 4.125 0 0 1 7.533-2.493m0-4.082A3.5 3.5 0 1 1 8 7a3.5 3.5 0 0 1 3.5 3.5m0 0a3.5 3.5 0 0 1-3.5 3.5" />
                    </svg>
                    <span>{room.guests} huéspedes</span>
                  </span>

                  <span class="flex items-center space-x-1.5">
                    <!-- Bed SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-[#e60067]">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 0v2m0-2h2m-2 0H10m12 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>{room.beds} camas</span>
                  </span>
                </div>

                <p class="text-xs text-slate-500 leading-relaxed text-center md:text-left mb-6 font-normal italic">
                  {room.description}
                </p>
              </div>

              <div class="text-center md:text-left">
                <a href="#booking" class="inline-block text-[#e60067] hover:text-[#c20056] font-bold text-xs tracking-wider uppercase border-b-2 border-[#e60067] pb-1 transition-all">
                  Ver Detalles y Disponibilidad &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      <button 
        id="room-prev" 
        class="absolute left-0 top-[40%] -translate-y-1/2 bg-white/90 hover:bg-white text-[#0f2e59] p-3 rounded-full shadow-md z-20 border border-slate-100 hover:scale-105 transition-all focus:outline-none"
        aria-label="Previous Room"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button 
        id="room-next" 
        class="absolute right-0 top-[40%] -translate-y-1/2 bg-white/90 hover:bg-white text-[#0f2e59] p-3 rounded-full shadow-md z-20 border border-slate-100 hover:scale-105 transition-all focus:outline-none"
        aria-label="Next Room"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>

    <!-- Indicator Dots -->
    <div class="flex justify-center space-x-2.5 mt-10">
      {rooms.map((_, index) => (
        <button 
          class="room-dot w-2.5 h-2.5 rounded-full border border-[#0f2e59] transition-all focus:outline-none"
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>

  </div>
</section>

<script>
  const track = document.getElementById('room-track');
  const cards = document.querySelectorAll('.room-card');
  const prevBtn = document.getElementById('room-prev');
  const nextBtn = document.getElementById('room-next');
  const dots = document.querySelectorAll('.room-dot');
  
  let currentIndex = 0;
  
  function getSlidesCount() {
    // 2 cards per slide on desktop, 1 on mobile
    return window.innerWidth >= 768 ? cards.length - 1 : cards.length;
  }

  function updateSlider() {
    if (!track || cards.length === 0) return;
    
    const maxIndex = getSlidesCount();
    if (currentIndex >= maxIndex) {
      currentIndex = maxIndex - 1;
    }
    if (currentIndex < 0) {
      currentIndex = 0;
    }

    const cardWidth = cards[0].clientWidth;
    // Account for gap (24px)
    const offset = currentIndex * (cardWidth + 24);
    track.style.transform = `translateX(-${offset}px)`;

    // Update dots
    dots.forEach((dot, idx) => {
      if (idx === currentIndex) {
        dot.classList.add('bg-[#0f2e59]');
      } else {
        dot.classList.remove('bg-[#0f2e59]');
      }
    });
  }

  if (prevBtn && nextBtn && track) {
    nextBtn.addEventListener('click', () => {
      const maxIndex = getSlidesCount();
      if (currentIndex < maxIndex - 1) {
        currentIndex++;
      } else {
        currentIndex = 0; // wrap around
      }
      updateSlider();
    });

    prevBtn.addEventListener('click', () => {
      const maxIndex = getSlidesCount();
      if (currentIndex > 0) {
        currentIndex--;
      } else {
        currentIndex = maxIndex - 1; // wrap to end
      }
      updateSlider();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const index = parseInt(target.getAttribute('data-index') || '0');
        const maxIndex = getSlidesCount();
        if (index < maxIndex) {
          currentIndex = index;
          updateSlider();
        }
      });
    });

    // Resize listener to adapt columns
    window.addEventListener('resize', updateSlider);
    
    // Initial call
    updateSlider();
  }
</script>
