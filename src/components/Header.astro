---
---

<header class="w-full z-50 absolute top-0 left-0 bg-transparent text-white font-sans">
  <!-- Top Mini-Bar -->
  <div class="hidden lg:flex w-full bg-[#05152b]/60 border-b border-white/10 py-2 px-6 justify-between items-center text-[11px] font-medium tracking-wider">
    <div class="flex items-center space-x-6">
      <a href="mailto:info@cariblue.com" class="flex items-center space-x-2 hover:text-pink-400 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-[#e60067]">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
        <span>info@cariblue.com</span>
      </a>
      <a href="tel:+50627500035" class="flex items-center space-x-2 hover:text-pink-400 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-[#e60067]">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.035 12.035 0 0 1-7.108-7.108c-.145-.44.02-.927.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
        <span>+506 2750 0035</span>
      </a>
      <span class="flex items-center space-x-2 text-white/80">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-[#e60067]">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        <span>COCLES BEACH, PUERTO VIEJO, LIMÓN</span>
      </span>
    </div>

    <div class="flex items-center space-x-5">
      <!-- Socials -->
      <div class="flex items-center space-x-3 border-r border-white/20 pr-5">
        <a href="#" class="text-white hover:text-pink-400 transition-colors">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
          </svg>
        </a>
        <a href="#" class="text-white hover:text-pink-400 transition-colors">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="#" class="text-white hover:text-pink-400 transition-colors">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.786 1.4 8.168-7.334-3.856-7.334 3.856 1.4-8.168-5.934-5.786 8.2-1.192zm0 5.702l-2.25 4.558-5.03.731 3.64 3.548-.86 5.015 4.5-2.366 4.5 2.366-.86-5.015 3.64-3.548-5.03-.731z"/>
          </svg>
        </a>
      </div>

      <!-- Language Dropdown -->
      <div class="relative group cursor-pointer flex items-center space-x-1 py-1">
        <span class="inline-block w-4 h-3 bg-red-600 border border-yellow-400 relative overflow-hidden mr-1">
          <span class="absolute inset-x-0 top-0 h-1/3 bg-red-600"></span>
          <span class="absolute inset-x-0 top-1/3 h-1/3 bg-yellow-500"></span>
          <span class="absolute inset-x-0 bottom-0 h-1/3 bg-red-600"></span>
        </span>
        <span class="uppercase">ES</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-2.5 h-2.5 transition-transform group-hover:rotate-180">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
        <!-- Dropdown elements -->
        <div class="absolute right-0 top-full mt-1 bg-slate-900 border border-white/10 rounded-sm shadow-xl hidden group-hover:block w-28 text-left overflow-hidden z-50">
          <a href="#" class="block px-3 py-2 hover:bg-slate-800 text-[11px] transition-colors  items-center space-x-2">
            <span class="inline-block w-4 h-3 bg-blue-900 border border-white relative overflow-hidden">
              <span class="absolute inset-0 bg-blue-800"></span>
              <span class="absolute inset-y-0 left-1/3 right-1/3 bg-white"></span>
              <span class="absolute inset-x-0 top-1/3 bottom-1/3 bg-red-600"></span>
            </span>
            <span>EN</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <nav class="w-full bg-[#05152b]/40 backdrop-blur-[2px] border-b border-white/5 py-4 px-6 md:px-12 flex justify-between items-center transition-all duration-300">
    <!-- Logo -->
    <a href="#" class="flex flex-col items-start select-none group">
      <div class="flex items-center space-x-2">
        <!-- Palm leaf design mimicking Cariblue -->
        <img src="/logo.webp" alt="Logo" class="w-48 fill-current text-white/85 group-hover:text-pink-400 transition-colors">
      </div>
      <!-- <span class="text-[8px] md:text-[9px] tracking-[0.25em] font-semibold text-white/85 uppercase pl-1 -mt-1">Beach & Jungle Resort</span> -->
    </a>

    <!-- Nav Links (Desktop) -->
    <div class="hidden lg:flex items-center space-x-7 text-xs font-semibold tracking-widest uppercase">
      <a href="/" class="text-white hover:text-pink-400 transition-all">Inicio</a>
      <div class="relative group cursor-pointer py-2">
        <span class="flex items-center space-x-1 hover:text-pink-400 transition-colors text-white/85">
          <span>Habitaciones</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </span>
        <div class="absolute left-1/2 -translate-x-1/2 top-full bg-transparent pt-2.5 hidden group-hover:block w-48 text-left z-50">
          <div class="bg-[#05152b] border border-white/10 rounded shadow-xl py-2">
            <a href="/room/triple-economica" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Triple Economica</a>
            <a href="/room/superior-king" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Habitación Superior King</a>
            <a href="/room/bungalow-king" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Bungalow King</a>
            <a href="/room/bungalow-queen" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Bungalow con 2 camas Queen</a>
            <a href="/room/junior-suite" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Junior Suite</a>
            <a href="/room/jungle-house" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Jungle House</a>
            <a href="/room/ocean-beach-view-suites" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Ocean Beach View Suites</a>
            <a href="/room/ocean-pool-view-suites" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Ocean Pool View Suites</a>
            <a href="/room/beach-studio" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Beach Studio</a>
            <a href="/room/beach-apartment" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Beach Apartment</a>
            <a href="/room/beach-loft" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Beach Loft</a>
            <a href="/room/estandar-king" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Estándar King</a>
          </div>
        </div>
      </div>
      <a href="/all-inclusive" class="text-white/85 hover:text-pink-400 transition-colors">All Inclusive</a>
      
      <!-- Restaurantes Dropdown -->
      <div class="relative group cursor-pointer py-2">
        <span class="flex items-center space-x-1 hover:text-pink-400 transition-colors text-white/85">
          <span>Restaurantes</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </span>
        <div class="absolute left-1/2 -translate-x-1/2 top-full bg-transparent pt-2.5 hidden group-hover:block w-52 z-50">
          <div class="bg-[#05152b] border border-white/10 rounded shadow-xl py-2 text-left">
            <a href="/restaurante" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Restaurante La Jungla</a>
            <a href="/sushi-wave" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Sushi Wave (Playa)</a>
          </div>
        </div>
      </div>

      <!-- Experiencias Dropdown -->
      <div class="relative group cursor-pointer py-2">
        <span class="flex items-center space-x-1 hover:text-pink-400 transition-colors text-white/85">
          <span>Experiencias</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </span>
        <div class="absolute left-1/2 -translate-x-1/2 top-full bg-transparent pt-2.5 hidden group-hover:block w-48 text-left z-50">
          <div class="bg-[#05152b] border border-white/10 rounded shadow-xl py-2">
            <a href="/surya-spa" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Surya Spa</a>
            <a href="/actividades-caribe" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Actividades Caribe</a>
            <a href="/day-pass" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Day Pass</a>
            <a href="/paquetes" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Paquetes</a>
            <a href="/familias-cariblue" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Familias en Cariblue</a>
          </div>
        </div>
      </div>

      <!-- More dropdown -->
      <div class="relative group cursor-pointer py-2">
        <span class="flex items-center space-x-1 hover:text-pink-400 transition-colors">
          <span>Más</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </span>
        <div class="absolute left-1/2 -translate-x-1/2 top-full bg-transparent pt-2.5 hidden group-hover:block w-48 text-left z-50">
          <div class="bg-[#05152b] border border-white/10 rounded shadow-xl py-2">
            <a href="/eventos" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Eventos</a>
            <a href="/como-llegar" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Cómo Llegar</a>
            <a href="/preguntas-frecuentes" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Preguntas Frecuentes</a>
            <a href="/sustentabilidad" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Sustentabilidad</a>
            <a href="/contacto" class="block px-4 py-2 hover:bg-slate-800 text-[11px] transition-all">Contacto</a>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA & Burger Button -->
    <div class="flex items-center space-x-4">
      <!-- Book Button -->
      <a href="https://book.cariblue.com/" target="_blank" class="bg-[#e60067] hover:bg-[#c20056] text-white font-bold px-5 py-2.5 md:px-7 md:py-3 rounded-sm transition-all duration-300 shadow-lg text-[10px] md:text-xs tracking-[0.15em] uppercase hover:shadow-pink-600/30 animate-pulse-soft">
        Reservar
      </a>

      <!-- Burger Menu (Mobile) -->
      <button id="menu-btn" class="lg:hidden text-white hover:text-pink-400 transition-colors focus:outline-none" aria-label="Toggle Menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#0a1f38] border-b border-white/10 w-full flex flex-col items-center py-6 space-y-4 text-xs font-semibold tracking-wider uppercase shadow-xl transition-all duration-300">
    <a href="/" class="mobile-link text-white hover:text-pink-400">Inicio</a>
    <a href="/#habitaciones" class="mobile-link text-white/85 hover:text-pink-400">Habitaciones</a>
    <a href="/all-inclusive" class="mobile-link text-white/85 hover:text-pink-400">All Inclusive</a>
    <a href="/restaurante" class="mobile-link text-white/85 hover:text-pink-400">La Jungla Restaurant</a>
    <a href="/sushi-wave" class="mobile-link text-white/85 hover:text-pink-400">Sushi Wave (Playa)</a>
    <a href="/surya-spa" class="mobile-link text-white/85 hover:text-pink-400">Surya Spa</a>
    <a href="/actividades-caribe" class="mobile-link text-white/85 hover:text-pink-400">Actividades Caribe</a>
    <a href="/day-pass" class="mobile-link text-white/85 hover:text-pink-400">Day Pass</a>
    <a href="/paquetes" class="mobile-link text-white/85 hover:text-pink-400">Paquetes</a>
    <a href="/familias-cariblue" class="mobile-link text-white/85 hover:text-pink-400">Familias en Cariblue</a>
    <a href="/eventos" class="mobile-link text-white/85 hover:text-pink-400">Eventos</a>
    <a href="/como-llegar" class="mobile-link text-white/85 hover:text-pink-400">Cómo Llegar</a>
    <a href="/preguntas-frecuentes" class="mobile-link text-white/85 hover:text-pink-400">Preguntas Frecuentes</a>
    <a href="/sustentabilidad" class="mobile-link text-white/85 hover:text-pink-400">Sustentabilidad</a>
    <a href="/contacto" class="mobile-link text-white/85 hover:text-pink-400">Contacto</a>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  if (menuBtn && mobileMenu && menuIcon) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      const isHidden = mobileMenu.classList.contains('hidden');
      
      // Toggle burger icon to an 'X'
      if (!isHidden) {
        menuIcon.setAttribute('d', 'M6 18 18 6M6 6l12 12');
      } else {
        menuIcon.setAttribute('d', 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5');
      }
    });

    // Close menu when clicking a link
    const mobileLinks = document.querySelectorAll('.mobile-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuIcon.setAttribute('d', 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5');
      });
    });
  }

  // Navbar background change on scroll
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('nav');
    if (nav) {
      if (window.scrollY > 50) {
        nav.classList.add('bg-[#05152b]/95', 'py-3', 'shadow-xl');
        nav.classList.remove('bg-[#05152b]/40', 'py-4');
      } else {
        nav.classList.add('bg-[#05152b]/40', 'py-4');
        nav.classList.remove('bg-[#05152b]/95', 'py-3', 'shadow-xl');
      }
    }
  });
</script>
