---
const reviews = [
  {
    id: 1,
    source: "Booking.com",
    logoText: "B.",
    logoBg: "bg-[#003580]", // Booking.com brand blue
    author: "Booking / Costa Rica",
    rating: "9.2",
    text: "El hotel tiene una buena ubicación, la piscina es probablemente una de las más bonitas de la zona, las habitaciones son cómodas y tienen refrigerador (sumamente importante). El desayuno es bueno y sus colaboradores muy amables. En general la experiencia es muy buena."
  },
  {
    id: 2,
    source: "TripAdvisor",
    logoText: "O0", // TripAdvisor logo representation or nice SVG
    logoBg: "bg-[#34e0a1]", // TripAdvisor brand green
    author: "TripAdvisor / España",
    rating: "5.0",
    text: "Increíble lugar rodeado de selva pura y playa. Pudimos ver monos y perezosos desde la terraza de nuestro bungalow. El personal es súper atento y las piscinas excelentes. Volveremos sin duda alguna."
  },
  {
    id: 3,
    source: "Google Reviews",
    logoText: "G",
    logoBg: "bg-[#4285F4]", // Google blue
    author: "Google / Argentina",
    rating: "4.8",
    text: "Hermosa experiencia en Cariblue. Muy cuidado el medio ambiente, respetuoso de los animales de la zona. El restaurante de playa Sushi Wave es espectacular y la comida riquísima. Altamente recomendado."
  }
];
---

<section id="experiencias" class="bg-white py-24 px-6 md:px-12 lg:px-24 border-b border-slate-50">
  <div class="max-w-4xl mx-auto text-center">
    
    <!-- Section Title -->
    <div class="mb-10">
      <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59]">Comentarios</h2>
    </div>

    <!-- Review Slider Container -->
    <div class="relative px-8 md:px-16 min-h-[250px] flex items-center justify-center">
      
      <!-- Track/Slide List -->
      <div id="reviews-container" class="w-full relative overflow-hidden">
        {reviews.map((review, index) => (
          <div 
            class={`review-slide w-full transition-all duration-700 ease-in-out flex flex-col items-center justify-center ${index === 0 ? 'opacity-100 scale-100 relative z-10' : 'opacity-0 scale-95 absolute inset-0 z-0 pointer-events-none'}`}
            data-index={index}
          >
            <!-- Brand Badge -->
            <div class={`w-14 h-14 ${review.logoBg} text-white font-black text-3xl flex items-center justify-center rounded-lg shadow-md mb-6 select-none`}>
              {review.logoText}
            </div>

            <!-- Review Text -->
            <blockquote class="text-sm md:text-lg text-slate-600 font-normal leading-relaxed italic max-w-2xl mb-6 relative">
              <span class="absolute -top-6 -left-4 text-slate-100 text-7xl font-serif select-none pointer-events-none">“</span>
              "{review.text}"
              <span class="absolute -bottom-12 -right-4 text-slate-100 text-7xl font-serif select-none pointer-events-none">”</span>
            </blockquote>

            <!-- Rating badge -->
            <div class="flex items-center space-x-1 mb-2 text-[#e60067]">
              {[...Array(5)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                </svg>
              ))}
              <span class="text-xs font-bold text-slate-400 ml-2">({review.rating})</span>
            </div>

            <!-- Author info -->
            <cite class="text-[11px] md:text-xs font-bold tracking-widest text-[#0f2e59] uppercase not-italic block mt-1">
              {review.author}
            </cite>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      <button 
        id="review-prev" 
        class="absolute left-0 bg-white hover:bg-slate-50 text-slate-400 hover:text-[#e60067] w-10 h-10 border border-slate-100 rounded-full flex items-center justify-center shadow-sm hover:shadow transition-all focus:outline-none cursor-pointer"
        aria-label="Previous Review"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button 
        id="review-next" 
        class="absolute right-0 bg-white hover:bg-slate-50 text-slate-400 hover:text-[#e60067] w-10 h-10 border border-slate-100 rounded-full flex items-center justify-center shadow-sm hover:shadow transition-all focus:outline-none cursor-pointer"
        aria-label="Next Review"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </button>

    </div>

    <!-- Dots Indicators -->
    <div class="flex justify-center space-x-2 mt-8">
      {reviews.map((_, index) => (
        <button 
          class={`review-dot w-2 h-2 rounded-full border border-[#0f2e59]/30 transition-all focus:outline-none cursor-pointer ${index === 0 ? 'bg-[#0f2e59] scale-110' : 'bg-transparent'}`}
          data-index={index}
          aria-label={`Go to testimonial ${index + 1}`}
        ></button>
      ))}
    </div>

  </div>
</section>

<script>
  const slides = document.querySelectorAll('.review-slide');
  const dots = document.querySelectorAll('.review-dot');
  const prevBtn = document.getElementById('review-prev');
  const nextBtn = document.getElementById('review-next');

  let activeIndex = 0;

  function showReview(index: number) {
    if (slides.length === 0) return;

    if (index >= slides.length) activeIndex = 0;
    else if (index < 0) activeIndex = slides.length - 1;
    else activeIndex = index;

    slides.forEach((slide, idx) => {
      const el = slide as HTMLElement;
      if (idx === activeIndex) {
        el.classList.remove('opacity-0', 'scale-95', 'absolute', 'pointer-events-none');
        el.classList.add('opacity-100', 'scale-100', 'relative');
      } else {
        el.classList.add('opacity-0', 'scale-95', 'absolute', 'pointer-events-none');
        el.classList.remove('opacity-100', 'scale-100', 'relative');
      }
    });

    dots.forEach((dot, idx) => {
      const el = dot as HTMLElement;
      if (idx === activeIndex) {
        el.classList.add('bg-[#0f2e59]', 'scale-110');
        el.classList.remove('bg-transparent');
      } else {
        el.classList.remove('bg-[#0f2e59]', 'scale-110');
        el.classList.add('bg-transparent');
      }
    });
  }

  if (prevBtn && nextBtn && slides.length > 0) {
    nextBtn.addEventListener('click', () => {
      showReview(activeIndex + 1);
    });

    prevBtn.addEventListener('click', () => {
      showReview(activeIndex - 1);
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const index = parseInt(target.getAttribute('data-index') || '0');
        showReview(index);
      });
    });
  }
</script>
