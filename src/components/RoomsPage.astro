---
import Layout from "../layouts/Layout.astro";
import { getRooms } from "../i18n/rooms";
import { getLocale, localizePath, type Locale } from "../i18n/config";
import { getUi } from "../i18n/ui";

interface Props {
  lang?: Locale;
}

const lang = getLocale(Astro.props.lang);
const rooms = getRooms(lang);
const t = getUi(lang).home.rooms;
const roomPath = (slug: string) => localizePath(`/room/${slug}`, lang);
---

<Layout
  lang={lang}
  title={lang === "es" ? "Nuestras Habitaciones | Cariblue Beach & Jungle Resort" : "Our Rooms | Cariblue Beach & Jungle Resort"}
  description={lang === "es"
    ? "Explora todas las habitaciones de Cariblue Beach & Jungle Resort en Playa Cocles, Puerto Viejo."
    : "Explore all rooms at Cariblue Beach & Jungle Resort in Playa Cocles, Puerto Viejo."}
>
  <main class="bg-white">
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 z-10 bg-slate-950/35"></div>
        <img
          src="https://i.imgur.com/iCGRILP.jpeg"
          alt={lang === "es" ? "Habitaciones Cariblue" : "Cariblue rooms"}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8">
        <h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
          {t.title}
        </h1>
      </div>
    </section>

    <section aria-label={t.title} class="bg-white mt-8 mb-8">
      <div class="mx-auto max-w-360">
        {rooms.map((room, index) => {
          const reverse = index % 2 === 1;
          return (
            <article class="grid min-h-107.5 grid-cols-1 md:grid-cols-2">
              <a
                href={roomPath(room.slug)}
                class:list={[
                  "group block h-72 overflow-hidden md:h-auto",
                  reverse ? "md:order-2" : "md:order-1",
                ]}
                aria-label={`${lang === "es" ? "Ver" : "View"} ${room.title}`}
              >
                <img
                  src={room.image}
                  alt={room.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading={index < 2 ? "eager" : "lazy"}
                />
              </a>

              <div
                class:list={[
                  "flex items-center bg-white px-8 py-12 md:px-12 lg:px-20",
                  reverse ? "md:order-1" : "md:order-2",
                ]}
              >
                <div class="max-w-xl">
                  <h2 class="font-serif text-3xl font-bold leading-tight text-primary md:text-4xl">
                    {room.title}
                  </h2>

                  <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-[11px] font-medium text-slate-500">
                    <span class="inline-flex items-center gap-1.5">
                      {t.beds} {room.beds}
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      {t.acreage} {room.acreage}
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      {t.capacity} {room.guests} {t.people}
                    </span>
                  </div>

                  <p class="mt-6 line-clamp-4 text-sm leading-7 text-slate-600">
                    {room.description}
                  </p>

                  <a
                    href={roomPath(room.slug)}
                    class="mt-8 inline-flex bg-primary px-6 py-3 text-[10px] font-bold uppercase tracking-[0.16em] text-white transition-colors hover:bg-[#315985]"
                  >
                    {t.details}
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</Layout>
