---
---

<section id="inicio" class="relative min-h-[95vh] md:min-h-screen flex flex-col justify-center items-center text-white text-center px-4 pt-24 overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-b from-[#05152b]/60 via-[#05152b]/45 to-[#05152b]/70 z-10"></div>
    <img 
      src="https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=2000&q=80" 
      alt="Cariblue Resort Pool & Jungle" 
      class="w-full h-full object-cover scale-105 animate-[subtle-zoom_20s_infinite_alternate]"
    />
  </div>

  <!-- Hero Content -->
  <div class="relative z-20 max-w-4xl mx-auto flex flex-col items-center justify-center mt-12 md:mt-20">
    <!-- Heart Icon / Decorative symbol -->
    <div class="mb-4 text-white/90">
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-12 h-12 inline-block drop-shadow-lg text-pink-500/80 animate-pulse">
        <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
      </svg>
    </div>

    <h1 class="text-5xl md:text-8xl font-serif font-bold tracking-tight mb-4 drop-shadow-xl text-white select-none leading-none">
      Jungla y Playa
    </h1>
    
    <p class="text-base md:text-2xl font-light tracking-wide max-w-2xl text-slate-100/90 mb-10 drop-shadow-md">
      La mezcla perfecta entre naturaleza y comodidad
    </p>

    <!-- Main Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-4 mb-16 z-20">
      <a 
        href="#habitaciones" 
        class="w-48 sm:w-auto px-8 py-3.5 bg-slate-900/65 backdrop-blur-xs border border-white/20 hover:bg-slate-900/90 hover:border-white/40 text-white text-xs font-bold tracking-[0.2em] uppercase rounded-sm transition-all shadow-lg"
      >
        HABITACIONES
      </a>
      <a 
        href="#booking" 
        class="w-48 sm:w-auto px-10 py-3.5 bg-white text-[#0f2e59] hover:bg-slate-100 text-xs font-extrabold tracking-[0.2em] uppercase rounded-sm transition-all shadow-xl hover:shadow-white/10"
      >
        RESERVA
      </a>
    </div>
  </div>

  <!-- Booking Form Bar -->
  <div class="w-full max-w-5xl mx-auto bg-white text-slate-800 rounded-sm shadow-2xl relative z-30 p-5 md:p-6 mb-12 md:-mb-14">
    <form id="booking-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-center">
      <!-- Check-in -->
      <div class="flex flex-col text-left px-3 border-r border-slate-100 last:border-0">
        <label for="check-in" class="text-[9px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1">LLEGADA</label>
        <input 
          type="date" 
          id="check-in" 
          name="check-in" 
          value="2026-05-27"
          class="text-xs font-semibold text-slate-700 bg-transparent outline-none border-b border-transparent focus:border-[#e60067] pb-1 cursor-pointer w-full"
        />
        <span class="text-[10px] text-slate-400 mt-0.5" id="check-in-day">miércoles</span>
      </div>

      <!-- Check-out -->
      <div class="flex flex-col text-left px-3 border-r border-slate-100 last:border-0">
        <label for="check-out" class="text-[9px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1">SALIDA</label>
        <input 
          type="date" 
          id="check-out" 
          name="check-out" 
          value="2026-05-29"
          class="text-xs font-semibold text-slate-700 bg-transparent outline-none border-b border-transparent focus:border-[#e60067] pb-1 cursor-pointer w-full"
        />
        <span class="text-[10px] text-slate-400 mt-0.5" id="check-out-day">viernes</span>
      </div>

      <!-- Guests -->
      <div class="flex flex-col text-left px-3 border-r border-slate-100 last:border-0">
        <label for="guests" class="text-[9px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1">HUÉSPEDES</label>
        <select 
          id="guests" 
          name="guests" 
          class="text-xs font-bold text-slate-700 bg-transparent outline-none border-b border-transparent focus:border-[#e60067] pb-1 cursor-pointer w-full appearance-none"
        >
          <option value="1">1 Huésped</option>
          <option value="2" selected>2 Huéspedes</option>
          <option value="3">3 Huéspedes</option>
          <option value="4">4 Huéspedes</option>
          <option value="5">5+ Huéspedes</option>
        </select>
        <span class="text-[10px] text-slate-400 mt-0.5">Seleccionar cantidad</span>
      </div>

      <!-- Button -->
      <button 
        type="submit" 
        class="w-full bg-[#e60067] hover:bg-[#c20056] text-white font-bold py-3 px-6 rounded-xs transition-all duration-300 text-xs tracking-wider uppercase shadow-md hover:shadow-pink-600/20"
      >
        Verificar Disponibilidad
      </button>
    </form>
  </div>

  <!-- WhatsApp Widget (Sticky Left) -->
  <a 
    href="https://wa.me/50683141965" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="fixed bottom-6 left-6 z-40 bg-[#25D366] hover:bg-[#20ba5a] text-white p-3.5 rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 group"
    aria-label="Contact us on WhatsApp"
  >
    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.022-.079-.116-.123-.27-.2l-.973-.48c-.154-.078-.266-.012-.353.116l-.427.568c-.085.116-.173.125-.327.047a8.99 8.99 0 01-2.247-1.38 9.355 9.355 0 01-1.556-1.937c-.1-.173-.01-.266.078-.343l.36-.423c.088-.1.116-.174.05-.333l-.48-1.12c-.063-.153-.133-.13-.186-.13-.052-.002-.112-.002-.174-.002a.333.333 0 00-.243.11c-.085.1-3.235 3.167-3.235 7.72s3.32 8.96 3.784 9.587c.463.628 6.53 9.966 15.823 13.976a52.535 52.535 0 005.23 1.936c2.208.682 4.22.585 5.8.35 1.76-.263 5.432-2.222 6.19-4.366.758-2.145.758-3.987.533-4.367-.225-.38-.628-.6-.928-.75z" transform="scale(0.8) translate(3, 3)"/>
    </svg>
    <span class="absolute left-14 bg-slate-900 text-white text-[10px] font-semibold px-2.5 py-1 rounded shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none whitespace-nowrap">
      ¿En qué podemos ayudarte?
    </span>
  </a>

  <!-- Floating Promo Card (Sticky Right) -->
  <div id="promo-card" class="fixed bottom-6 right-6 z-40 max-w-sm bg-[#05152b] text-white border border-white/10 rounded-lg p-4 shadow-2xl transition-all duration-500 transform translate-y-0 scale-100 flex flex-col items-start text-left select-none">
    <!-- Close icon -->
    <button id="close-promo" class="absolute top-2 right-2 text-white/40 hover:text-white transition-colors focus:outline-none">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="flex items-center space-x-2 text-[10px] font-bold tracking-widest text-[#e60067] uppercase mb-1">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#e60067] animate-ping"></span>
      <span>OFERTA IMPERDIBLE</span>
    </div>
    <h4 class="text-sm font-bold text-slate-100">All Inclusive desde ₡71.500</h4>
    <p class="text-[11px] text-slate-300/90 leading-relaxed mt-1 mb-3">
      Disfruta de desayuno, almuerzo, cena, snacks y bar abierto. ¡Todo lo que necesitas para relajarte en el Caribe costarricense!
    </p>
    <a href="#all-inclusive" class="bg-[#e60067] hover:bg-[#c20056] text-white font-extrabold text-[10px] tracking-wider uppercase px-4 py-2 rounded-xs transition-colors shadow-md w-full text-center">
      RESERVAR AHORA
    </a>
  </div>
</section>

<style>
  @keyframes subtle-zoom {
    0% { transform: scale(1.02); }
    100% { transform: scale(1.08); }
  }
</style>

<script>
  // Close promo card
  const closePromo = document.getElementById('close-promo');
  const promoCard = document.getElementById('promo-card');
  if (closePromo && promoCard) {
    closePromo.addEventListener('click', () => {
      promoCard.classList.add('opacity-0', 'translate-y-10', 'scale-95', 'pointer-events-none');
    });
  }

  // Live Check-in / Check-out day formatter helper
  const checkIn = document.getElementById('check-in') as HTMLInputElement;
  const checkOut = document.getElementById('check-out') as HTMLInputElement;
  const checkInDay = document.getElementById('check-in-day');
  const checkOutDay = document.getElementById('check-out-day');

  const daysOfWeek = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

  function updateDays() {
    if (checkIn && checkInDay) {
      const d1 = new Date(checkIn.value);
      if (!isNaN(d1.getTime())) {
        const dayName = daysOfWeek[d1.getUTCDay()];
        checkInDay.textContent = dayName;
      }
    }
    if (checkOut && checkOutDay) {
      const d2 = new Date(checkOut.value);
      if (!isNaN(d2.getTime())) {
        const dayName = daysOfWeek[d2.getUTCDay()];
        checkOutDay.textContent = dayName;
      }
    }
  }

  if (checkIn) checkIn.addEventListener('change', updateDays);
  if (checkOut) checkOut.addEventListener('change', updateDays);
</script>
