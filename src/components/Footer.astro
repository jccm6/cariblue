---

const instagramPics = [
  { id: 1, img: "https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=300&q=80", alt: "Resort pool" },
  { id: 2, img: "https://images.unsplash.com/photo-1584132967334-10e028bd69f7?auto=format&fit=crop&w=300&q=80", alt: "Tropical hammock" },
  { id: 3, img: "https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?auto=format&fit=crop&w=300&q=80", alt: "Fresh cocktail" },
  { id: 4, img: "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=300&q=80", alt: "Resort suite" },
  { id: 5, img: "https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=300&q=80", alt: "Sunset beach" },
  { id: 6, img: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=300&q=80", alt: "Monkeys playing" }
];
---

<footer id="galeria" class="bg-[#111111] text-slate-400 py-16 px-6 md:px-12 lg:px-24 border-t border-white/5 font-sans">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Column 1: Contact Credentials (4 columns) -->
      <div class="col-span-1 lg:col-span-4 text-left">
        <!-- Logo -->
        <a href="#" class="inline-flex flex-col items-start select-none group mb-6">
          <div class="flex items-center space-x-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-[#52b788] group-hover:rotate-12 transition-transform duration-300">
              <path d="M12 .587l.428.855c.358.718.572 1.5.644 2.296.346-.576.786-1.085 1.3-1.5a10.022 10.022 0 014.288-1.782l.852-.142-.142.852c-.147.886-.475 1.73-.96 2.49a5.986 5.986 0 011.666 1.49l.5.666-.666.5a5.979 5.979 0 01-1.49 1.666c.76-.485 1.604-.813 2.49-.96l.852-.142-.142.852a10.022 10.022 0 01-1.782 4.288 12.008 12.008 0 01-1.5 1.3c.796.072 1.578.286 2.296.644l.855.428-.855.428c-.718.358-1.5.572-2.296.644.415.514.924.954 1.5 1.3a10.022 10.022 0 011.782 4.288l.142.852-.852-.142a10.022 10.022 0 01-4.288-1.782c-.514-.415-.954-.924-1.3-1.5-.072.796-.286 1.578-.644 2.296l-.428.855-.428-.855c-.358-.718-.572-1.5-.644-2.296-.346.576-.786 1.085-1.3 1.5a10.022 10.022 0 01-4.288 1.782l-.852.142.142-.852c.147-.886.475-1.73.96-2.49a5.986 5.986 0 01-1.666-1.49l-.5-.666.666-.5a5.979 5.979 0 011.49-1.666c-.76.485-1.604.813-2.49.96l-.852.142.142-.852a10.022 10.022 0 011.782-4.288c.415-.514.924-.954 1.5-1.3-.796-.072-1.578-.286-2.296-.644l-.855-.428.855-.428c.718-.358 1.5-.572 2.296-.644-.415-.514-.924-.954-1.5-1.3a10.022 10.022 0 01-1.782-4.288l-.142-.852.852.142a10.022 10.022 0 014.288 1.782c.514.415.954.924 1.3 1.5.072-.796.286-1.578.644-2.296L12 .587z"/>
            </svg>
            <span class="text-2xl font-serif font-bold tracking-wide italic text-white">Cariblue</span>
          </div>
          <span class="text-[8px] tracking-[0.25em] font-bold text-slate-300 uppercase pl-1 -mt-1">Beach & Jungle Resort</span>
        </a>

        <div class="space-y-3.5 text-xs font-light leading-relaxed mb-6">
          <p>
            <strong class="font-semibold text-white/90">Dirección:</strong> Cocles Beach, Puerto Viejo, Limón, Costa Rica.
          </p>
          <p>
            <strong class="font-semibold text-white/90">Teléfono:</strong> <a href="tel:+50627500035" class="hover:text-white transition-colors">+506 2750 0035</a>
          </p>
          <p>
            <strong class="font-semibold text-white/90">Email:</strong> <a href="mailto:reservations@cariblue.com" class="hover:text-white transition-colors">reservations@cariblue.com</a>
          </p>
        </div>

        <!-- Social Icons -->
        <div class="flex items-center space-x-3.5">
          <a href="#" class="w-8 h-8 rounded-full bg-white/5 hover:bg-[#e60067] text-white flex items-center justify-center transition-all duration-300 shadow-md">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
            </svg>
          </a>
          <a href="#" class="w-8 h-8 rounded-full bg-white/5 hover:bg-[#e60067] text-white flex items-center justify-center transition-all duration-300 shadow-md">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="#" class="w-8 h-8 rounded-full bg-white/5 hover:bg-[#e60067] text-white flex items-center justify-center transition-all duration-300 shadow-md">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
            </svg>
          </a>
          <a href="#" class="w-8 h-8 rounded-full bg-white/5 hover:bg-[#e60067] text-white flex items-center justify-center transition-all duration-300 shadow-md">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.508a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.508 9.388.508 9.388.508s7.518 0 9.388-.508a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Recognitions/Awards (4 columns) -->
      <div class="col-span-1 lg:col-span-4 text-left">
        <h3 class="text-sm font-bold text-white uppercase tracking-widest mb-6 relative">
          Reconocimientos
          <span class="absolute left-0 bottom-[-8px] w-8 h-0.5 bg-[#e60067]"></span>
        </h3>
        
        <div class="flex items-start space-x-6">
          <!-- TripAdvisor GreenLeaders / Travelers Choice badges styled beautifully in CSS -->
          <div class="flex flex-col items-center bg-[#1e2e1e]/20 border border-green-900/40 p-4 rounded text-center w-28 select-none">
            <span class="text-green-500 font-extrabold text-sm tracking-tighter leading-none block mb-1">tripadvisor</span>
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center text-green-500 font-black text-[10px] my-1">
              O0
            </div>
            <span class="text-[8px] font-bold text-slate-300 uppercase tracking-wide leading-tight">Eco Líderes</span>
            <span class="text-[7px] text-green-400 font-medium">Nivel Platino</span>
          </div>

          <div class="flex flex-col items-center bg-[#291e0a]/20 border border-yellow-900/40 p-4 rounded text-center w-28 select-none">
            <span class="text-yellow-500 font-black text-[10px] tracking-wide uppercase block mb-1">TRAVELERS'</span>
            <div class="w-8 h-8 bg-yellow-500/10 text-yellow-500 flex items-center justify-center font-black text-xs rounded-full my-1 border border-yellow-500">
              TY
            </div>
            <span class="text-[8px] font-bold text-slate-300 uppercase tracking-wide leading-tight">CHOICE</span>
            <span class="text-[7px] text-yellow-400 font-medium">Best of the Best</span>
          </div>
        </div>
      </div>

      <!-- Column 3: Instagram Grid (4 columns) -->
      <div class="col-span-1 lg:col-span-4 text-left">
        <h3 class="text-sm font-bold text-white uppercase tracking-widest mb-6 relative">
          Galería en Instagram
          <span class="absolute left-0 bottom-[-8px] w-8 h-0.5 bg-[#e60067]"></span>
        </h3>
        
        <div class="grid grid-cols-3 gap-2">
          {instagramPics.map((pic) => (
            <a href="#" class="relative block aspect-square rounded-xs overflow-hidden group border border-white/5 shadow-md">
              <img 
                src={pic.img} 
                alt={pic.alt} 
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-[#e60067]/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Bottom Credits Bar -->
    <div class="border-t border-white/5 mt-16 pt-8 flex flex-col sm:flex-row justify-between items-center text-[10px] text-slate-500 uppercase tracking-widest font-semibold">
      <small class="mb-4 sm:mb-0">
        &copy; {new Date().getFullYear()} CARIBLUE BEACH & JUNGLE RESORT. TODOS LOS DERECHOS RESERVADOS.
      </small>
      <small class="flex items-center space-x-1.5">
        <span>hotel website by</span>
        <a href="https://hotelcloud.cl" target="_blank" class="text-[#e60067] hover:text-white transition-colors tracking-wide font-black">HOTELCLOUD</a>
      </small>
    </div>
  </div>
</footer>
