---
import "../styles/global.css";
import Header from "../components/Header.astro";

const propertyCode = "Em5T36";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#406ea7" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<title>Reservar | Cariblue Beach & Jungle Resort</title>
		<meta name="description" content="Consulta disponibilidad y reserva tu estadía en Cariblue Beach & Jungle Resort." />
		<script is:inline>
			const requestedLanguage = new URLSearchParams(window.location.search).get("lang");
			if (requestedLanguage === "en") {
				document.documentElement.lang = "en";
			}
		</script>
		<script is:inline type="text/javascript" src="https://static1.cloudbeds.com/booking-engine/latest/static/js/immersive-experience/cb-immersive-experience.js"></script>
	</head>
	<body class="min-h-screen bg-white text-slate-800 antialiased">
		<div class="relative min-h-22 bg-primary lg:min-h-32">
			<Header lang="es" />
		</div>

		<main class="mx-auto min-h-180 max-w-7xl px-3 py-6 sm:px-5 md:px-8 md:py-10">
			<cb-immersive-experience mode="standard" property-code={propertyCode} hide-custom-header="yes" hide-property-info="yes"></cb-immersive-experience>
			<noscript>
				<p class="px-5 py-12 text-center text-sm text-red-700">Para utilizar el motor de reservas debes habilitar JavaScript en tu navegador.</p>
			</noscript>
		</main>
	</body>
</html>

<style is:global data-cb-immersive-experience-root>
	.page-content-wrapper {
		display: none;
	}

	cb-immersive-experience {
		display: block;
		width: 100%;
		min-height: 720px;
	}

	@media (max-width: 640px) {
		cb-immersive-experience {
			min-height: 640px;
		}
	}
</style>
