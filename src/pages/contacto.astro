---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Contacto & Eventos | Cariblue Resort Puerto Viejo Costa Rica"
	description="Ponte en contacto con Cariblue Beach & Jungle Resort. Envíanos un mensaje o planea tu boda, cumpleaños, cena o evento corporativo en la jungla de Puerto Viejo."
>
	<main>
		<!-- Hero Section Banner -->
		<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-[#05152b]/55 z-10"></div>
				<img 
					src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=80" 
					alt="Aerial beach coastal jungle view" 
					class="w-full h-full object-cover"
				/>
			</div>
			<div class="relative z-20 max-w-4xl mx-auto mt-8">
				<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
					Contacto & Eventos
				</h1>
			</div>
		</section>

		<!-- Information Overlapping Dashboard Card -->
		<section class="relative z-30 px-6 max-w-6xl mx-auto -mt-12 md:-mt-16 mb-16">
			<div class="bg-white rounded-lg border border-slate-100 shadow-2xl p-6 md:p-8">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-100 text-center">
					
					<!-- Col 1: Dirección -->
					<div class="flex flex-col items-center justify-center p-3 pt-6 md:pt-3">
						<div class="w-12 h-12 bg-blue-50 text-[#e60067] rounded-full flex items-center justify-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
							</svg>
						</div>
						<h3 class="text-xs font-bold uppercase tracking-wider text-[#0f2e59] mb-2">Dirección</h3>
						<p class="text-xs text-slate-500 leading-relaxed font-normal max-w-xs">
							Cocles Beach, 1.5 Km. South Puerto Viejo,<br />70403 Puerto Viejo, Costa Rica.
						</p>
					</div>

					<!-- Col 2: Teléfono -->
					<div class="flex flex-col items-center justify-center p-3 pt-6 md:pt-3">
						<div class="w-12 h-12 bg-blue-50 text-[#e60067] rounded-full flex items-center justify-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.035 12.035 0 0 1-7.108-7.108c-.145-.44.02-.927.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
							</svg>
						</div>
						<h3 class="text-xs font-bold uppercase tracking-wider text-[#0f2e59] mb-2">Teléfono</h3>
						<ul class="text-xs text-slate-500 space-y-1 font-normal">
							<li>Fijo: <a href="tel:+50627500035" class="hover:text-[#e60067] font-semibold">+506 2750 0035</a></li>
							<li>Whatsapp: <a href="https://wa.me/50683141965" target="_blank" class="hover:text-green-500 font-semibold">+506 8314 1965</a></li>
							<li>TollFree: <a href="tel:18886499773" class="hover:text-[#e60067] font-semibold">1-888-6499-773</a></li>
						</ul>
					</div>

					<!-- Col 3: Email -->
					<div class="flex flex-col items-center justify-center p-3 pt-6 md:pt-3">
						<div class="w-12 h-12 bg-blue-50 text-[#e60067] rounded-full flex items-center justify-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
							</svg>
						</div>
						<h3 class="text-xs font-bold uppercase tracking-wider text-[#0f2e59] mb-2">Email</h3>
						<p class="text-xs text-slate-500 leading-relaxed font-semibold">
							<a href="mailto:reservations@cariblue.com" class="hover:text-[#e60067] transition-colors">reservations@cariblue.com</a>
						</p>
					</div>

				</div>
			</div>
		</section>

		<!-- Envíanos un mensaje Form Section -->
		<section class="bg-slate-50/50 py-16 px-6 md:px-12">
			<div class="max-w-2xl mx-auto bg-white rounded-lg border border-slate-100 shadow-xl p-8 text-left relative">
				<!-- Cursive mini-logo -->
				<div class="flex flex-col items-center mb-6 border-b border-slate-50 pb-5">
					<span class="text-3xl font-serif font-bold italic text-[#0f2e59] drop-shadow select-none">Cariblue</span>
					<span class="text-[8px] tracking-[0.25em] font-semibold text-slate-400 uppercase -mt-1">Beach & Jungle Resort</span>
				</div>

				<h2 class="text-xl md:text-2xl font-serif font-bold text-[#0f2e59] text-center mb-1">
					Envíanos un mensaje
				</h2>
				<p class="text-[10px] md:text-xs font-bold tracking-widest text-[#e60067] uppercase text-center mb-8">
					NUESTRO EQUIPO TE RESPONDERÁ A LA BREVEDAD
				</p>

				<!-- Message Form -->
				<form id="contact-message-form" class="space-y-5">
					<!-- Name -->
					<div class="flex flex-col">
						<label for="msg-name" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Nombre</label>
						<input 
							type="text" 
							id="msg-name" 
							name="name" 
							maxlength="255"
							class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#e60067] focus:ring-1 focus:ring-[#e60067]/20 transition-all font-medium text-slate-700" 
							placeholder="Tu nombre completo"
						/>
						<span class="text-[9px] text-slate-400 text-right mt-1" id="msg-name-counter">0/255</span>
					</div>

					<!-- Email -->
					<div class="flex flex-col">
						<label for="msg-email" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Correo electrónico *</label>
						<input 
							type="email" 
							id="msg-email" 
							name="email" 
							required
							class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#e60067] focus:ring-1 focus:ring-[#e60067]/20 transition-all font-medium text-slate-700" 
							placeholder="tuemail@correo.com"
						/>
					</div>

					<!-- Teléfono (with Country prefix dropdown representation) -->
					<div class="flex flex-col">
						<label for="msg-phone" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Teléfono</label>
						<div class="flex gap-2">
							<select 
								class="border border-slate-200 rounded px-3 py-2.5 text-xs focus:outline-none focus:border-[#e60067] bg-white cursor-pointer font-medium text-slate-600 shrink-0"
								id="msg-country"
							>
								<option value="+506">CR (+506)</option>
								<option value="+34">ES (+34)</option>
								<option value="+1">US (+1)</option>
								<option value="+54">AR (+54)</option>
								<option value="+52">MX (+52)</option>
								<option value="+57">CO (+57)</option>
							</select>
							<input 
								type="tel" 
								id="msg-phone" 
								name="phone" 
								class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#e60067] focus:ring-1 focus:ring-[#e60067]/20 transition-all font-medium text-slate-700 flex-1" 
								placeholder="Número telefónico"
							/>
						</div>
					</div>

					<!-- Message -->
					<div class="flex flex-col">
						<label for="msg-text" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Mensaje</label>
						<textarea 
							id="msg-text" 
							name="message" 
							rows="5"
							maxlength="2000"
							class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#e60067] focus:ring-1 focus:ring-[#e60067]/20 transition-all font-medium text-slate-700 resize-none" 
							placeholder="Escribe tu mensaje aquí..."
						></textarea>
						<span class="text-[9px] text-slate-400 text-right mt-1" id="msg-text-counter">0/2000</span>
					</div>

					<!-- Custom Mock Google reCAPTCHA widget -->
					<div class="bg-[#f9f9f9] border border-slate-200 rounded p-4.5 flex items-center justify-between max-w-sm select-none">
						<div class="flex items-center space-x-3.5">
							<input 
								type="checkbox" 
								id="captcha-check" 
								required
								class="w-6 h-6 border-2 border-slate-300 text-blue-600 rounded focus:ring-blue-500 cursor-pointer"
							/>
							<label for="captcha-check" class="text-xs font-semibold text-slate-600 cursor-pointer">No soy un robot</label>
						</div>
						<div class="flex flex-col items-center justify-center">
							<!-- reCAPTCHA logo representation in SVG -->
							<svg class="w-8 h-8 text-blue-500 fill-current" viewBox="0 0 24 24">
								<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"/>
							</svg>
							<span class="text-[7px] text-slate-400 font-bold mt-0.5">reCAPTCHA</span>
						</div>
					</div>

					<!-- Submit Button (Aligned Right) -->
					<div class="flex justify-end pt-3">
						<button 
							type="submit" 
							class="bg-[#3b82f6] hover:bg-blue-600 text-white font-bold text-xs tracking-wider uppercase px-8 py-3 rounded-xs shadow-md transition-colors"
						>
							Enviar
						</button>
					</div>
				</form>
			</div>
		</section>

		<!-- Eventos en la Jungla Form Section -->
		<section class="bg-white py-20 px-6 md:px-12">
			<div class="max-w-4xl mx-auto text-left">
				<div class="text-center mb-10">
					<h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-3">
						Eventos en la Jungla
					</h2>
					<p class="text-xs md:text-[13px] text-slate-500 font-light max-w-2xl mx-auto leading-relaxed">
						Organiza tu evento en La Jungla, boda, cumpleaños, aniversarios, eventos corporativos. Nuestro equipo especializado se pondrá en contacto contigo de inmediato.
					</p>
				</div>

				<!-- Event Form -->
				<form id="event-booking-form" class="space-y-6 max-w-3xl mx-auto bg-slate-50/50 p-6 md:p-8 rounded-lg border border-slate-100">
					<!-- Row 1: Name, Email, Phone -->
					<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
						<div class="flex flex-col">
							<label for="evt-name" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Nombre *</label>
							<input 
								type="text" 
								id="evt-name" 
								name="name" 
								required
								class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#0f2e59] bg-white font-medium text-slate-700"
								placeholder="Nombre *"
							/>
						</div>
						<div class="flex flex-col">
							<label for="evt-email" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Email *</label>
							<input 
								type="email" 
								id="evt-email" 
								name="email" 
								required
								class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#0f2e59] bg-white font-medium text-slate-700"
								placeholder="Email *"
							/>
						</div>
						<div class="flex flex-col">
							<label for="evt-phone" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Teléfono *</label>
							<input 
								type="tel" 
								id="evt-phone" 
								name="phone" 
								required
								class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#0f2e59] bg-white font-medium text-slate-700"
								placeholder="Teléfono *"
							/>
						</div>
					</div>

					<!-- Row 2: Date, People count -->
					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						<div class="flex flex-col">
							<label for="evt-date" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Fecha del evento</label>
							<input 
								type="date" 
								id="evt-date" 
								name="date" 
								class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#0f2e59] bg-white font-semibold text-slate-600"
							/>
						</div>
						<div class="flex flex-col">
							<label for="evt-count" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Cantidad de personas aproximado *</label>
							<input 
								type="number" 
								id="evt-count" 
								name="people_count" 
								required
								min="1"
								class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#0f2e59] bg-white font-semibold text-slate-700"
								placeholder="Cantidad de personas aproximado *"
							/>
						</div>
					</div>

					<!-- Row 3: Message -->
					<div class="flex flex-col">
						<label for="evt-msg" class="text-[10px] font-bold tracking-widest text-[#0f2e59] uppercase mb-1.5">Mensaje</label>
						<textarea 
							id="evt-msg" 
							name="message" 
							rows="5"
							class="border border-slate-200 rounded px-4 py-2.5 text-xs focus:outline-none focus:border-[#0f2e59] bg-white font-medium text-slate-700 resize-none"
							placeholder="Mensaje"
						></textarea>
					</div>

					<!-- Submit Button -->
					<div class="flex justify-center pt-3">
						<button 
							type="submit" 
							class="bg-[#222222] hover:bg-[#111111] text-white font-bold text-xs tracking-wider uppercase px-12 py-3.5 rounded shadow-lg transition-colors"
						>
							ENVIAR MENSAJE
						</button>
					</div>
				</form>
			</div>
		</section>

		<!-- Map Section -->
		<section class="w-full h-[400px] border-t border-slate-100 relative">
			<iframe 
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3933.360680052805!2d-82.74184302332371!3d9.650190490438069!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa650013b7fc357%3A0xcb6e0cea110c81dc!2sCariblue%20Beach%20and%20Jungle%20Resort!5e0!3m2!1ses-419!2scl!4v1780005084967!5m2!1ses-419!2scl" 
				class="w-full h-full border-0" 
				allowfullscreen="" 
				loading="lazy" 
				referrerpolicy="no-referrer-when-downgrade"
				title="Resort Location Google Map"
			></iframe>
		</section>
	</main>
</Layout>

<script>
	// Live Character Counter Scripts
	const msgName = document.getElementById('msg-name') as HTMLInputElement;
	const msgNameCounter = document.getElementById('msg-name-counter');
	const msgText = document.getElementById('msg-text') as HTMLTextAreaElement;
	const msgTextCounter = document.getElementById('msg-text-counter');

	if (msgName && msgNameCounter) {
		msgName.addEventListener('input', () => {
			msgNameCounter.textContent = `${msgName.value.length}/255`;
		});
	}

	if (msgText && msgTextCounter) {
		msgText.addEventListener('input', () => {
			msgTextCounter.textContent = `${msgText.value.length}/2000`;
		});
	}
</script>
