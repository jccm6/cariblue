---
import "../styles/global.css";

const propertyCode = "Em5T36";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#406ea7" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<title>Prueba del motor de reservas | Cariblue</title>
		<meta
			name="description"
			content="Página interna para comparar las opciones emergente y de página completa del motor de reservas de Cloudbeds."
		/>
		<script
			is:inline
			type="text/javascript"
			src="https://static1.cloudbeds.com/booking-engine/latest/static/js/immersive-experience/cb-immersive-experience.js"
		></script>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
		<header class="bg-primary text-white shadow-lg">
			<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-5 md:px-8">
				<a href="/" aria-label="Volver al inicio de Cariblue" class="inline-flex items-center">
					<img src="/logo.webp" alt="Cariblue Beach & Jungle Resort" class="h-14 w-auto md:h-16" />
				</a>
				<span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em]">
					Página de prueba
				</span>
			</div>
		</header>

		<main>
			<section class="border-b border-slate-200 bg-white">
				<div class="mx-auto max-w-4xl px-5 py-12 text-center md:px-8 md:py-16">
					<p class="mb-3 text-xs font-extrabold uppercase tracking-[0.25em] text-accent">Cloudbeds Immersive Experience 2.0</p>
					<h1 class="text-3xl font-bold text-primary md:text-5xl">Comparación del motor de reservas</h1>
					<p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-slate-600 md:text-base">
						Prueba las dos experiencias disponibles. Ambas consultan la misma disponibilidad y tarifas de Cariblue.
					</p>
				</div>
			</section>

			<section class="mx-auto max-w-5xl px-5 py-10 md:px-8 md:py-14" aria-labelledby="popup-title">
				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-9">
					<div class="grid items-center gap-7 md:grid-cols-[1fr_auto]">
						<div>
							<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.2em] text-accent">Opción 1</p>
							<h2 id="popup-title" class="text-2xl font-bold text-primary md:text-3xl">Panel emergente</h2>
							<p class="mt-3 max-w-2xl leading-7 text-slate-600">
								El proceso de reserva se abre sobre esta página en un panel de gran tamaño. Es ideal para botones de “Reservar ahora”.
							</p>
						</div>

						<div class="flex justify-center md:justify-end">
							<cb-book-now-button
								property-code={propertyCode}
								lang="es"
								label="Probar panel emergente"
								close-label="Cerrar"
								height="90vh"
								width="90vw"
								class-name="cloudbeds-popup-button"
							></cb-book-now-button>
						</div>
					</div>
				</div>
			</section>

			<section class="border-t border-slate-200 bg-white py-10 md:py-14" aria-labelledby="standard-title">
				<div class="mx-auto max-w-7xl px-5 md:px-8">
					<div class="mb-8 max-w-3xl">
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.2em] text-accent">Opción 2</p>
						<h2 id="standard-title" class="text-2xl font-bold text-primary md:text-3xl">Motor integrado en página completa</h2>
						<p class="mt-3 leading-7 text-slate-600">
							La experiencia completa aparece directamente dentro de la página y el huésped permanece en el sitio durante el flujo de reserva.
						</p>
					</div>

					<div class="cloudbeds-standard-container rounded-2xl border border-slate-200 bg-white shadow-sm">
						<cb-immersive-experience
							mode="standard"
							property-code={propertyCode}
							lang="es"
						></cb-immersive-experience>
					</div>
				</div>
			</section>

			<noscript>
				<div class="mx-auto max-w-3xl px-5 py-8 text-center text-sm text-red-700">
					Para utilizar el motor de reservas debes habilitar JavaScript en tu navegador.
				</div>
			</noscript>
		</main>

		<footer class="bg-slate-900 px-5 py-6 text-center text-xs text-slate-300">
			Cariblue Beach & Jungle Resort · Página interna de comparación
		</footer>
	</body>
</html>

<style is:global data-cb-immersive-experience-root>
	.cloudbeds-popup-button {
		min-width: 230px;
		border: 0;
		border-radius: 0.375rem;
		background: #e60067;
		padding: 0.9rem 1.5rem;
		color: #fff;
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		cursor: pointer;
		box-shadow: 0 10px 25px rgb(230 0 103 / 20%);
		transition:
			transform 180ms ease,
			background-color 180ms ease,
			box-shadow 180ms ease;
	}

	.cloudbeds-popup-button:hover {
		background: #c9005a;
		transform: translateY(-1px);
		box-shadow: 0 14px 30px rgb(230 0 103 / 28%);
	}

	.cloudbeds-popup-button:focus-visible {
		outline: 3px solid rgb(64 110 167 / 45%);
		outline-offset: 3px;
	}

	.cloudbeds-standard-container {
		min-height: 720px;
		overflow: visible;
	}

	cb-immersive-experience {
		display: block;
		width: 100%;
		min-height: 720px;
	}

	@media (max-width: 640px) {
		.cloudbeds-popup-button {
			width: 100%;
			min-width: 0;
		}

		.cloudbeds-standard-container,
		cb-immersive-experience {
			min-height: 640px;
		}
	}
</style>
