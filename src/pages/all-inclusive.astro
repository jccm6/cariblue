---
import Layout from "../layouts/Layout.astro";

const whatsappUrl = "https://wa.me/message/GMSVUP75UWUHC1";
const bookingUrl = "https://book.cariblue.com/";
const menuUrl = "https://cariblue.kivly.store/menu/6a049a97b7a1a2ae0d2fa360?tab=carta";

const inclusions = [
	{
		title: "Hospedaje",
		text: "Elige la habitación que más se acomode a tus necesidades de los diferentes tipos de habitación que tenemos.",
		image: "https://i.imgur.com/LQxmZeL.jpeg",
		alt: "Habitación de Cariblue Resort",
		details: [],
		link: false,
		note: null,
	},
	{
		title: "Gastronomía completa",
		text: "Disfruta de una experiencia culinaria completa durante toda tu estadía:",
		image: "https://i.imgur.com/uooYTQT.jpeg",
		alt: "Experiencia gastronómica en Restaurante La Jungla",
		details: [
			{ title: "Día de llegada", items: ["Cena incluida"] },
			{ title: "Durante tu estadía", items: ["Desayuno buffet", "Almuerzo a la carta", "Cena a la carta"] },
			{ title: "Día de salida", items: ["Desayuno + almuerzo"] },
			{ title: "Cada comida incluye", items: ["Entrada del día", "Plato fuerte a elección", "Postre del día"] },
		],
		link: "https://cariblue.kivly.store/menu/6a049a97b7a1a2ae0d2fa360?tab=carta",
		linkDescription: "Ver el menu completo",
		note: null,
	},
	{
		title: "Snacks durante el día",
		text: "Disfruta de un momento para recargar energías durante tu estadía.",
		image: "https://i.imgur.com/E6y9aVT.jpeg",
		alt: "Snacks y bebidas en el Wetbar de Cariblue",
		details: [
			{ title: "Incluye", items: ["1 snack diario por persona"] },
			{ title: "Disponible en", items: ["Nuestro Wetbar"] },
		],
		link: false,
		note: null,
	},
	{
		title: "Barra libre diaria",
		text: "Disfruta bebidas seleccionadas todos los días durante tu estadía.",
		image: "https://i.imgur.com/LkVXgYv.jpeg",
		alt: "Cócteles tropicales de la barra de Cariblue",
		details: [
			{ title: "Horario", items: ["Disponible de 11:00 a.m. a 9:00 p.m. en La Jungla y Wetbar."] },
			{
				title: "Incluye",
				items: [
					"Cervezas nacionales y Harbour",
					"Cócteles seleccionados (Piña Colada, Margarita, Daiquiri, etc.)",
					"Vino de la casa (tinto, blanco o rosé)",
					"Gaseosas",
					"Jugos naturales del día",
					"Café e infusiones",
				],
			},
		],
		note: "Importante: licores premium y cócteles no incluidos se cobran adicionalmente.",
		link: false,
	},
	{
		title: "Late Check-Out",
		text: "Disfruta de Cariblue hasta el último momento de tu estadía.",
		image: "https://i.imgur.com/HqLrfpM.jpeg",
		alt: "Huéspedes disfrutando su estadía en Cariblue",
		details: [{ title: "Disponibilidad", items: ["Late check-out hasta las 4:00 p.m. (según disponibilidad)"] }],
		link: false,
		note: null,
	},
] as const;
---

<Layout
	title="All Inclusive | Cariblue Beach & Jungle Resort Costa Rica"
	description="Convierte tu estadía en una experiencia completa frente al mar y la selva en Cariblue, con hospedaje, gastronomía, snacks, barra libre y late check-out."
>
	<main>
		<section class="relative min-h-[42vh] md:min-h-[52vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 z-10 bg-linear-to-b from-black/20 via-black/30 to-black/55"></div>
				<img src="https://i.imgur.com/bkq1aqP.png" alt="Experiencia All Inclusive frente al mar y la selva en Cariblue" class="h-full w-full object-cover" />
			</div>
			<div class="relative z-20 max-w-5xl mx-auto mt-8">
				<p class="text-[11px] md:text-xs font-black tracking-[0.35em] uppercase text-white/80">Cariblue Resort</p>
				<h1 class="mt-4 text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">All Inclusive</h1>
				<p class="mt-5 text-sm md:text-lg font-medium tracking-[0.18em] uppercase text-white/90">En el Caribe Sur de Costa Rica</p>
			</div>
		</section>

		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-7">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">All Inclusive Cariblue</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight">Convierte tu estadía en una experiencia completa</h2>
					<p class="mt-6 text-base md:text-lg text-slate-700 leading-relaxed">
						Convierte tu estadía en una experiencia completa frente al mar y la selva, con comidas, bebidas y actividades diseñadas para que vivas Cariblue al máximo.
					</p>
					<p class="mt-4 text-sm md:text-[15px] text-slate-600 leading-relaxed">Recomendado para parejas, familias y grupos que quieren vivir la experiencia completa.</p>
					<p class="mt-6 text-sm font-bold text-[#0f2e59] tracking-[0.18em] uppercase">
						Te estamos esperando, ven a vivir la experiencia <span class="text-accent italic font-semibold">p u r a&nbsp;&nbsp;v i d a</span>
					</p>
					<div class="mt-8 flex flex-col sm:flex-row gap-4">
						<a
							href={whatsappUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
							>WhatsApp</a
						>
						<a
							href={bookingUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center bg-[#0f2e59] text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
							>Reserva Directo</a
						>
					</div>
				</div>
				<div class="lg:col-span-5">
					<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-5/4 relative group">
						<img
							src="/bienvenido.webp"
							alt="Piscina rodeada de naturaleza en Cariblue Resort"
							class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
						/>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-slate-50/50 py-10 border-y border-slate-100 text-center">
			<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59]">¿Qué incluye?</h2>
		</section>

		<section class="bg-[#f6efe4] py-16 px-6 md:px-12 lg:px-24 border-b border-[#eadbc7]">
			<div class="max-w-7xl mx-auto space-y-16 lg:space-y-20">
				{
					inclusions.map((item, index) => (
						<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-[#eadbc7] pb-16 last:border-0 last:pb-0">
							<div class={`col-span-1 md:col-span-7 ${index % 2 === 1 ? "md:order-2" : "md:order-1"}`}>
								<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-3">Incluye {String(index + 1).padStart(2, "0")}</p>
								<h3 class="text-3xl md:text-4xl font-serif font-bold text-[#0f2e59] leading-tight">{item.title}</h3>
								<p class="mt-5 text-sm md:text-[15px] text-slate-700 leading-relaxed">{item.text}</p>

								{item.details.length > 0 && (
									<div class="mt-7 rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
											{item.details.map((detail) => (
												<div>
													<h4 class="text-base font-serif font-bold text-[#0f2e59] mb-2">{detail.title}</h4>
													<ul class="space-y-1.5 text-sm text-slate-600 leading-relaxed list-disc list-inside">
														{detail.items.map((detailItem) => (
															<li>{detailItem}</li>
														))}
													</ul>
												</div>
											))}
										</div>
									</div>
								)}

								{item.link && (
									<p class="mt-5 text-sm font-semibold text-[#0f2e59]">
										{/* {item.linkDescription} */}
										<a href={item.link} target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4 hover:text-[#0f2e59] transition-colors">
											{/* Menú */}
											{item.linkDescription}
										</a>
									</p>
								)}

								{item.note && <p class="mt-5 text-xs text-slate-500 leading-relaxed">{item.note}</p>}
							</div>
							<div class={`col-span-1 md:col-span-5 ${index % 2 === 1 ? "md:order-1" : "md:order-2"}`}>
								<div class="overflow-hidden rounded shadow-2xl border border-white/60 aspect-4/5 relative group">
									<img src={item.image} alt={item.alt} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
								</div>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="bg-white py-16 px-6 md:px-12 lg:px-24 border-b border-slate-100">
			<div class="max-w-7xl mx-auto">
				<div class="flex items-center gap-4 mb-8">
					<div class="h-px flex-1 bg-slate-200"></div>
					<h2 class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-[#0f2e59]">Políticas para niños</h2>
					<div class="h-px flex-1 bg-slate-200"></div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					<div class="rounded bg-[#0f2e59] px-6 py-7 text-white shadow-lg">
						<p class="text-[11px] font-black tracking-[0.2em] uppercase text-white/70">De 0 a 2 años</p>
						<h3 class="mt-3 text-2xl font-serif font-bold">Sin costo</h3>
						<p class="mt-3 text-sm text-white/80 leading-relaxed">No incluye plan de comidas.</p>
					</div>
					<div class="rounded border border-[#eadbc7] bg-[#f6efe4] px-6 py-7 shadow-sm">
						<p class="text-[11px] font-black tracking-[0.2em] uppercase text-accent">De 3 a 12 años</p>
						<h3 class="mt-3 text-2xl font-serif font-bold text-[#0f2e59]">50% de la tarifa</h3>
						<p class="mt-3 text-sm text-slate-600 leading-relaxed">Incluye menú infantil.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-[#0f2e59] py-20 px-6 text-center">
			<div class="max-w-3xl mx-auto">
				<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-white/60 mb-4">Vive Cariblue al máximo</p>
				<h2 class="text-3xl md:text-5xl font-serif font-bold text-white leading-tight">No es solo un plan, es una experiencia</h2>
				<p class="mt-6 text-base md:text-lg text-white/80 leading-relaxed">
					Desde desayunar rodeado de naturaleza hasta cerrar el día con un cóctel frente al mar, el All Inclusive te permite disfrutar cada momento sin interrupciones.
				</p>
				<p class="mt-4 text-sm md:text-base font-semibold tracking-[0.08em] text-white/90">Explora, relájate, come, brinda y repite.</p>
				<div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
					<a
						href={whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
						>WhatsApp</a
					>
					<a
						href={bookingUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center border border-white/30 bg-white text-[#0f2e59] font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
						>Reserva Directo</a
					>
				</div>
			</div>
		</section>
	</main>
</Layout>
