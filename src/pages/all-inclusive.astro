---
import Layout from '../layouts/Layout.astro';

const inclusions = [
  {
    title: "Habitaciones",
    text: "Elige la habitación que más se acomode a tus necesidades de los diferentes tipos de habitación que tenemos.",
    image: "/habitaciones.webp",
    alt: "Habitación lujosa con cama king"
  },
  {
    title: "Desayuno Buffet",
    text: "Servido todos los días de 7:00 am a 10:00 am en nuestro restaurante La Jungla.",
    image: "/desayuno_buffet.webp",
    alt: "Delicioso desayuno buffet tropical"
  },
  {
    title: "Almuerzo y Cena a la Carta",
    text: "Almuerzo y cena a la carta en nuestro restaurante \"La Jungla\". Se incluye entrada, plato fuerte a elección y postre del día.",
    image: "/almuerzo_cena.webp",
    alt: "Almuerzo y cena gourmet a la carta"
  },
  {
    title: "Bar abierto",
    text: "Se incluyen gaseosas, frescos del día, cerveza y cócteles seleccionados (no se incluyen licores premium). Horario del bar de 11:00 am a 9:00 pm.",
    image: "https://i.imgur.com/EWwKuvg.png",
    alt: "Cócteles tropicales frente a la piscina"
  },
  {
    title: "Late Checkout",
    text: "Quédate hasta la 4 pm y disfruta el día de salida (según disponibilidad).",
    image: "https://i.imgur.com/COZoXoz.png",
    alt: "Pareja relajándose en la habitación"
  },
  {
    title: "Política de Niños",
    text: "Niños de 0 a 2 años: Gratis, compartiendo cama con sus padres (sin pensión de comida).\nNiños de 3 a 12 años: Pagan el 50%, con menú de niños incluido y cama supletoria disponible. Precio: 39.500 colones.",
    image: "/politica_ninos.webp",
    alt: "Familia disfrutando junto a la piscina"
  }
];
---

<Layout 
	title="All Inclusive | Cariblue Beach & Jungle Resort Costa Rica"
	description="Descubre el plan All Inclusive en Cariblue Resort. Todo lo que necesitas para tu viaje familiar, en pareja o con amigos en Playa Cocles, Costa Rica."
>
	<main>
		<!-- Page Hero Banner -->
		<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-primary/55 z-10"></div>
				<img 
					src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=80" 
					alt="Cariblue All Inclusive Coastline" 
					class="w-full h-full object-cover"
				/>
			</div>
			<div class="relative z-20 max-w-4xl mx-auto mt-8">
				<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
					All Inclusive
				</h1>
			</div>
		</section>

		<!-- Introduction Section -->
		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
					
					<!-- Left side: Description -->
					<div class="col-span-1 lg:col-span-7 text-left">
						<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6">
							Cariblue
						</h2>
						<div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal">
							<p>
								Hotel Cariblue te invita a vivir una experiencia única de playa y selva en el Caribe Sur de Costa Rica <span class="font-semibold text-[#e60067]">• ALL INCLUSIVE •</span> para que no te preocupes de nada.
							</p>
							<p>
								Es el plan ideal para familias, parejas y grupos de amigos. En Cariblue encontrarás todo: las mejores habitaciones, restaurantes, conciertos de música en vivo, spa & wellness, comidas gourmet para llevar a la playa, clases de yoga, avistamiento de animales de la jungla, tours por la zona, actividades deportivas... ¡y más!
							</p>
							<p>
								Estamos ubicados a menos de 3 kilómetros de Puerto Viejo, sobre la playa Cocles, una de las más hermosas del Caribe Sur. Y a minutos caminando de las demás: Playa Chiquita, Pocitas, Punta Uva, Arrecife y Playa Grande.
							</p>
							<p class="font-bold text-[#0f2e59] tracking-wider uppercase mt-6 text-[11px]">
								Te estamos esperando, ven a vivir la experiencia <span class="text-[#e60067] italic font-semibold border-b border-[#e60067] pb-0.5">• p u r a  v i d a •</span>
							</p>
						</div>
					</div>

					<!-- Right side: Resort Image -->
					<div class="col-span-1 lg:col-span-5">
						<div class="overflow-hidden rounded-lg shadow-2xl border border-slate-100 relative group h-75">
							<img 
								src="/bienvenido.webp" 
								alt="Jungle pool at Cariblue Resort" 
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
							/>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- "¿Qué incluye?" Title Section -->
		<section class="bg-slate-50/50 py-10 border-y border-slate-100 text-center">
			<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59]">
				¿Qué incluye?
			</h2>
		</section>

		<!-- Inclusions List (Aesthetically Stacked Rows) -->
		<section class="bg-white py-16 px-6 md:px-12 lg:px-24">
			<div class="max-w-5xl mx-auto space-y-16 lg:space-y-24">
				{inclusions.map((inc) => (
					<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16 last:border-0 last:pb-0">
						
						<!-- Text details (7 columns on desktop) -->
						<div class="col-span-1 md:col-span-6 text-left">
							<h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">
								{inc.title}
							</h3>
							<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal whitespace-pre-line">
								{inc.text}
							</p>
						</div>

						<!-- Image (5 columns on desktop) -->
						<div class="col-span-1 md:col-span-6">
							<div class="overflow-hidden rounded shadow-xl border border-slate-100 relative group aspect-video">
								<img 
									src={inc.image} 
									alt={inc.alt} 
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								/>
							</div>
						</div>

					</div>
				))}
			</div>
		</section>

		<!-- Call To Action Section -->
		<section class="bg-slate-50/50 py-20 px-6 text-center border-t border-slate-100">
			<div class="max-w-3xl mx-auto">
				<h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-8 leading-tight">
					No esperes más para organizar tu viaje
				</h2>
				<a 
					href="https://wa.me/50683141965" 
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block bg-accent hover:bg-accent text-white font-bold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg hover:shadow-pink-600/30 transition-all duration-300"
				>
					Contáctanos
				</a>
			</div>
		</section>
	</main>
</Layout>
