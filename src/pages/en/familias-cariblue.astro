---
import Layout from "../../layouts/Layout.astro";

const familyGallery = [
  { id: 1, img: "https://images.unsplash.com/photo-1542037104857-ffbb0b9155fb?auto=format&fit=crop&w=400&q=80", title: "Pool fun" },
  { id: 2, img: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=400&q=80", title: "Native sloth" },
  { id: 3, img: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=400&q=80", title: "Pool table at Rancho" },
  { id: 4, img: "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=400&q=80", title: "Pizza to share" },
];
---

<Layout
  lang="en"
  title="Families at Cariblue | Family Beach Resort Costa Rica"
  description="The best family vacations at Cariblue Beach & Jungle Resort. Kids' pool, play area, foosball, wildlife and fun in Puerto Viejo."
>
  <main>
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 z-10"></div>
        <img src="/portada_laJungla.webp" alt="Cariblue resort open air dining hall" class="w-full h-full object-cover" />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8">
        <h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Families at Cariblue</h1>
      </div>
    </section>

    <section class="bg-white py-20 px-6 md:px-12 lg:px-24">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="col-span-1 lg:col-span-5">
            <div class="overflow-hidden rounded-lg shadow-2xl relative border border-slate-100 group aspect-video">
              <img src="/restaurante_la_jungla.webp" alt="Parents relaxing with drinks by the pool" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
          </div>
          <div class="col-span-1 lg:col-span-7 text-left">
            <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6 leading-tight">When the kids have fun, the whole family smiles</h2>
            <div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal">
              <p>At Cariblue, every detail is designed to make your family vacation unforgettable.</p>
              <p>While the little ones discover games and adventures, the grown-ups enjoy the balance of rest, nature and great food.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white pb-20 px-6 md:px-12 lg:px-24">
      <div class="max-w-5xl mx-auto space-y-16 lg:space-y-24">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16">
          <div class="col-span-1 md:col-span-6 text-left">
            <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Pools for everyone</h3>
            <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal">Enjoy our pools designed for the whole family. With shallow areas for children and a wet bar for adults, every corner is pure fun.</p>
          </div>
          <div class="col-span-1 md:col-span-6">
            <div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
              <img src="https://i.imgur.com/PmKhQOm.jpeg" alt="Family swimming in Cariblue pool" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16">
          <div class="col-span-1 md:col-span-6 order-2 md:order-1">
            <div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
              <img src="https://i.imgur.com/fW89xa5.jpeg" alt="Children playing games at the resort" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
          <div class="col-span-1 md:col-span-6 text-left order-1 md:order-2">
            <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Play area</h3>
            <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal mb-4">A safe and fun space where kids can keep playing while adults relax.</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-slate-500 font-medium mb-4">
              <li>Giant Jenga</li>
              <li>Foosball</li>
              <li>Pool table</li>
              <li>XL Connect 4</li>
              <li>Board games and family chill-out areas</li>
            </ul>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16">
          <div class="col-span-1 md:col-span-6 text-left">
            <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Discover the local wildlife</h3>
            <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal">Monkeys, toucans and sloths appear among the gardens and jungle that surround the resort, creating a unique experience for all ages.</p>
          </div>
          <div class="col-span-1 md:col-span-6">
            <div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
              <img src="https://i.imgur.com/S9lmr4G.png" alt="Toucans native tropical wildlife" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16">
          <div class="col-span-1 md:col-span-6 order-2 md:order-1">
            <div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
              <img src="https://i.imgur.com/85WZlWg.png" alt="Kid eating delicious pizza slice" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
          <div class="col-span-1 md:col-span-6 text-left order-1 md:order-2">
            <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Flavors that bring us together</h3>
            <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal mb-5">Two restaurants with options for everyone, from tropical flavors to kid-friendly dishes.</p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs text-slate-500 font-medium mb-6">
              <li>Main hotel restaurant (La Jungla)</li>
              <li>Sushi Wave, in front of Playa Cocles</li>
            </ul>
            <a href="/en/all-inclusive" class="inline-block bg-accent hover:bg-accent text-white font-extrabold text-[10px] tracking-widest uppercase px-6 py-3 rounded shadow-md transition-colors">See our all inclusive rate</a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16">
          <div class="col-span-1 md:col-span-6 text-left">
            <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Activities and fun</h3>
            <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal">Live music, tropical nights, magic shows and more moments to share with the family in Puerto Viejo.</p>
          </div>
          <div class="col-span-1 md:col-span-6">
            <div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
              <img src="/actividades_nocturnas.webp" alt="Live music session night" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center pb-16">
          <div class="col-span-1 md:col-span-6 order-2 md:order-1">
            <div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
              <img src="https://i.imgur.com/de23L59.png" alt="Holding tropical cocktails" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
          <div class="col-span-1 md:col-span-6 text-left order-1 md:order-2">
            <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Moments of relaxation</h3>
            <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal">While the kids play, you can enjoy a rejuvenating massage at Surya Spa, read in a hammock or simply listen to the jungle.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-primary py-12 px-6 text-center border-t border-slate-100/10">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-6">
        <h3 class="text-xl md:text-2xl font-serif text-white font-semibold">Want to explore more jungle and beach adventures?</h3>
        <a href="/en/actividades-caribe" class="bg-accent hover:bg-accent text-white font-extrabold text-xs tracking-widest uppercase px-8 py-3.5 rounded shadow-lg transition-all duration-300">See more activities</a>
      </div>
    </section>

    <section class="relative min-h-87.5 flex items-center justify-center text-white py-20 px-6 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-black/55 z-10"></div>
        <img src="/day-pass.webp" alt="Enjoying pool at Cariblue" class="w-full h-full object-cover" />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto text-center flex flex-col items-center">
        <h2 class="text-3xl md:text-6xl font-serif font-bold tracking-wide leading-tight mb-8 drop-shadow-xl">Day Pass - 15,000 consumable colones</h2>
        <a href="/en/day-pass" class="bg-accent hover:bg-accent text-white font-extrabold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg transition-all duration-300 hover:shadow-pink-600/30">Day Pass</a>
      </div>
    </section>

    <section class="bg-white py-24 px-6 md:px-12 lg:px-24 border-t border-slate-100">
      <div class="max-w-7xl mx-auto text-center">
        <div class="mb-12">
          <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-3">Family gallery</h2>
          <p class="text-[10px] md:text-xs font-bold tracking-[0.25em] text-accent uppercase">Family experience</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {familyGallery.map((pic) => (
            <div class="overflow-hidden rounded shadow-lg border border-slate-100 relative group aspect-square">
              <img src={pic.img} alt={pic.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
