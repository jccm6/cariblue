---
import Layout from "../../layouts/Layout.astro";

const stats = [
	{ title: "Buffet Breakfast", text: "Included for our guests, served from 7:00 to 10:00 am", iconBg: "bg-blue-50 text-[#0f2e59]", icon: "https://i.imgur.com/rEluJd6.png" },
	{
		title: "Lunch and dinner",
		text: "Our restaurant is open from 12:00 to 9:00 pm with an updated a la carte menu.",
		iconBg: "bg-blue-50 text-[#0f2e59]",
		icon: "https://i.imgur.com/6M316q3.png",
	},
	{ title: "Happy hour", text: "From 11:00 am to 6:00 pm, enjoy happy hour at our wet bar.", iconBg: "bg-blue-50 text-[#0f2e59]", icon: "https://i.imgur.com/EyQTBhm.png" },
	{
		title: "Live Music Session",
		text: "Every Saturday at 6:30 pm with bossa, blues, jazz, reggae and calypso.",
		iconBg: "bg-blue-50 text-[#0f2e59]",
		icon: "https://i.imgur.com/OT6pzu7.png",
	},
	{ title: "Open to the public", text: "Open daily from 7:00 am to 9:00 pm.", iconBg: "bg-blue-50 text-[#0f2e59]", icon: "https://i.imgur.com/tBdnuep.png" },
];
---

<Layout
	lang="en"
	title="La Jungla Restaurant | Cariblue Resort Puerto Viejo"
	description="Enjoy the best signature cuisine at La Jungla Restaurant. Caribbean and Mediterranean fusion in Puerto Viejo, Limón."
>
	<main>
		<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 z-10"></div>
				<img src="https://i.imgur.com/oL7zSjN.jpeg" alt="Cariblue Restaurant dining area" class="w-full h-full object-cover" />
			</div>
			<div class="relative z-20 max-w-4xl mx-auto mt-8">
				<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Restaurant</h1>
			</div>
		</section>

		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
					<div class="col-span-1 lg:col-span-5">
						<div class="overflow-hidden rounded-lg shadow-2xl relative border border-slate-100 group aspect-video">
							<img src="/restaurante_la_jungla.webp" alt="Enjoying drinks by the pool" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
						</div>
					</div>
					<div class="col-span-1 lg:col-span-7 text-left">
						<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6 leading-tight">La Jungla Restaurant</h2>
						<div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal">
							<p>We invite you to discover our signature cuisine, a fusion of Mediterranean and Caribbean flavors designed to delight your palate.</p>
							<p>
								Our restaurant offers an incomparable culinary experience with a thoughtful selection of dishes for many styles of eating and dietary preferences. From ceviches,
								quesadillas, hummus, tartares and tacos to bowls, pastas, rice dishes and sandwiches.
							</p>
							<p class="italic text-slate-500 font-light">Our signature kitchen presents house-made dishes, a symphony of aromas and flavors that create a memorable experience.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-white pb-10 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
					{
						stats.map((stat) => (
							<div class="bg-white border border-slate-100 rounded-lg p-5 shadow-lg flex flex-col items-center text-center">
								<div class={`w-12 h-12 ${stat.iconBg} rounded-full flex items-center justify-center mb-4 shrink-0`}>
									<img src={stat.icon} />
								</div>
								<h3 class="text-sm font-bold text-[#0f2e59] uppercase tracking-wider mb-2.5">{stat.title}</h3>
								<p class="text-[11px] text-slate-500 leading-relaxed font-light">{stat.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="bg-primary py-10 px-6 text-center border-y border-slate-100/10">
			<div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-6">
				<h3 class="text-xl md:text-2xl font-serif text-white font-semibold">Want to see all our delicious options?</h3>
				<a
					href="https://cariblue.kivly.store/menu/6a049a97b7a1a2ae0d2fa360?tab=carta"
					target="_blank"
					class="bg-accent hover:bg-accent text-white font-extrabold text-xs tracking-widest uppercase px-8 py-3.5 rounded shadow-lg transition-all duration-300">Online menu</a
				>
			</div>
		</section>

		<section class="bg-white py-24 px-6 md:px-12 lg:px-24 space-y-20">
			<div class="max-w-6xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16 pb-16 border-b border-slate-100">
					<div class="col-span-1 lg:col-span-6 text-left">
						<div class="text-accent mb-3">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8"
								><path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 0L21 9m-1.5-3v13.5m-12-3h12M3 19.125a2.625 2.625 0 1 0 5.25 0 2.625 2.625 0 0 0-5.25 0Z"
								></path></svg
							>
						</div>
						<h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Night activities</h3>
						<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-light">
							Every weekend we host evening activities for the whole family: live music, shows and fun moments in the best Caribbean atmosphere.
						</p>
					</div>
					<div class="col-span-1 lg:col-span-6">
						<div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
							<img
								src="https://i.imgur.com/XdLw1g1.jpeg"
								alt="Live music night performance at Cariblue"
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16 pb-16 border-b border-slate-100">
					<div class="col-span-1 lg:col-span-6 order-2 lg:order-1">
						<div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
							<img
								src="https://i.imgur.com/dhYg7jr.jpeg"
								alt="Friends and family enjoying Cariblue"
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
						</div>
					</div>
					<div class="col-span-1 lg:col-span-6 text-left order-1 lg:order-2">
						<div class="text-accent mb-3">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M9.75 6.75h4.5m-6.75 7.5h.008v.008H7.5v-.008Zm3 0h.008v.008H10.5v-.008Zm3 0h.008v.008H13.5v-.008Zm3 0h.008v.008H16.5v-.008Zm-9-3h.008v.008H7.5v-.008Zm3 0h.008v.008H10.5v-.008Zm3 0h.008v.008H13.5v-.008Zm3 0h.008v.008H16.5v-.008ZM6.75 3.75h10.5a3 3 0 0 1 3 3v10.5a3 3 0 0 1-3 3H6.75a3 3 0 0 1-3-3V6.75a3 3 0 0 1 3-3Z"
								></path></svg
							>
						</div>
						<h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Game Area</h3>
						<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-light">
							Fun for all ages. Enjoy a pool table, board games and other entertainment options in an ideal setting to share with friends and family.
						</p>
					</div>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
					<div class="col-span-1 lg:col-span-6 order-2 lg:order-2">
						<div class="overflow-hidden rounded shadow-xl border border-slate-100 aspect-video relative group">
							<img
								src="https://i.imgur.com/w2EIc0m.jpeg"
								alt="Person holding fresh tropical mango cocktail"
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
						</div>
					</div>
					<div class="col-span-1 lg:col-span-6 text-left order-1 lg:order-1">
						<div class="text-accent mb-3">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8"
								><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
							>
						</div>
						<h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">Cocktails and food at our wet bar</h3>
						<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-light">
							With the wildlife show around our pool area, our wet bar is the place to enjoy delicious refreshing drinks. Happy hour runs from 11:00 am to 6:00 pm and you can also
							order food from La Jungla without leaving the pool.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="relative min-h-87.5 flex items-center justify-center text-white py-20 px-6 overflow-hidden">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-black/55 z-10"></div>
				<img src="/day-pass.webp" alt="Friends enjoying pool at Cariblue" class="w-full h-full object-cover" />
			</div>
			<div class="relative z-20 max-w-4xl mx-auto text-center flex flex-col items-center">
				<h2 class="text-3xl md:text-6xl font-serif font-bold tracking-wide leading-tight mb-4 drop-shadow-xl">Day Pass - 15,000 consumable colones</h2>
				<p class="text-sm md:text-lg font-light max-w-2xl text-slate-200/90 mb-6 drop-shadow-md">A full day in the best facilities in Puerto Viejo.</p>
				<div class="max-w-2xl bg-white/10 backdrop-blur-md border border-white/20 p-5 rounded-lg text-slate-100 text-xs md:text-sm font-normal leading-relaxed text-center">
					<p class="mb-3">Enjoy a great day in our pools and wet bar, surrounded by lush nature, and experience the best food at La Jungla restaurant.</p>
					<p class="font-bold text-white">For only 15,000 colones per person that can be used as restaurant credit.</p>
				</div>
			</div>
		</section>
	</main>
</Layout>
