---
import Layout from "../../layouts/Layout.astro";

const faqs = [
  { id: "distance", question: "HOW FAR IS CARIBLUE FROM PUERTO VIEJO?", answer: "Cariblue Beach and Jungle Resort is 2 kilometers from downtown Puerto Viejo, in front of Playa Cocles. We have a tour desk by the road and two entrances to the property.", isOpen: true },
  { id: "animals", question: "WILL WE SEE WILD ANIMALS AT THE RESORT?", answer: "Yes. Walking to your room you will most likely see wildlife. Our jungle setting is home to sloths, frogs, agoutis, toucans and several monkey species.", isOpen: false },
  { id: "weather", question: "WHAT IS THE WEATHER LIKE AND WHEN IS THE BEST TIME TO VISIT?", answer: "The climate is tropical, warm and humid. Rain can be frequent. The best months to visit are from August to October.", isOpen: false },
  { id: "pet", question: "IS THE HOTEL PET FRIENDLY?", answer: "For the safety of the local wildlife and your pet, domestic animals are not allowed in the resort.", isOpen: false },
  { id: "reserve", question: "WHAT DO I NEED TO BOOK?", answer: "You can book directly through our website any time of day. If you have questions, call +506 2750 0035 or contact us on WhatsApp.", isOpen: false },
];
---

<Layout
  lang="en"
  title="Frequently Asked Questions | Cariblue Resort Costa Rica"
  description="Questions about your stay at Cariblue? Learn about WiFi, pets, distance, weather, tours, parking and more."
>
  <main>
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0"><div class="absolute inset-0 bg-black/60 z-10"></div><img src="https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=2000&q=80" alt="Scenic coastline ocean background" class="w-full h-full object-cover" /></div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8"><h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Frequently Asked Questions</h1></div>
    </section>
    <section class="bg-white py-20 px-6 md:px-12 lg:px-24"><div class="max-w-4xl mx-auto"><div class="border border-slate-100 rounded-lg shadow-xl divide-y divide-slate-100 overflow-hidden bg-white">{faqs.map((faq) => (<div class="faq-item py-4.5 px-6 md:px-8 hover:bg-slate-50/30 transition-colors"><button class="faq-trigger w-full flex justify-between items-center text-left focus:outline-none cursor-pointer group" data-target={faq.id} aria-expanded={faq.isOpen ? "true" : "false"}><span class="text-xs md:text-[13px] font-bold text-[#0f2e59] tracking-wider group-hover:text-accent transition-colors leading-relaxed uppercase pr-4">{faq.question}</span><span class="faq-icon text-[#0f2e59] text-base font-black tracking-none w-6 h-6 flex items-center justify-center select-none shrink-0 border border-slate-100 rounded-full group-hover:border-[#e60067]/20 transition-all">{faq.isOpen ? "−" : "+"}</span></button><div id={faq.id} class={`faq-content overflow-hidden transition-all duration-300 ease-in-out ${faq.isOpen ? 'max-h-75 opacity-100 mt-4' : 'max-h-0 opacity-0'}`}><p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal bg-slate-50/50 p-5 rounded-md border-l-2 border-[#e60067]">{faq.answer}</p></div></div>))}</div></div></section>
    <section class="bg-slate-50/50 py-16 px-6 text-center border-t border-slate-100"><div class="max-w-3xl mx-auto"><h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-5 leading-tight">Still have a question?</h2><p class="text-xs md:text-sm text-slate-500 font-light leading-relaxed mb-8 max-w-2xl mx-auto">Feel free to contact us directly. Our bilingual customer service team is ready to help with whatever you need for your trip.</p><a href="https://wa.me/50683141965" target="_blank" rel="noopener noreferrer" class="inline-block bg-accent hover:bg-accent text-white font-bold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg hover:shadow-pink-600/30 transition-all duration-300">Contact us</a></div></section>
  </main>
</Layout>

<script>
  const triggers = document.querySelectorAll('.faq-trigger');
  triggers.forEach((trigger) => { trigger.addEventListener('click', () => { const targetId = trigger.getAttribute('data-target'); const content = document.getElementById(targetId || ''); const icon = trigger.querySelector('.faq-icon'); if (!content || !icon) return; const isExpanded = trigger.getAttribute('aria-expanded') === 'true'; triggers.forEach((t) => { const tid = t.getAttribute('data-target'); const c = document.getElementById(tid || ''); const ic = t.querySelector('.faq-icon'); if (c && ic) { t.setAttribute('aria-expanded', 'false'); c.classList.remove('max-h-[300px]', 'opacity-100', 'mt-4'); c.classList.add('max-h-0', 'opacity-0'); ic.textContent = '+'; } }); if (!isExpanded) { trigger.setAttribute('aria-expanded', 'true'); content.classList.remove('max-h-0', 'opacity-0'); content.classList.add('max-h-[300px]', 'opacity-100', 'mt-4'); icon.textContent = '−'; } else { trigger.setAttribute('aria-expanded', 'false'); content.classList.remove('max-h-[300px]', 'opacity-100', 'mt-4'); content.classList.add('max-h-0', 'opacity-0'); icon.textContent = '+'; } }); });
</script>
