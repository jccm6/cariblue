---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Welcome from '../../components/Welcome.astro';
import Rooms from '../../components/Rooms.astro';
import VacationBanner from '../../components/VacationBanner.astro';
import ViveCaribe from '../../components/ViveCaribe.astro';
import Testimonials from '../../components/Testimonials.astro';
import Sustainability from '../../components/Sustainability.astro';
import FindUs from '../../components/FindUs.astro';
import { getUi } from '../../i18n/ui';

const lang = "en";
const t = getUi(lang).home;
---

<Layout 
	lang={lang}
	title={t.meta.title}
	description={t.meta.description}
>
	<!-- Hero Section & Booking Bar -->
	<Hero lang={lang} />

	<!-- Welcome Description & Stats Dashboard -->
	<Welcome lang={lang} />

	<!-- Rooms Slider -->
	<Rooms lang={lang} />

	<!-- Interactive Vacation Video Callout -->
	<VacationBanner lang={lang} />

	<!-- Brand Split and Nature Slideshow -->
	<ViveCaribe lang={lang} />

	<!-- Booking/TripAdvisor Testimonials -->
	<Testimonials lang={lang} />

	<!-- Sustainability Columns -->
	<Sustainability lang={lang} />

	<!-- Contact Map & Phone Widget -->
	<FindUs lang={lang} />
</Layout>
