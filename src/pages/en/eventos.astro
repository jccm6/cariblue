---
import Layout from "../../layouts/Layout.astro";

const events = [
  {
    title: "Weddings",
    text: "Celebrate your love with an unforgettable beachfront view. The sound of the waves and the tropical setting create a romantic ceremony you will remember forever.",
    btnText: "Plan my wedding",
    image: "https://i.imgur.com/G18DOc8.png",
    alt: "Beachfront wedding ceremony with guests",
  },
  {
    title: "Birthdays",
    text: "Celebrate your birthday with friends and family in a unique setting. Enjoy the pool, restaurants and bars while our team takes care of the details.",
    btnText: "Plan my party",
    image: "https://i.imgur.com/PURlzn0.png",
    alt: "Celebrating birthday party with a cake",
  },
  {
    title: "Corporate Events",
    text: "Celebrate your team's success in a comfortable and exclusive environment. We offer versatile spaces for dinners, year-end parties and company gatherings.",
    btnText: "Plan event",
    image: "https://i.imgur.com/DcSqrQ3.png",
    alt: "Toasting champagne flutes at a business corporate event",
  },
  {
    title: "Trainings",
    text: "Host training sessions in an inspiring environment. Our comfortable facilities and restaurant service help create a productive and relaxed experience.",
    btnText: "Schedule training",
    image: "https://i.imgur.com/P7MducY.png",
    alt: "Corporate training presentation around a table",
  },
  {
    title: "Graduation Dinners",
    text: "Celebrate the achievement of your graduates in a special place. We provide flexible spaces, attentive service and food options that make the occasion memorable.",
    btnText: "Celebrate graduation",
    image: "https://i.imgur.com/Ez7CZPG.png",
    alt: "Elegant dining room table setup for graduation dinner",
  },
];
---

<Layout
  lang="en"
  title="Exclusive Events and Weddings | Cariblue Resort Costa Rica"
  description="Celebrate birthdays, beachfront weddings, corporate events, trainings and graduation dinners in the tropical setting of Cariblue Resort."
>
  <main>
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 z-10"></div>
        <img src="https://i.imgur.com/52ePjby.png" alt="Aerial beachfront island background" class="w-full h-full object-cover" />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8">
        <h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Events</h1>
      </div>
    </section>

    <section class="bg-white py-16 px-6 md:px-12 lg:px-24 border-b border-slate-100">
      <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6">Exclusive Events</h2>
        <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-light max-w-3xl">
          Live unforgettable moments in the South Caribbean with our exclusive events. From dream weddings to big birthday celebrations, our team is ready to turn your ideas into a memorable experience.
        </p>
      </div>
    </section>

    <section class="bg-white py-20 px-6 md:px-12 lg:px-24">
      <div class="max-w-5xl mx-auto space-y-16 lg:space-y-24">
        {events.map((evt) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16 last:border-0 last:pb-0">
            <div class="col-span-1 md:col-span-6 text-left">
              <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">{evt.title}</h3>
              <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal mb-6">{evt.text}</p>
              <a href="https://wa.me/50683141965" target="_blank" class="inline-block bg-accent hover:bg-accent text-white font-extrabold text-[10px] tracking-widest uppercase px-6 py-3 rounded-xs shadow-md transition-colors">{evt.btnText}</a>
            </div>
            <div class="col-span-1 md:col-span-6">
              <div class="overflow-hidden rounded shadow-xl border border-slate-100 relative group aspect-video">
                <img src={evt.image} alt={evt.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-slate-50/50 py-20 px-6 text-center border-t border-slate-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-8 leading-tight">Don't wait any longer to organize your event</h2>
        <a href="https://wa.me/50683141965" target="_blank" rel="noopener noreferrer" class="inline-block bg-accent hover:bg-accent text-white font-bold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg hover:shadow-pink-600/30 transition-all duration-300">Contact us</a>
      </div>
    </section>
  </main>
</Layout>
