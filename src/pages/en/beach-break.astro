---
import Layout from "../../layouts/Layout.astro";

const highlights = [
	"Indoor screens to catch every match",
	"Beach tables with a relaxed atmosphere",
	"High-quality food and refreshing cocktails",
	"The perfect balance between energy and Caribbean chill",
];

const menuCategories = ["Burgers and sports bar classics", "Fresh bowls and salads", "House specials", "Tacos", "Wings", "Appetizers", "Desserts", "Cocktails and bar"];

const keyInfo = [
	{
		title: "Beachfront",
		text: "Beach tables and indoor seating with screens",
		icon: "https://i.imgur.com/N6NmSHp.png",
	},
	{
		title: "Opening hours",
		text: "Monday to Sunday from 11:00 a.m. to 9:00 p.m.",
		icon: "https://i.imgur.com/s89vBk2.png",
	},
	{
		title: "Happy Hour",
		text: "Every day from 4:00 p.m. to 7:00 p.m.",
		icon: "https://i.imgur.com/89Lxb5P.png",
	},
];

const activationItems = ["Live DJ: Tuesday, Thursday, Friday and Saturday", "Time: 5:30 p.m. to 8:30 p.m.", "Sunset beach bonfire"];
---

<Layout
	lang="en"
	title="Beach Break | Beachfront sports bar in Playa Cocles"
	description="Discover Beach Break at Cariblue Resort: sports, great food and cocktails by the beach with a relaxed atmosphere and Caribbean energy."
>
	<main>
		<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 z-10 bg-black/20"></div>
				<img src="/vista_al_mar.webp" alt="Beachfront view at Beach Break" class="h-full w-full object-cover" />
			</div>
			<div class="relative z-20 max-w-4xl mx-auto mt-8">
				<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Beach Break</h1>
				<p class="mt-4 text-sm md:text-lg font-medium tracking-[0.2em] uppercase text-white/90">Beachfront sports bar</p>
			</div>
		</section>

		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-6">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Value</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight mb-6">Much more than a sports bar</h2>
					<p class="text-sm md:text-[15px] text-slate-600 leading-relaxed">Sports, great food and cocktails right by the beach.</p>
					<p class="mt-4 text-sm md:text-[15px] text-slate-600 leading-relaxed">Beach Break combines the excitement of sports with a relaxed beachfront experience.</p>
					<ul class="mt-8 space-y-4">
						{
							highlights.map((item) => (
								<li class="flex items-start gap-3 text-sm md:text-[15px] text-slate-700 leading-relaxed">
									<span class="mt-1 h-2.5 w-2.5 rounded-full bg-accent shrink-0" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<div class="mt-8 flex flex-col sm:flex-row gap-4">
						<a
							href="https://oddmenu.com/es/p/beach-break"
							target="_blank"
							class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
						>
							View menu
						</a>
						<a
							href="https://wa.me/message/75TXOCRHFENEO1"
							target="_blank"
							class="inline-flex items-center justify-center border border-slate-200 bg-white text-[#0f2e59] font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded transition-all duration-300"
						>
							Book a table (WhatsApp)
						</a>
					</div>
				</div>
				<div class="lg:col-span-6">
					<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-4/3 relative group">
						<img
							src="/coctel.webp"
							alt="Cocktails and relaxed atmosphere at Beach Break"
							class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-slate-50/60 py-20 px-6 md:px-12 lg:px-24 border-y border-slate-100">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-5">
					<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-4/5 relative group">
						<img
							src="/restaurante_la_jungla.webp"
							alt="Shareable dishes at Beach Break"
							class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
				</div>
				<div class="lg:col-span-7">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Menu</p>
					<p class="text-sm md:text-[15px] text-slate-600 leading-relaxed">A menu designed for sharing, enjoying and pairing with any moment of the day.</p>
					<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
						{menuCategories.map((item) => <div class="rounded border border-slate-200 bg-white px-5 py-4 text-sm md:text-[15px] text-[#0f2e59] font-semibold">{item}</div>)}
					</div>
					<p class="mt-8 text-sm md:text-[15px] text-slate-600 leading-relaxed">Perfect for catching the game, sharing with friends or enjoying a sunset by the sea.</p>
				</div>
			</div>
		</section>

		<section class="bg-white py-16 px-6 md:px-12 lg:px-24">
			<div class="max-w-5xl mx-auto border-t border-slate-100 pt-16">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
					{
						keyInfo.map((item) => (
							<div class="flex flex-col items-center">
								<div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center mb-4 border border-slate-100">
									<img src={item.icon} alt={item.title} />
								</div>
								<h3 class="text-sm font-bold text-[#0f2e59] uppercase tracking-wider mb-2">{item.title}</h3>
								<p class="text-xs text-slate-500 font-light leading-relaxed max-w-xs">{item.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="bg-[#0f2e59] py-20 px-6 md:px-12 lg:px-24 text-white">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-7">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Activation</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold leading-tight mb-6">Sunsets with energy</h2>
					<p class="text-sm md:text-[15px] text-white/80 leading-relaxed">The best mix of sports, music and beach.</p>
					<ul class="mt-8 space-y-4">
						{
							activationItems.map((item) => (
								<li class="flex items-start gap-3 text-sm md:text-[15px] text-white/90 leading-relaxed">
									<span class="mt-1 h-2.5 w-2.5 rounded-full bg-accent shrink-0" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<p class="mt-8 text-lg md:text-xl font-medium text-white">Come for the game, stay for the vibe.</p>
					<p class="mt-6 text-sm md:text-[15px] text-white/75 leading-relaxed">Open to hotel guests and visitors. There is always a great moment waiting for you by the sea.</p>
					<div class="mt-8 flex flex-col sm:flex-row gap-4">
						<a
							href="https://oddmenu.com/es/p/beach-break"
							target="_blank"
							class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
						>
							View menu
						</a>
						<a
							href="https://maps.app.goo.gl/NwJjTVxUU8TakKxr6"
							target="_blank"
							class="inline-flex items-center justify-center border border-white/35 bg-white/10 text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded transition-all duration-300"
						>
							How to get here
						</a>
					</div>
				</div>
				<div class="lg:col-span-5">
					<div class="overflow-hidden rounded shadow-2xl border border-white/10 aspect-4/5 relative group">
						<img src="/sushi_wave.webp" alt="Beach sunset at Beach Break" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
