---
import Layout from "../../layouts/Layout.astro";
---

<Layout
	lang="en"
	title="Club Cariblue: Every visit adds up | Cariblue Resort"
	description="Join Club Cariblue for free, earn points at our three restaurants and receive $20 cashback for every night you book directly with Cariblue."
>
	<main class="bg-white text-[#0f2e59] leading-[1.65]" id="contenido">
		<section class="px-0 pt-45 pb-[58px] bg-[linear-gradient(115deg,_#0f2e59,_var(--color-primary))] text-white max-[720px]:pt-[125px] max-[720px]:pb-[35px]">
			<div
				class="m-auto px-9 py-0 max-w-320 grid grid-cols-[1fr_1.04fr] gap-13 items-center max-[980px]:px-[25px] max-[980px]:gap-[30px] max-[720px]:px-5 max-[720px]:grid-cols-1 max-[720px]:gap-5"
			>
				<div class="px-0 py-[26px] max-[720px]:pt-3 max-[720px]:pb-[5px]">
					<nav class="flex flex-wrap gap-5 mb-8 text-[12px] text-[#dbeafe] max-[720px]:gap-4 max-[720px]:text-[11px]" aria-label="Club Cariblue sections">
						<a
							class="no-underline hover:underline focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-[5px]"
							href="#beneficios">Benefits</a
						><a
							class="no-underline hover:underline focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-[5px]"
							href="#restaurantes">Restaurants</a
						><a
							class="no-underline hover:underline focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-[5px]"
							href="#preguntas">FAQs</a>
					</nav>
					<span class="mx-0 block text-[11px] font-bold tracking-[2.2px] uppercase mt-0 mb-[18px] text-[#eff6ff]">The Caribbean has its rewards</span>
					<h1 class="mt-0 font-semibold leading-[1.15] text-[clamp(44px,_5.2vw,_72px)] mb-6 max-[380px]:text-[40px]">
						Club Cariblue:<br />every visit<br /><em class="text-[#dbeafe]">adds up.</em>
					</h1>
					<p class="mt-0 mb-5 max-w-120 text-[#eff6ff] text-[16px] max-[720px]:max-w-full">
						Enjoy more of what you love. Earn points at our three restaurants and receive <strong>$20 cashback for every night</strong> you book directly with us.
					</p>
					<div class="flex gap-3 flex-wrap">
						<a
							class="join px-6 py-[13px] border border-transparent no-underline inline-flex items-center justify-center gap-[14px] min-h-13 rounded bg-accent text-white font-bold text-[13px] cursor-pointer transition-[background] duration-200 ease-[ease] max-[380px]:w-full motion-reduce:transition-none hover:bg-[#bd0055] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-[5px]"
							href="https://wa.me/50683141965?text=Hello%2C%20I%20would%20like%20to%20join%20Club%20Cariblue.%20Could%20you%20send%20me%20the%20sign-up%20link%3F"
							>Join for free <span class="text-[21px] font-normal leading-none" aria-hidden="true">↗</span></a
						><a
							class="px-6 py-[13px] border border-[#ffffff80] no-underline inline-flex items-center justify-center gap-[14px] min-h-13 rounded bg-transparent text-white font-bold text-[13px] cursor-pointer transition-[background] duration-200 ease-[ease] max-[380px]:w-full motion-reduce:transition-none hover:bg-[#ffffff15] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-[5px]"
							href="/booking?lang=en">Book direct</a>
					</div>
					<p class="mx-0 mt-[19px] mb-0 text-[12px] leading-[1.65] text-[#eff6ff]">Free, easy, and no hotel stay required.</p>
				</div>
				<div
					class="relative min-h-[570px] rounded-[100px_12px_12px_12px] overflow-hidden max-[980px]:min-h-130 max-[980px]:h-130 max-[720px]:min-h-95 max-[720px]:rounded-[65px_8px_8px_8px] max-[720px]:h-95 min-[1400px]:min-h-155 after:inset-0 after:content-[''] after:absolute after:bg-[linear-gradient(transparent_55%,_#0f2e59b3)]"
				>
					<img
						class="block w-full h-[570px] object-cover object-[47%_center] max-[980px]:h-130 max-[980px]:min-h-130 max-[720px]:h-95 max-[720px]:min-h-95 min-[1400px]:h-155"
						src="/club-cariblue-piscina.webp"
						alt="Cariblue pool surrounded by tropical gardens"
						width="886"
						height="900"
						fetchpriority="high"
					/>
					<div
						class="p-[25px] absolute top-11 right-6 w-[235px] bg-[#0f2e59] text-white rounded-xl z-2 shadow-[0_15px_40px_#0f2e5933] rotate-5 max-[980px]:p-5 max-[980px]:right-[15px] max-[980px]:w-[195px] max-[720px]:top-[25px] max-[720px]:right-5 max-[720px]:w-50"
						role="img"
						aria-label="Illustration of the Club Cariblue digital card"
					>
						<span class="text-[10px] tracking-[2px] uppercase opacity-80">Your digital card</span>
						<div class="mx-0 font-serif text-[31px] leading-[1.1] mt-[17px] mb-6 max-[980px]:text-[27px]">Club<br />Cariblue</div>
						<div class="border-t border-t-[#ffffff40] pt-[14px] text-[11px] flex items-center justify-between">
							<span>Enjoy. Earn. Return.</span><span class="text-[28px] text-[#dbeafe]" aria-hidden="true">✳</span>
						</div>
					</div>
					<div class="absolute bottom-[30px] left-[30px] right-[30px] z-1 text-white text-[11px] tracking-[1px] max-[720px]:bottom-5 max-[720px]:left-[22px]">
						PLAYA COCLES · PUERTO VIEJO · COSTA RICA
					</div>
				</div>
			</div>
		</section>
		<div class="border-b border-b-[#e2e8f0] bg-[#f8fafc]">
			<div
				class="m-auto px-9 py-6 max-w-320 grid grid-cols-3 text-center text-[12px] max-[980px]:px-[25px] max-[720px]:px-5 max-[720px]:py-4 max-[720px]:grid-cols-1 max-[720px]:text-left max-[720px]:gap-3"
			>
				<strong class="font-semibold"><span class="text-accent mr-2" aria-hidden="true">✓</span> Free membership</strong><strong
					class="font-semibold border-l border-l-[#e2e8f0] max-[720px]:border-0"><span class="text-accent mr-2" aria-hidden="true">✓</span> Three restaurants to earn points</strong
				><strong class="font-semibold border-l border-l-[#e2e8f0] max-[720px]:border-0"><span class="text-accent mr-2" aria-hidden="true">✓</span> Your card, on your phone</strong>
			</div>
		</div>
		<section class="px-0 py-22 max-[980px]:py-18 max-[720px]:py-[55px]" id="como-funciona">
			<div class="m-auto px-9 py-0 max-w-320 max-[980px]:px-[25px] max-[720px]:px-5">
				<div class="flex justify-between gap-10 items-end mb-11 max-[720px]:block max-[720px]:mb-[30px]">
					<div>
						<span class="mx-0 block text-[11px] font-bold tracking-[2.2px] uppercase mt-0 mb-[18px] text-accent">It's that simple</span>
						<h2 class="my-0 font-semibold leading-[1.15] text-[clamp(32px,_3.6vw,_48px)] max-w-135">Enjoyment comes<br />with rewards.</h2>
					</div>
					<p class="my-0 max-w-[365px] text-[#475569] text-[16px] max-[720px]:mt-5 max-[720px]:max-w-full max-[720px]:text-[15px]">
						From joining the Club to your next reward. Every visit is a new chance to enjoy more.
					</p>
				</div>
				<div class="grid grid-cols-3 gap-[45px] max-[720px]:grid-cols-1 max-[720px]:gap-[30px]">
					<article class="border-t border-t-[#cbd5e1] pt-[22px] max-[720px]:relative max-[720px]:pl-[63px]">
						<span class="font-serif text-[38px] text-primary block leading-none mb-[27px] max-[720px]:text-[33px] max-[720px]:absolute max-[720px]:top-6 max-[720px]:left-0"
							>01</span
						>
						<h3 class="mt-0 text-[21px] leading-[1.35] max-[720px]:text-[20px] max-[720px]:mb-[10px]">Join for free</h3>
						<p class="my-0 text-[#475569] text-[14px]">Sign up in minutes and save your digital card in Apple Wallet or Google Wallet. No additional apps to download.</p>
						<div class="flex flex-wrap gap-[7px] mt-[18px]">
							<span class="px-[9px] py-[5px] border border-[#e2e8f0] text-[11px] rounded">Apple Wallet</span><span
								class="px-[9px] py-[5px] border border-[#e2e8f0] text-[11px] rounded">Google Wallet</span>
						</div>
					</article>
					<article class="border-t border-t-[#cbd5e1] pt-[22px] max-[720px]:relative max-[720px]:pl-[63px]">
						<span class="font-serif text-[38px] text-primary block leading-none mb-[27px] max-[720px]:text-[33px] max-[720px]:absolute max-[720px]:top-6 max-[720px]:left-0"
							>02</span
						>
						<h3 class="mt-0 text-[21px] leading-[1.35] max-[720px]:text-[20px] max-[720px]:mb-[10px]">Earn points</h3>
						<p class="my-0 text-[#475569] text-[14px]">Show your card when paying at La Jungla, Sushi Wave, or Beach Break. <strong>Earn 1 point for every ₡200 spent.</strong></p>
					</article>
					<article class="border-t border-t-[#cbd5e1] pt-[22px] max-[720px]:relative max-[720px]:pl-[63px]">
						<span class="font-serif text-[38px] text-primary block leading-none mb-[27px] max-[720px]:text-[33px] max-[720px]:absolute max-[720px]:top-6 max-[720px]:left-0"
							>03</span
						>
						<h3 class="mt-0 text-[21px] leading-[1.35] max-[720px]:text-[20px] max-[720px]:mb-[10px]">Enjoy your rewards</h3>
						<p class="my-0 text-[#475569] text-[14px]">Collect points, redeem rewards, and enjoy exclusive offers for Club members.</p>
					</article>
				</div>
			</div>
		</section>
		<section id="cashback" aria-labelledby="cashback-title">
			<div class="m-auto px-9 py-0 max-w-320 max-[980px]:px-[25px] max-[720px]:px-5">
				<div
					class="p-15 bg-[#0f2e59] text-white rounded-xl grid grid-cols-[1.15fr_1fr] gap-15 items-center max-[980px]:p-[42px] max-[980px]:gap-[35px] max-[720px]:px-[25px] max-[720px]:py-[35px] max-[720px]:rounded-lg max-[720px]:grid-cols-1 max-[720px]:gap-[30px]"
				>
					<div>
						<span class="mx-0 block text-[11px] font-bold tracking-[2.2px] uppercase mt-0 mb-[18px] text-[#dbeafe]">Your direct booking gives you more</span>
						<h2 class="mt-0 font-semibold leading-[1.15] text-[clamp(32px,_3.6vw,_48px)] mb-[22px] max-w-120" id="cashback-title">$20 back<br />for every night.</h2>
						<p class="mt-0 mb-5 text-[#dbeafe]">
							Book directly with Cariblue and receive cashback to enjoy during your stay at the resort. More nights, more benefits to experience the Caribbean.
						</p>
						<a
							class="px-6 py-[13px] border border-transparent no-underline inline-flex items-center justify-center gap-[14px] min-h-13 rounded bg-white text-[#0f2e59] font-bold text-[13px] cursor-pointer transition-[background] duration-200 ease-[ease] motion-reduce:transition-none hover:bg-[#dbeafe] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-[5px]"
							href="/booking?lang=en">Book direct <span class="text-[21px] font-normal leading-none" aria-hidden="true">↗</span></a
						>
						<p class="mx-0 mt-[22px] mb-0 text-[12px] leading-[1.65] text-[#dbeafe] max-w-[475px]">
							Available to Club Cariblue members booking directly through our website, WhatsApp, or by phone. Ask about the promotion's validity and terms when booking.
						</p>
					</div>
					<div
						class="px-[25px] py-3 text-center border-l border-l-[#ffffff30] max-[980px]:p-[10px] max-[720px]:pt-[30px] max-[720px]:border-l-0 max-[720px]:border-t max-[720px]:border-t-[#ffffff30]"
					>
						<div class="font-serif text-[clamp(95px,_11vw,_145px)] leading-none tracking-[-6px] text-[#dbeafe] max-[720px]:text-[110px]">$20</div>
						<p class="mx-0 mt-[15px] mb-[30px] text-[#dbeafe] text-[12px] tracking-[1px] max-[720px]:mb-[22px]">CASHBACK PER NIGHT</p>
						<div class="border-t border-t-[#ffffff30] pt-[25px] grid grid-cols-3 gap-[14px]">
							<div><span class="text-[11px] text-[#dbeafe] block">1 night</span><strong class="block text-[25px] font-normal text-white">$20</strong></div>
							<div><span class="text-[11px] text-[#dbeafe] block">2 nights</span><strong class="block text-[25px] font-normal text-white">$40</strong></div>
							<div><span class="text-[11px] text-[#dbeafe] block">3 nights</span><strong class="block text-[25px] font-normal text-white">$60</strong></div>
						</div>
						<p class="mx-0 mt-5 mb-0 text-[#dbeafe] text-[10px] tracking-normal">Example amounts for eligible bookings.</p>
					</div>
				</div>
			</div>
		</section>
		<section class="px-0 py-22 max-[980px]:py-18 max-[720px]:py-[55px]" id="beneficios">
			<div class="m-auto px-9 py-0 max-w-320 max-[980px]:px-[25px] max-[720px]:px-5">
				<div class="flex justify-between gap-10 items-end mb-11 max-[720px]:block max-[720px]:mb-[30px]">
					<div>
						<span class="mx-0 block text-[11px] font-bold tracking-[2.2px] uppercase mt-0 mb-[18px] text-accent">Membership has its perks</span>
						<h2 class="my-0 font-semibold leading-[1.15] text-[clamp(32px,_3.6vw,_48px)] max-w-135">More reasons<br />to return.</h2>
					</div>
					<p class="my-0 max-w-[365px] text-[#475569] text-[16px] max-[720px]:mt-5 max-[720px]:max-w-full max-[720px]:text-[15px]">
						Lunch, dinner by the sea, or your next getaway. What you enjoy today can add up for your next visit.
					</p>
				</div>
				<div class="grid grid-cols-3 gap-[18px] max-[720px]:grid-cols-[1fr_1fr] max-[720px]:gap-3 max-[380px]:grid-cols-1">
					<article class="p-7 border border-[#e2e8f0] bg-white rounded-lg max-[720px]:px-[17px] max-[720px]:py-[21px]">
						<div class="w-[42px] h-[42px] bg-[#eff6ff] text-primary rounded-full flex items-center justify-center mb-[25px] max-[720px]:mb-[17px]" aria-hidden="true">
							<svg class="w-[23px] h-[23px] fill-none stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"
								><path d="M3 10h18v4H3zM5 14v7h14v-7M12 10v11M12 10H7a3 3 0 1 1 3-3l2 3Zm0 0h5a3 3 0 1 0-3-3l-2 3Z"></path></svg>
						</div>
						<h3 class="mt-0 text-[18px] leading-[1.35] mb-[10px] max-[720px]:text-[16px]">A welcome benefit</h3>
						<p class="my-0 text-[14px] text-[#475569] max-[720px]:text-[13px]">
							Enjoy <strong>10% off your first purchase.</strong> A voucher valid for 30 business days; cannot be used with promotions.
						</p>
					</article>
					<article class="p-7 border border-[#e2e8f0] bg-white rounded-lg max-[720px]:px-[17px] max-[720px]:py-[21px]">
						<div class="w-[42px] h-[42px] bg-[#eff6ff] text-primary rounded-full flex items-center justify-center mb-[25px] max-[720px]:mb-[17px]" aria-hidden="true">
							<svg class="w-[23px] h-[23px] fill-none stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"
								><circle cx="12" cy="12" r="9"></circle><path d="m12 6 1.7 3.5 3.8.6-2.8 2.7.7 3.8-3.4-1.8-3.4 1.8.7-3.8-2.8-2.7 3.8-.6Z"></path></svg>
						</div>
						<h3 class="mt-0 text-[18px] leading-[1.35] mb-[10px] max-[720px]:text-[16px]">Points for spending</h3>
						<p class="my-0 text-[14px] text-[#475569] max-[720px]:text-[13px]">Every ₡200 earns 1 point. Show your card when paying and get closer to your next reward.</p>
					</article>
					<article class="p-7 border border-[#e2e8f0] bg-white rounded-lg max-[720px]:px-[17px] max-[720px]:py-[21px]">
						<div class="w-[42px] h-[42px] bg-[#eff6ff] text-primary rounded-full flex items-center justify-center mb-[25px] max-[720px]:mb-[17px]" aria-hidden="true">
							<svg class="w-[23px] h-[23px] fill-none stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"
								><path d="M4 5h16v15H4zM8 3v4M16 3v4M4 10h16m-12 5 3 3 5-5"></path></svg>
						</div>
						<h3 class="mt-0 text-[18px] leading-[1.35] mb-[10px] max-[720px]:text-[16px]">Benefits for visiting</h3>
						<p class="my-0 text-[14px] text-[#475569] max-[720px]:text-[13px]">Returning pays off. Discover the benefits you can unlock by continuing to visit our restaurants.</p>
					</article>
					<article class="p-7 border border-[#e2e8f0] bg-white rounded-lg max-[720px]:px-[17px] max-[720px]:py-[21px]">
						<div class="w-[42px] h-[42px] bg-[#eff6ff] text-primary rounded-full flex items-center justify-center mb-[25px] max-[720px]:mb-[17px]" aria-hidden="true">
							<svg class="w-[23px] h-[23px] fill-none stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"
								><path d="M5 4h14v5a7 7 0 0 1-14 0ZM5 6H2v3a4 4 0 0 0 5 4M19 6h3v3a4 4 0 0 1-5 4M12 16v5M7 21h10"></path></svg>
						</div>
						<h3 class="mt-0 text-[18px] leading-[1.35] mb-[10px] max-[720px]:text-[16px]">Redeem rewards</h3>
						<p class="my-0 text-[14px] text-[#475569] max-[720px]:text-[13px]">
							Turn your points into food, drinks, and rewards from the Club's catalogue. Choose your next reason to visit.
						</p>
					</article>
					<article class="p-7 border border-[#e2e8f0] bg-white rounded-lg max-[720px]:px-[17px] max-[720px]:py-[21px]">
						<div class="w-[42px] h-[42px] bg-[#eff6ff] text-primary rounded-full flex items-center justify-center mb-[25px] max-[720px]:mb-[17px]" aria-hidden="true">
							<svg class="w-[23px] h-[23px] fill-none stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"
								><path d="m3 3 9 1 9 9-8 8-9-9Z"></path><circle cx="8" cy="8" r="1.5"></circle></svg>
						</div>
						<h3 class="mt-0 text-[18px] leading-[1.35] mb-[10px] max-[720px]:text-[16px]">Exclusive offers</h3>
						<p class="my-0 text-[14px] text-[#475569] max-[720px]:text-[13px]">Access special offers for members and enjoy the Club's current benefits.</p>
					</article>
					<article class="p-7 border border-[#dbeafe] bg-[#eff6ff] rounded-lg max-[720px]:px-[17px] max-[720px]:py-[21px]">
						<div class="w-[42px] h-[42px] bg-white text-accent rounded-full flex items-center justify-center mb-[25px] max-[720px]:mb-[17px]" aria-hidden="true">
							<svg class="w-[23px] h-[23px] fill-none stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"
								><path d="M3 5h18v14H3zM3 9h18M7 15h3m5 0 2-2 2 2m-2-2v4"></path></svg>
						</div>
						<h3 class="mt-0 text-[18px] leading-[1.35] mb-[10px] max-[720px]:text-[16px]">Cashback per night</h3>
						<p class="my-0 text-[14px] text-[#475569] max-[720px]:text-[13px]">Receive $20 cashback for every night of an eligible direct booking. Your holiday adds up too.</p>
					</article>
				</div>
				<p class="mt-[18px] mb-0 text-[12px] leading-[1.65] text-[#475569]">Benefits, rewards, and promotions are subject to their respective terms of use and availability.</p>
			</div>
		</section>
		<section class="px-0 py-22 bg-[#f8fafc] max-[980px]:py-18 max-[720px]:py-[55px]" id="restaurantes">
			<div class="m-auto px-9 py-0 max-w-320 max-[980px]:px-[25px] max-[720px]:px-5">
				<div class="flex justify-between gap-10 items-end mb-11 max-[720px]:block max-[720px]:mb-[30px]">
					<div>
						<span class="mx-0 block text-[11px] font-bold tracking-[2.2px] uppercase mt-0 mb-[18px] text-accent">Choose your next craving</span>
						<h2 class="my-0 font-semibold leading-[1.15] text-[clamp(32px,_3.6vw,_48px)] max-w-135">Three restaurants.<br />One Club.</h2>
					</div>
					<p class="my-0 max-w-[365px] text-[#475569] text-[16px] max-[720px]:mt-5 max-[720px]:max-w-full max-[720px]:text-[15px]">
						Caribbean flavours, Nikkei cuisine, and sports bar favourites. So many ways to enjoy and keep earning.
					</p>
				</div>
				<div class="grid grid-cols-3 gap-[26px] max-[720px]:grid-cols-1 max-[720px]:gap-[38px]">
					<article class="flex flex-col">
						<img
							class="block w-full h-[275px] rounded-lg object-cover mb-6 max-[980px]:h-[225px] max-[720px]:h-[290px] max-[720px]:mb-[19px]"
							src="/club-cariblue-la-jungla.webp"
							alt="Sharing dishes at La Jungla"
							loading="lazy"
							width="850"
							height="567"
						/>
						<span class="text-[10px] tracking-[1.6px] font-bold uppercase text-primary mb-2">Between the jungle and the Caribbean</span>
						<h3 class="mt-0 text-[29px] leading-[1.35] mb-[10px]">La Jungla</h3>
						<p class="mt-0 mb-5 text-[14px] text-[#475569] flex-1 max-[720px]:mb-3">
							Breakfast, lunch, and dinner blending Mediterranean and Caribbean flavours, surrounded by nature. You can also order from the pool's Wet Bar.
						</p>
						<a
							class="no-underline flex items-center justify-between gap-3 text-[13px] font-bold border-t border-t-[#cbd5e1] pt-[15px] mt-1 hover:text-primary focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-[5px]"
							href="/en/restaurante">Discover La Jungla <span class="text-[21px] font-normal leading-none" aria-hidden="true">↗</span></a
						>
					</article>
					<article class="flex flex-col">
						<img
