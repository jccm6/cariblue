---
import RoomDetailPage from "../../../components/RoomDetailPage.astro";
import { getRooms } from "../../../i18n/rooms";

export function getStaticPaths() {
  return getRooms("en").map((room) => ({
    params: { slug: room.slug },
  }));
}

const slug = Astro.params.slug ?? "";
---

<RoomDetailPage lang="en" slug={slug} />
