---
import Layout from '../../../layouts/Layout.astro';
import RoomGallery from '../../../components/RoomGallery.astro';

// Room detail values
const title = "Beach Apartment";
const description = "Wake up every morning in our vacation apartment and feel the closeness of the Caribbean Sea. Located just steps from the paradise-like Playa Cocles, this retreat offers the perfect combination of luxury and beach proximity.";

const images = [
  "https://i.imgur.com/YVQ2tTY.jpeg",
  "https://i.imgur.com/WdVUhCt.jpeg",
  "https://i.imgur.com/ZRkncyd.jpeg",
  "https://i.imgur.com/A7bmrg2.jpeg",
  "https://i.imgur.com/Lfn7i5b.jpeg",
  "https://i.imgur.com/T8ZJZaa.jpeg",
  "https://i.imgur.com/8xJiSzV.jpeg",
  "https://i.imgur.com/g4P9LQr.jpeg",
];

const amenities = [
  "Up to 5 guests",
  "Ceiling fan",
  "Air conditioning",
  "Wardrobe",
  "Balcony / Terrace",
  "Private bathroom with hot water",
  "32-inch plasma TV with cable",
  "Safe",
  "Equipped kitchen",
  "Buffet breakfast",
  "Desk",
  "Free parking",
  "Living area",
  "Mini fridge",
  "Shared pool",
  "Refrigerator",
  "Hair dryer",
  "Towels"
];

const services = [
  "Room service",
  "Wi-Fi"
];

const reasons = [
  { text: "Quality service", icon: "thumbs-up" },
  { text: "Excellent location", icon: "map-pin" },
  { text: "Best value for money", icon: "currency-dollar" },
  { text: "Rooms with private bathrooms", icon: "home" },
  { text: "La Jungla Restaurant", icon: "cake" },
  { text: "2 pools and jacuzzi", icon: "sparkles" },
  { text: "Pool bar", icon: "drink" },
  { text: "Sushi Wave", icon: "star" }
];

const otherRooms = [
  {
    title: "Beach Studio",
    image: "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=600&q=80",
    slug: "beach-studio",
    specs: "3 guests | 1 king bed",
    description: "Practical and comfortable studio just steps from Playa Cocles, ideal for a functional stay by the sea."
  },
  {
    title: "Ocean Beach View Suites",
    image: "https://images.unsplash.com/photo-1575429198097-0414ec08e8cd?auto=format&fit=crop&w=600&q=80",
    slug: "ocean-beach-view-suites",
    specs: "55 m² | 6 guests | 3 Beds",
    description: "Upper-floor suites with panoramic sea views, designed for a spacious and comfortable stay."
  }
];
---

<Layout 
  title={`${title} | Cariblue Resort Rooms`}
  description={description}
>
  <main class="bg-white">
    <!-- Page Hero Banner -->
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 z-10"></div>
        <img 
          src="https://i.imgur.com/RoAVIZt.jpeg" 
          alt={`${title}`} 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8">
        <h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
          {title}
        </h1>
      </div>
    </section>

    <RoomGallery images={images} title={title} />

    <!-- Main Grid Contents: Left details, Right cards -->
    <section class="bg-white py-16 px-6 md:px-12 lg:px-24">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Side: descriptions (8 columns) -->
        <div class="col-span-1 lg:col-span-8 text-left">
          
          <!-- Description text -->
          <div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal mb-10">
            <p>
              Wake up every morning in our vacation apartment and feel the closeness of the Caribbean Sea. Located just steps from the paradise-like Playa Cocles, this retreat offers the perfect combination of luxury and beach proximity. Imagine starting your day with a short walk and arriving at the soft sands of one of the area's most beautiful beaches.
            </p>
            <p>
              The main bedroom is a true sanctuary of rest, with a king-size bed for a restorative sleep and a cozy adjacent living area equipped with a 55-inch TV, ideal for relaxing after a day of sun and surf. In addition, the second bedroom, with two comfortable single beds, offers an extra cozy space, ideal for friends or family. Both bedrooms have air conditioning to ensure your comfort.
            </p>
            <p>
              The American-style kitchen is a true gathering point in the apartment, fully equipped and featuring a large central island that invites shared meals and pleasant conversation.
            </p>
            <p>
              What truly makes this apartment special is its location. Set in a lively area, you will be surrounded by excellent restaurants and just steps from Playa Cocles's famous surf scene. Here, every day is a new opportunity to immerse yourself in local culture and enjoy everything beach life has to offer.
            </p>
            <p class="font-semibold italic text-[#0f2e59]">
              This apartment is not just a place to stay; it is your gateway to a unique vacation experience where luxury meets adventure in the heart of the Caribbean. Book now and get ready for a vacation you will always remember.
            </p>
          </div>

          <!-- Amenities & Services lists -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8 border-t border-slate-100">
            
            <!-- Amenities -->
            <div>
              <h4 class="text-md font-bold uppercase tracking-widest text-[#0f2e59] mb-4 flex items-center space-x-2">
                <!-- Bell icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-accent">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0M3.124 7.5A8.969 8.969 0 0 1 5.292 3m13.416 0a8.969 8.969 0 0 1 2.168 4.5" />
                </svg>
                <span>Amenities</span>
              </h4>
              <ul class="space-y-2 text-sm text-slate-500 font-medium">
                {amenities.map((item) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-accent font-bold shrink-0">&rsaquo;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Services -->
            <div>
              <h4 class="text-md font-bold uppercase tracking-widest text-[#0f2e59] mb-4 flex items-center space-x-2">
                <!-- Concierge icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-accent">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
                <span>Room Services</span>
              </h4>
              <ul class="space-y-2 text-sm text-slate-500 font-medium">
                {services.map((item) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-accent font-bold shrink-0">&rsaquo;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

          </div>

        </div>

        <!-- Right Side: Sidebar Cards (4 columns) -->
        <div class="col-span-1 lg:col-span-4 space-y-8 lg:sticky lg:top-24">
          
          <!-- Card 1: Why Choose Cariblue -->
          <div class="bg-white border border-slate-100 rounded shadow-xl overflow-hidden text-left">
            <div class="bg-primary text-white px-6 py-4 font-bold text-sm uppercase tracking-wider">
              Why Choose Cariblue
            </div>
            <div class="p-6">
              <ul class="divide-y divide-slate-50 text-sm text-slate-600 font-medium">
                {reasons.map((rec) => (
                  <li class="py-3 flex items-center space-x-3 first:pt-0 last:pb-0">
                    <!-- Thumbs up dynamic representation -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-accent shrink-0">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span>{rec.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Card 2: Information and reservations -->
          <div class="bg-white border border-slate-100 rounded shadow-xl overflow-hidden text-left">
            <div class="bg-primary text-white px-6 py-4 font-bold text-sm uppercase tracking-wider">
              Information and reservations
            </div>
            <div class="p-6 space-y-4 text-sm font-semibold text-slate-600">
              <div class="flex items-start space-x-3.5">
                <span class="text-slate-400 font-bold shrink-0">Tel:</span>
                <a href="tel:+50627500035" class="hover:text-accent transition-colors">506 2750 0035</a>
              </div>
              <div class="flex items-start space-x-3.5">
                <span class="text-slate-400 font-bold shrink-0">Whatsapp:</span>
                <a href="https://wa.me/50683141965" target="_blank" class="hover:text-green-500 transition-colors">+506 8314 1965</a>
              </div>
              <div class="flex items-start space-x-3.5">
                <span class="text-slate-400 font-bold shrink-0">Email:</span>
                <a href="mailto:reservations@cariblue.com" class="hover:text-accent transition-colors">reservations@cariblue.com</a>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Other Rooms Suggestion Section (replaces WordPress warning) -->
    <!-- <section class="bg-slate-50 py-24 px-6 md:px-12 lg:px-24 border-t border-slate-100">
      <div class="max-w-6xl mx-auto text-center">
        <div class="mb-14">
          <h2 class="text-3xl font-serif font-bold text-[#0f2e59] mb-1">Other rooms</h2>
          <p class="text-[10px] md:text-xs font-bold tracking-[0.25em] text-accent uppercase">
            YOU MAY ALSO LIKE OTHER ROOMS
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {otherRooms.map((room) => (
            <div class="bg-white rounded border border-slate-100 shadow-lg overflow-hidden flex flex-col text-left">
              <div class="h-50 overflow-hidden">
                <img 
                  src={room.image} 
                  alt={room.title} 
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="text-lg font-serif font-bold text-[#0f2e59] mb-2">{room.title}</h3>
                  <span class="inline-block text-[10px] font-bold text-accent uppercase tracking-wider mb-3">{room.specs}</span>
                  <p class="text-xs text-slate-500 leading-relaxed font-light mb-6">{room.description}</p>
                </div>
                <div>
                  <a href="/#habitaciones" class="text-xs font-bold text-[#0f2e59] hover:text-accent uppercase tracking-wider border-b border-[#0f2e59] pb-0.5 transition-colors">
                    View Room &rarr;
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section> -->
  </main>
</Layout>
