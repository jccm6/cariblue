---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="Contact & Events | Cariblue Resort Puerto Viejo Costa Rica"
  description="Get in touch with Cariblue Beach & Jungle Resort. Send us a message or plan your wedding, birthday, dinner or corporate event in the jungle of Puerto Viejo."
>
  <main>
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 z-10"></div>
        <img src="https://i.imgur.com/Fjh4XeT.jpeg" alt="Aerial beach coastal jungle view" class="w-full h-full object-cover" />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8">
        <h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Contact & Events</h1>
      </div>
    </section>

    <section class="relative z-30 px-6 max-w-6xl mx-auto -mt-12 md:-mt-16 mb-16">
      <div class="bg-white rounded-lg border border-slate-100 shadow-2xl p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-100 text-center">
          <div class="flex flex-col items-center justify-center p-3 pt-6 md:pt-3">
            <div class="w-12 h-12 bg-blue-50 text-accent rounded-full flex items-center justify-center mb-4"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg></div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#0f2e59] mb-2">Address</h3>
            <p class="text-xs text-slate-500 leading-relaxed font-normal max-w-xs">Cocles Beach, 1.5 Km. South Puerto Viejo,<br />70403 Puerto Viejo, Costa Rica.</p>
          </div>
          <div class="flex flex-col items-center justify-center p-3 pt-6 md:pt-3">
            <div class="w-12 h-12 bg-blue-50 text-accent rounded-full flex items-center justify-center mb-4"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.035 12.035 0 0 1-7.108-7.108c-.145-.44.02-.927.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg></div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#0f2e59] mb-2">Phone</h3>
            <ul class="text-xs text-slate-500 space-y-1 font-normal">
              <li>Landline: <a href="tel:+50627500035" class="hover:text-accent font-semibold">+506 2750 0035</a></li>
              <li>WhatsApp: <a href="https://wa.me/50683141965" target="_blank" class="hover:text-green-500 font-semibold">+506 8314 1965</a></li>
              <li>TollFree: <a href="tel:18886499773" class="hover:text-accent font-semibold">1-888-6499-773</a></li>
            </ul>
          </div>
          <div class="flex flex-col items-center justify-center p-3 pt-6 md:pt-3">
            <div class="w-12 h-12 bg-blue-50 text-accent rounded-full flex items-center justify-center mb-4"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg></div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#0f2e59] mb-2">Email</h3>
            <p class="text-xs text-slate-500 leading-relaxed font-semibold"><a href="mailto:reservations@cariblue.com" class="hover:text-accent transition-colors">reservations@cariblue.com</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
