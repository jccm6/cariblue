---
import Layout from "../../layouts/Layout.astro";

const coreActions = [
  { title: "Cleanliness", text: "We reduce plastic containers by working with suppliers that use returnable or biodegradable packaging." },
  { title: "Drinking Water", text: "We installed a purified water station so guests can refill bottles and avoid disposable plastics." },
  { title: "Amenities", text: "We replaced small bottles with refillable dispensers using biodegradable products." },
  { title: "Waste management", text: "We recycle and sort the waste generated at the resort to ensure proper disposal." },
  { title: "Restaurant", text: "We use fresh, local and responsibly sourced ingredients to offer healthy and sustainable food." },
  { title: "Pool towels", text: "We use microfiber towels to reduce water and energy use and shorten drying time." },
];

const alliances = [
  { title: "Rainforest Alliance", logo: "https://i.imgur.com/IeqyG8A.png", text: "Protects and preserves the Caribbean reefs and promotes environmental education and beach cleanups." },
  { title: "The Sloth Conservation Foundation", logo: "https://i.imgur.com/d8909Kt.png", text: "Protects sloths, Costa Rica's national symbol, and helps create safe aerial bridges through the jungle." },
  { title: "Plant My Tree", logo: "https://i.imgur.com/XiGAyrg.png", text: "Funds the planting of 100 trees per month in deforested areas of Costa Rica." },
];

const recommendations = [
  { title: "1. Care for spaces and objects", text: "Take care of the hotel spaces and objects to extend their useful life and reduce resource demand.", icon: "https://i.imgur.com/Lc5bg0O.png" },
  { title: "2. Choose eco-friendly products", text: "Choose reusable packaging or products without packaging to reduce waste during your trip.", icon: "https://i.imgur.com/GDYKk7i.png" },
  { title: "3. Use drinking water stations", text: "Refill reusable bottles at our purified water station and reduce single-use plastic consumption.", icon: "https://i.imgur.com/e1r4dyw.png" },
  {
    title: "4. Sort waste",
    text: "Sort the waste generated at the resort to ensure proper disposal and reduce single-use plastic consumption.",
    icon: "https://i.imgur.com/axPlXvl.png"
  },
  {
    title: "5. Souvenirs and local economy",
    text: "Support local businesses and promote sustainable tourism by buying local souvenirs and supporting local economy.",
    icon: "https://i.imgur.com/oYTF1k2.png"
  },
  {
    title: "6. Respect the trails",
    text: "Respect the trails and avoid deforestation by following the trails and taking care of the trees.",
    icon: "https://i.imgur.com/wGxootJ.png"
  }
];
---

<Layout
  lang="en"
  title="Sustainability & Eco Commitment | Cariblue Resort Costa Rica"
  description="Discover our sustainability efforts at Cariblue Resort: eco-friendly practices, plastic reduction and support for local biodiversity."
>
  <main>
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0"><div class="absolute inset-0 bg-black/45 z-10"></div><img src="https://i.imgur.com/FMNK8bT.jpeg" alt="Exuberant tropical jungle canopy background" class="w-full h-full object-cover" /></div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8"><h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Sustainability</h1></div>
    </section>
    <section class="bg-white py-20 px-6 md:px-12 lg:px-24"><div class="max-w-7xl mx-auto"><div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"><div class="col-span-1 lg:col-span-7 text-left"><h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6 leading-tight">Sustainability</h2><div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal"><p>Cariblue Jungle & Beach Resort is immersed in more than 20,000 square meters of tropical jungle, home to incredible wildlife.</p><p>We live in harmony with nature and work every day to protect it, implementing actions that reduce our impact and promote respect for the flora and fauna around us.</p><p class="font-semibold text-[#0f2e59] italic border-l-2 border-[#e60067] pl-4">Our commitment is simple: care for this paradise and share it responsibly with those who visit us.</p></div></div><div class="col-span-1 lg:col-span-5"><div class="overflow-hidden rounded-lg shadow-2xl relative border border-slate-100 group aspect-video"><img src="https://i.imgur.com/go0oipy.png" alt="Monkeys in the trees - Cariblue Sustainability" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" /></div></div></div></div></section>
    <section class="bg-primary py-24 px-6 md:px-12 lg:px-24 text-white"><div class="max-w-7xl mx-auto text-center"><div class="mb-14"><h2 class="text-3xl md:text-5xl font-serif font-bold mb-4">How we care for our surroundings</h2></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">{coreActions.map((action) => (<div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-lg p-6 md:p-8 flex flex-col justify-center items-center text-center shadow-lg hover:bg-white/15 transition-all"><h3 class="text-base font-bold uppercase tracking-wider mb-3 text-slate-100">{action.title}</h3><p class="text-xs text-slate-200/90 leading-relaxed font-light">{action.text}</p></div>))}</div></div></section>
    <section class="relative min-h-87.5 flex items-center justify-center text-white py-24 px-6 overflow-hidden"><div class="absolute inset-0 z-0"><div class="absolute inset-0 bg-black/60 z-10"></div><img src="https://i.imgur.com/WtPRlPF.jpeg" alt="Jungle canopy green view" class="w-full h-full object-cover" /></div><div class="relative z-20 max-w-4xl mx-auto text-center flex flex-col items-center"><h2 class="text-2xl md:text-4xl font-serif font-bold tracking-wide leading-tight mb-4 drop-shadow-xl max-w-2xl">Projects and initiatives we support: together for a better planet</h2><p class="text-xs md:text-sm font-light max-w-2xl text-slate-200/90 leading-relaxed drop-shadow-md">At Cariblue we support local and global initiatives that promote conservation, environmental education and community wellbeing.</p></div></section>
    <section class="bg-white py-24 px-6 md:px-12 lg:px-24"><div class="max-w-6xl mx-auto"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">{alliances.map((alliance) => (<div class="flex flex-col justify-between items-center text-center p-6 bg-white border border-slate-50 shadow-lg rounded-lg hover:shadow-xl transition-shadow duration-300"><div><img src={alliance.logo} alt={alliance.title} class="mb-6 m-auto" /><h3 class="text-sm font-bold text-[#0f2e59] uppercase tracking-wider mb-3 leading-tight">{alliance.title}</h3><p class="text-[11px] text-slate-500 leading-relaxed font-light mb-6">{alliance.text}</p></div><a href="https://wa.me/50683141965" target="_blank" class="bg-accent hover:bg-accent text-white font-extrabold text-[10px] tracking-widest uppercase px-6 py-2.5 rounded-xs transition-colors shadow-sm">More info</a></div>))}</div></div></section>
    <section class="bg-slate-50/50 py-24 px-6 md:px-12 lg:px-24 border-t border-slate-100"><div class="max-w-5xl mx-auto text-center"><div class="max-w-3xl mx-auto mb-16 text-center"><p class="text-xs md:text-sm text-slate-500 leading-relaxed mb-6 font-normal">Cariblue Jungle and Beach Resort is committed to maintaining a balanced environment in which our strategies, staff and guests work together.</p><p class="text-sm font-bold text-[#0f2e59] tracking-wider uppercase">We encourage our guests to join this change and leave a positive mark with these recommendations:</p></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 text-left">{recommendations.map((rec) => (<div class="flex flex-col bg-white border border-slate-100 rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300"><div class="w-12 h-12 rounded-full bg-slate-50 flex items-center justify-center mb-5 border border-slate-100 shrink-0"><img src={rec.icon} /></div><h3 class="text-xs font-bold text-[#0f2e59] uppercase tracking-wider mb-2.5 leading-tight">{rec.title}</h3><p class="text-[11px] text-slate-500 leading-relaxed font-light">{rec.text}</p></div>))}</div></div></section>
  </main>
</Layout>
