---
import Layout from "../../layouts/Layout.astro";

const packages = [
  {
    title: "Girls' Getaway",
    label: "Package 1:",
    text: "Join our weekend escape with friends. From $130 per person, enjoy 2 nights at our cozy hotel while you relax, reconnect and create unforgettable memories.",
    image: "https://i.imgur.com/zlx6lyW.png",
    alt: "Three friends enjoying a pool day at Cariblue",
  },
  {
    title: "Romantic Escape",
    label: "Package 2:",
    text: "Enjoy a two-night romantic getaway for two in the Caribbean. From $255 per couple, experience a package designed to celebrate love and connection.",
    image: "https://i.imgur.com/9PcQsnw.png",
    alt: "Romantic couple enjoying cocktails in the pool",
  },
  {
    title: "Family Escape",
    label: "Package 3:",
    text: "Live an unforgettable experience in the heart of the Caribbean. Sunny days, fun and special family moments await at Cariblue.",
    image: "https://i.imgur.com/gH01ZPm.png",
    alt: "Family swimming in pool",
  },
  {
    title: "Self Retreat Program",
    label: "Package 4:",
    text: "Need a personal retreat? Spend three full days focusing on your wellbeing in the paradise of the Caribbean. From $210, enjoy a rejuvenating reset for body, mind and spirit.",
    image: "https://i.imgur.com/lCfSGcn.png",
    alt: "Woman conducting a yoga meditation retreat",
  },
  {
    title: "Caribbean Anniversary",
    label: "Package 5:",
    text: "Celebrate your anniversary with a dreamy romantic escape. From $225 per couple, choose between Full, Light or Relax options and surprise your loved one with an unforgettable trip.",
    image: "https://i.imgur.com/rRRFZOf.png",
    alt: "Couple smiling in a luxury resort room suite",
  },
  {
    title: "Honeymoon Program",
    label: "Package 6:",
    text: "This destination is perfect for newlyweds. From $1,510 per couple, enjoy 4 nights at our hotel and let us handle the rest with a set of special honeymoon experiences.",
    image: "https://i.imgur.com/HO98b1p.png",
    alt: "Newlywed couple smiling in the resort tropical gardens",
  },
  {
    title: "Adventure in the Caribbean",
    label: "Package 7:",
    text: "Start the trip of a lifetime in the South Caribbean of Costa Rica. For $1,350, enjoy 4 nights for two people and a set of exciting tours that turn your stay into an adventure.",
    image: "https://i.imgur.com/WtFk5sa.png",
    alt: "White water river rafting in Costa Rica",
  },
];
---

<Layout
  lang="en"
  title="Accommodation Packages and Tours | Cariblue Resort Costa Rica"
  description="Discover our vacation packages in Puerto Viejo: friends getaways, romantic escapes, honeymoon, family and adventure programs in Costa Rica."
>
  <main>
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 z-10"></div>
        <img src="https://i.imgur.com/52ePjby.png" alt="Aerial beachfront view" class="w-full h-full object-cover" />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8">
        <h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Packages</h1>
      </div>
    </section>

    <section class="bg-white py-16 px-6 md:px-12 lg:px-24 border-b border-slate-100">
      <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6">Packages</h2>
        <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-light max-w-3xl">
          Welcome to Cariblue, where you will find a wide variety of packages designed to match every taste and need. Whether you want a relaxing escape, an adventure-filled trip or custom tours around the area, you can build an unforgettable stay.
        </p>
      </div>
    </section>

    <section class="bg-white py-20 px-6 md:px-12 lg:px-24">
      <div class="max-w-5xl mx-auto space-y-16 lg:space-y-24">
        {packages.map((pkg) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16 last:border-0 last:pb-0">
            <div class="col-span-1 md:col-span-6 text-left">
              <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-1">{pkg.title}</h3>
              <span class="inline-block text-xs font-bold text-accent uppercase tracking-wider mb-4">{pkg.label}</span>
              <p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal whitespace-pre-line">{pkg.text}</p>
            </div>
            <div class="col-span-1 md:col-span-6">
              <div class="overflow-hidden rounded shadow-xl border border-slate-100 relative group aspect-video">
                <img src={pkg.image} alt={pkg.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-slate-50/50 py-20 px-6 text-center border-t border-slate-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-8 leading-tight">Don't wait any longer to plan your next getaway</h2>
        <a href="https://wa.me/50683141965" target="_blank" rel="noopener noreferrer" class="inline-block bg-accent hover:bg-accent text-white font-bold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg hover:shadow-pink-600/30 transition-all duration-300">Contact us</a>
      </div>
    </section>
  </main>
</Layout>
