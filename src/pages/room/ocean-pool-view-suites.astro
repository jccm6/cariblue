---
import Layout from '../../layouts/Layout.astro';

// Room detail values
const title = "Ocean Pool View Suites";
const description = "Situado en una ubicación privilegiada frente al mar, este distinguido módulo consta de tres suites en la planta baja, todas ellas con acceso directo a una exquisita piscina con cascada.";

const images = [
  "https://images.unsplash.com/photo-1575429198097-0414ec08e8cd?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1570213489059-0aac6626cade?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=600&q=80"
];

const amenities = [
  "1 cama King y 2 camas matrimoniales",
  "2 habitaciones",
  "55 m²",
  "6 personas máximo",
  "Abanico de techo",
  "Aire acondicionado",
  "Baños privados con ducha y agua caliente",
  "Cable Tv plasma 32 pulgadas",
  "Caja de seguridad",
  "Cama extra suplementaria si se requiere",
  "Coffee maker",
  "Dispensadores con Shampoo, acondicionador y gel de ducha biodegradables preparadas en la Costa Caribeña",
  "Escritorio",
  "Habitación no fumadores",
  "Living",
  "Refrigerador",
  "Secador de pelo",
  "Terraza con hamacas y juego de sillas",
  "Veladores con toma de corriente USB"
];

const services = [
  "Servicio a la habitación",
  "Wifi"
];

const reasons = [
  { text: "Servicio de calidad", icon: "thumbs-up" },
  { text: "Ubicación inmejorable", icon: "map-pin" },
  { text: "La mejor relación precio/calidad", icon: "currency-dollar" },
  { text: "Habitaciones con baño privado", icon: "home" },
  { text: "Restaurante La Jungla", icon: "cake" },
  { text: "2 piscinas y jacuzzi", icon: "sparkles" },
  { text: "Bar de piscina", icon: "drink" },
  { text: "Sushi Wave", icon: "star" }
];

const otherRooms = [
  {
    title: "Junior Suite",
    image: "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80",
    slug: "junior-suite",
    specs: "80 m² | 5 huéspedes | 2 Camas",
    description: "Ubicada en el sector jungla, cerca de la piscina principal, es una de nuestras opciones más espaciosas para una estadía de confort."
  },
  {
    title: "Ocean Beach View Suites",
    image: "https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=600&q=80",
    slug: "ocean-beach-view-suites",
    specs: "55 m² | 6 huéspedes | 3 Camas",
    description: "Suites ubicadas en planta alta con magnífica vista panorámica al mar y distribución ideal para grupos."
  }
];
---

<Layout 
  title={`${title} | Habitaciones Cariblue Resort`}
  description={description}
>
  <main class="bg-white">
    <!-- Page Hero Banner -->
    <section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-[#05152b]/55 z-10"></div>
        <img 
          src="https://images.unsplash.com/photo-1575429198097-0414ec08e8cd?auto=format&fit=crop&w=2000&q=80" 
          alt={`${title} Jungle View`} 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="relative z-20 max-w-4xl mx-auto mt-8">
        <h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
          {title}
        </h1>
      </div>
    </section>

    <!-- panoramic Image Gallery Row -->
    <section class="w-full bg-slate-50 py-4 px-4 md:px-12">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4">
        {images.map((img, idx) => (
          <div class="overflow-hidden rounded shadow-md border border-slate-100 aspect-video relative group">
            <img 
              src={img} 
              alt={`${title} preview ${idx+1}`} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        ))}
      </div>
    </section>

    <!-- Main Grid Contents: Left details, Right cards -->
    <section class="bg-white py-16 px-6 md:px-12 lg:px-24">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Side: descriptions (8 columns) -->
        <div class="col-span-1 lg:col-span-8 text-left">
          
          <!-- Description text -->
          <div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal mb-10">
            <p>
              Situado en una ubicación privilegiada frente al mar, este distinguido módulo consta de tres suites en la planta baja, todas ellas con acceso directo a una exquisita piscina con cascada.
            </p>
            <p>
              Las Ocean Pool View Suites presentan un diseño amplio y abierto, como un loft, que incluye dos habitaciones y un baño. La habitación principal está equipada con una cama King, mientras que la segunda habitación ofrece dos cómodas camas matrimoniales, brindando un alojamiento confortable para los huéspedes.
            </p>
            <p class="font-semibold italic text-[#0f2e59]">
              ¡Reserva ahora y disfruta acceso directo a la piscina en nuestras Ocean Pool View Suites!
            </p>
          </div>

          <!-- Amenities & Services lists -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8 border-t border-slate-100">
            
            <!-- Amenities -->
            <div>
              <h4 class="text-md font-bold uppercase tracking-widest text-[#0f2e59] mb-4 flex items-center space-x-2">
                <!-- Bell icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-[#e60067]">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0M3.124 7.5A8.969 8.969 0 0 1 5.292 3m13.416 0a8.969 8.969 0 0 1 2.168 4.5" />
                </svg>
                <span>Amenities</span>
              </h4>
              <ul class="space-y-2 text-sm text-slate-500 font-medium">
                {amenities.map((item) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-[#e60067] font-bold shrink-0">&rsaquo;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Services -->
            <div>
              <h4 class="text-md font-bold uppercase tracking-widest text-[#0f2e59] mb-4 flex items-center space-x-2">
                <!-- Concierge icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-[#e60067]">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
                <span>Room Services</span>
              </h4>
              <ul class="space-y-2 text-sm text-slate-500 font-medium">
                {services.map((item) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-[#e60067] font-bold shrink-0">&rsaquo;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

          </div>

        </div>

        <!-- Right Side: Sidebar Cards (4 columns) -->
        <div class="col-span-1 lg:col-span-4 space-y-8 lg:sticky lg:top-24">
          
          <!-- Card 1: Por qué elegir Cariblue -->
          <div class="bg-white border border-slate-100 rounded shadow-xl overflow-hidden text-left">
            <div class="bg-[#1a4175] text-white px-6 py-4 font-bold text-sm uppercase tracking-wider">
              Por qué elegir Cariblue
            </div>
            <div class="p-6">
              <ul class="divide-y divide-slate-50 text-sm text-slate-600 font-medium">
                {reasons.map((rec) => (
                  <li class="py-3 flex items-center space-x-3 first:pt-0 last:pb-0">
                    <!-- Thumbs up dynamic representation -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-[#e60067] shrink-0">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span>{rec.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Card 2: Información y reservas -->
          <div class="bg-white border border-slate-100 rounded shadow-xl overflow-hidden text-left">
            <div class="bg-[#1a4175] text-white px-6 py-4 font-bold text-sm uppercase tracking-wider">
              Información y reservas
            </div>
            <div class="p-6 space-y-4 text-sm font-semibold text-slate-600">
              <div class="flex items-start space-x-3.5">
                <span class="text-slate-400 font-bold shrink-0">Tel:</span>
                <a href="tel:+50627500035" class="hover:text-[#e60067] transition-colors">506 2750 0035</a>
              </div>
              <div class="flex items-start space-x-3.5">
                <span class="text-slate-400 font-bold shrink-0">Whatsapp:</span>
                <a href="https://wa.me/50683141965" target="_blank" class="hover:text-green-500 transition-colors">+506 8314 1965</a>
              </div>
              <div class="flex items-start space-x-3.5">
                <span class="text-slate-400 font-bold shrink-0">Email:</span>
                <a href="mailto:reservations@cariblue.com" class="hover:text-[#e60067] transition-colors">reservations@cariblue.com</a>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Other Rooms Suggestion Section (replaces WordPress warning) -->
    <section class="bg-slate-50 py-24 px-6 md:px-12 lg:px-24 border-t border-slate-100">
      <div class="max-w-6xl mx-auto text-center">
        <div class="mb-14">
          <h2 class="text-3xl font-serif font-bold text-[#0f2e59] mb-1">Other rooms</h2>
          <p class="text-[10px] md:text-xs font-bold tracking-[0.25em] text-[#e60067] uppercase">
            YOU MAY ALSO LIKE OTHER ROOMS
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {otherRooms.map((room) => (
            <div class="bg-white rounded border border-slate-100 shadow-lg overflow-hidden flex flex-col text-left">
              <div class="h-50 overflow-hidden">
                <img 
                  src={room.image} 
                  alt={room.title} 
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="text-lg font-serif font-bold text-[#0f2e59] mb-2">{room.title}</h3>
                  <span class="inline-block text-[10px] font-bold text-[#e60067] uppercase tracking-wider mb-3">{room.specs}</span>
                  <p class="text-xs text-slate-500 leading-relaxed font-light mb-6">{room.description}</p>
                </div>
                <div>
                  <a href="/#habitaciones" class="text-xs font-bold text-[#0f2e59] hover:text-[#e60067] uppercase tracking-wider border-b border-[#0f2e59] pb-0.5 transition-colors">
                    Ver Habitación &rarr;
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
