---
import Layout from "../layouts/Layout.astro";
---

<Layout
	lang="es"
	title="Página no encontrada | Cariblue Beach & Jungle Resort"
	description="La página que buscas no está disponible. Regresa al inicio y continúa descubriendo Cariblue Beach & Jungle Resort."
	canonicalPath="/404"
	noindex={true}
>
	<main>
		<section class="error-page" aria-labelledby="error-title">
			<div class="error-page__background" aria-hidden="true">
				<img src="/actividades_header.webp" alt="" />
				<div class="error-page__veil"></div>
				<div class="error-page__light"></div>
			</div>

			<div class="error-page__rings" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</div>

			<div class="error-page__content">
				<div class="error-page__copy">
					<p class="error-page__eyebrow">
						<span></span>
						Error 404 · Ruta desconocida
					</p>

					<p class="error-page__number" aria-hidden="true">404</p>

					<h1 id="error-title">Te saliste del sendero.</h1>
					<p class="error-page__description">
						Parece que esta página se perdió entre la selva y el mar.
						El Caribe sigue muy cerca: volvamos a un lugar conocido.
					</p>

					<div class="error-page__actions">
						<a href="/" class="error-page__button error-page__button--primary">
							Volver al inicio
							<span aria-hidden="true">→</span>
						</a>
						<a href="/habitaciones" class="error-page__button error-page__button--secondary">
							Explorar habitaciones
						</a>
					</div>
				</div>

				<div class="error-page__compass" aria-hidden="true">
					<div class="error-page__compass-face">
						<span class="error-page__north">N</span>
						<span class="error-page__needle"></span>
						<span class="error-page__center"></span>
					</div>
					<p>El camino de vuelta</p>
					<span>9.6568° N · 82.7536° W</span>
				</div>
			</div>

			<div class="error-page__footer" aria-hidden="true">
				<span>Playa Cocles</span>
				<div></div>
				<span>Puerto Viejo, Costa Rica</span>
			</div>
		</section>
	</main>
</Layout>

<style>
	.error-page {
		position: relative;
		isolation: isolate;
		display: flex;
		min-height: 100svh;
		align-items: center;
		overflow: hidden;
		padding: 10rem 1.5rem 5.5rem;
		color: white;
		background: #071e24;
	}

	.error-page__background,
	.error-page__background img,
	.error-page__veil,
	.error-page__light {
		position: absolute;
		inset: 0;
	}

	.error-page__background {
		z-index: -3;
	}

	.error-page__background img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 58% center;
		animation: background-drift 18s ease-in-out infinite alternate;
	}

	.error-page__veil {
		z-index: 1;
		background:
			linear-gradient(90deg, rgba(4, 23, 28, 0.94) 0%, rgba(5, 28, 33, 0.82) 42%, rgba(7, 32, 35, 0.44) 72%, rgba(7, 25, 29, 0.7) 100%),
			linear-gradient(0deg, rgba(3, 18, 22, 0.84) 0%, transparent 42%, rgba(6, 22, 27, 0.28) 100%);
	}

	.error-page__light {
		z-index: 2;
		background: radial-gradient(circle at 72% 44%, rgba(235, 255, 210, 0.18), transparent 25%);
		mix-blend-mode: screen;
	}

	.error-page__content {
		display: grid;
		grid-template-columns: minmax(0, 720px) 210px;
		gap: clamp(3rem, 8vw, 8rem);
		align-items: center;
		width: min(100%, 76rem);
		margin: 0 auto;
	}

	.error-page__copy {
		animation: content-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.error-page__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1.15rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.72);
	}

	.error-page__eyebrow span {
		display: inline-block;
		width: 2.5rem;
		height: 2px;
		background: #e60067;
	}

	.error-page__number {
		margin: 0 0 -0.55rem;
		font-family: var(--font-serif);
		font-size: clamp(7rem, 18vw, 13rem);
		font-weight: 600;
		font-style: italic;
		line-height: 0.75;
		letter-spacing: -0.08em;
		color: rgba(255, 255, 255, 0.98);
		text-shadow: 0 18px 60px rgba(0, 0, 0, 0.32);
	}

	.error-page h1 {
		margin: 0;
		font-size: clamp(2.35rem, 5vw, 4.6rem);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.035em;
		color: white;
		text-wrap: balance;
	}

	.error-page__description {
		max-width: 39rem;
		margin: 1.5rem 0 0;
		font-size: clamp(0.9rem, 1.4vw, 1.05rem);
		font-weight: 400;
		line-height: 1.8;
		color: rgba(255, 255, 255, 0.74);
		text-wrap: pretty;
	}

	.error-page__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2.25rem;
	}

	.error-page__button {
		display: inline-flex;
		min-height: 3.35rem;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 0.95rem 1.6rem;
		border: 1px solid transparent;
		border-radius: 0.2rem;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		transition: transform 200ms ease, background-color 200ms ease, border-color 200ms ease;
	}

	.error-page__button:hover {
		transform: translateY(-2px);
	}

	.error-page__button:focus-visible {
		outline: 2px solid white;
		outline-offset: 4px;
	}

	.error-page__button--primary {
		background: #e60067;
		box-shadow: 0 14px 38px rgba(230, 0, 103, 0.28);
	}

	.error-page__button--primary:hover {
		background: #c90059;
	}

	.error-page__button--primary span {
		font-size: 1rem;
		transition: transform 200ms ease;
	}

	.error-page__button--primary:hover span {
		transform: translateX(4px);
	}

	.error-page__button--secondary {
		border-color: rgba(255, 255, 255, 0.34);
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(10px);
	}

	.error-page__button--secondary:hover {
		border-color: rgba(255, 255, 255, 0.65);
		background: rgba(255, 255, 255, 0.15);
	}

	.error-page__compass {
		justify-self: end;
		width: 12rem;
		padding: 1.25rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px 999px 0.6rem 0.6rem;
		text-align: center;
		background: rgba(9, 34, 38, 0.34);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
		backdrop-filter: blur(14px);
		animation: content-rise 0.9s 0.15s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.error-page__compass-face {
		position: relative;
		width: 8.5rem;
		aspect-ratio: 1;
		margin: 0 auto 1.4rem;
		border: 1px solid rgba(255, 255, 255, 0.35);
		border-radius: 50%;
		background:
			linear-gradient(rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.2)) center / 1px 100% no-repeat,
			linear-gradient(90deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.2)) center / 100% 1px no-repeat;
	}

	.error-page__compass-face::before,
	.error-page__compass-face::after {
		position: absolute;
		inset: 0.65rem;
		border: 1px dashed rgba(255, 255, 255, 0.14);
		border-radius: 50%;
		content: "";
	}

	.error-page__compass-face::after {
		inset: 1.15rem;
		border-style: solid;
		border-color: rgba(255, 255, 255, 0.08);
	}

	.error-page__north {
		position: absolute;
		top: 0.6rem;
		left: 50%;
		font-size: 0.55rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		transform: translateX(-50%);
	}

	.error-page__needle {
		position: absolute;
		top: 2.05rem;
		left: 50%;
		z-index: 2;
		width: 0;
		height: 0;
		border-right: 0.4rem solid transparent;
		border-bottom: 2.2rem solid #e60067;
		border-left: 0.4rem solid transparent;
		transform: translateX(-50%) rotate(25deg);
		transform-origin: 50% 100%;
		animation: needle-search 5s ease-in-out infinite;
	}

	.error-page__center {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 3;
		width: 0.65rem;
		height: 0.65rem;
		border: 2px solid white;
		border-radius: 50%;
		background: #e60067;
		transform: translate(-50%, -50%);
	}

	.error-page__compass p {
		margin: 0 0 0.35rem;
		font-family: var(--font-serif);
		font-size: 1rem;
		font-style: italic;
		color: white;
	}

	.error-page__compass > span {
		font-size: 0.48rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		color: rgba(255, 255, 255, 0.48);
	}

	.error-page__rings {
		position: absolute;
		right: 4%;
		bottom: -24rem;
		z-index: -1;
		width: 48rem;
		aspect-ratio: 1;
		pointer-events: none;
	}

	.error-page__rings span {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 50%;
		animation: water-ring 6s ease-out infinite;
	}

	.error-page__rings span:nth-child(2) {
		animation-delay: 2s;
	}

	.error-page__rings span:nth-child(3) {
		animation-delay: 4s;
	}

	.error-page__footer {
		position: absolute;
		bottom: 1.75rem;
		left: 50%;
		display: flex;
		align-items: center;
		gap: 1rem;
		width: min(calc(100% - 3rem), 76rem);
		font-size: 0.52rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.46);
		transform: translateX(-50%);
	}

	.error-page__footer div {
		flex: 1;
		height: 1px;
		background: rgba(255, 255, 255, 0.16);
	}

	@keyframes content-rise {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes background-drift {
		from { transform: scale(1.02); }
		to { transform: scale(1.08); }
	}

	@keyframes needle-search {
		0%, 100% { transform: translateX(-50%) rotate(25deg); }
		50% { transform: translateX(-50%) rotate(39deg); }
	}

	@keyframes water-ring {
		0% {
			opacity: 0;
			transform: scale(0.35);
		}
		25% { opacity: 0.55; }
		100% {
			opacity: 0;
			transform: scale(1);
		}
	}

	@media (max-width: 800px) {
		.error-page {
			min-height: 54rem;
			padding-top: 9rem;
		}

		.error-page__content {
			display: block;
		}

		.error-page__compass {
			display: none;
		}

		.error-page__background img {
			object-position: 66% center;
		}

		.error-page__veil {
			background: linear-gradient(90deg, rgba(4, 23, 28, 0.94), rgba(5, 28, 33, 0.65)),
				linear-gradient(0deg, rgba(3, 18, 22, 0.9), transparent 55%);
		}
	}

	@media (max-width: 520px) {
		.error-page {
			align-items: flex-start;
			min-height: 50rem;
			padding-right: 1.25rem;
			padding-left: 1.25rem;
		}

		.error-page__number {
			margin-bottom: 0;
			font-size: clamp(6.5rem, 38vw, 9rem);
		}

		.error-page__actions {
			flex-direction: column;
		}

		.error-page__button {
			width: 100%;
		}

		.error-page__footer {
			bottom: 1.3rem;
			width: calc(100% - 2.5rem);
		}

		.error-page__footer div {
			display: none;
		}

		.error-page__footer span:last-child {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.error-page__background img,
		.error-page__copy,
		.error-page__compass,
		.error-page__needle,
		.error-page__rings span {
			animation: none;
		}
	}
</style>
