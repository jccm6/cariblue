---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const stats = [
  {
    title: "Beachfront",
    text: "Mesas en la playa y vista al mar",
    icon: `<!-- Palm Tree icon -->
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-[#e60067]">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M12 3c-1.5 1.5-3.5 2.5-6 2.5m6-2.5c2.5 0 4.5 1 6 2.5M12 10.5c-2 1-4.5 1.5-7 1.5m7-1.5c2.5 0 5 .5 7 1.5M12 17.5C10 18.5 7.5 19 5 19m7 0c2.5 0 5-.5 7-1.5" />
      </svg>`
  },
  {
    title: "Horario de atención",
    text: "Lunes a domingo de 11:00 a 21:00 hrs.",
    icon: `<!-- Clock icon -->
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-[#e60067]">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>`
  },
  {
    title: "Happy hour",
    text: "Todos los días de 16:00 a 17:00 hrs",
    icon: `<!-- Tropical Drink icon -->
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-[#e60067]">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>`
  }
];

const galleryDishes = [
  { id: 1, img: "https://images.unsplash.com/photo-1579871494447-9811cf80d66c?auto=format&fit=crop&w=400&q=80", title: "Dragon Roll Premium" },
  { id: 2, img: "https://images.unsplash.com/photo-1611143669185-af224c5e3252?auto=format&fit=crop&w=400&q=80", title: "Sashimi de Salmón y Atún" },
  { id: 3, img: "https://images.unsplash.com/photo-1553621042-f6e147245754?auto=format&fit=crop&w=400&q=80", title: "Nigiris Variados de la Casa" },
  { id: 4, img: "https://images.unsplash.com/photo-1617196034796-73dfa7b1fd56?auto=format&fit=crop&w=400&q=80", title: "California Roll con Sésamo" },
  { id: 5, img: "https://images.unsplash.com/photo-1534482421-64566f976cfa?auto=format&fit=crop&w=400&q=80", title: "Fusión Nikkei Ceviche Roll" },
  { id: 6, img: "https://images.unsplash.com/photo-1583623025817-d180a2221d0a?auto=format&fit=crop&w=400&q=80", title: "Cócteles de Autor frente al Mar" }
];
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Sushi Wave | Cocles Beach Beachfront Restaurant</title>
		<meta name="description" content="Descubre Sushi Wave frente a la playa Cocles. Fusión gourmet japonesa y peruana con el auténtico sabor Nikkei y cócteles de autor en Costa Rica." />
	</head>
	<body class="bg-white text-slate-800 antialiased overflow-x-hidden selection:bg-[#e60067] selection:text-white">
		<Header />

		<main>
			<!-- Hero Banner -->
			<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
				<div class="absolute inset-0 z-0">
					<div class="absolute inset-0 bg-[#05152b]/55 z-10"></div>
					<img 
						src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=80" 
						alt="Sunset Beach dinner beachfront" 
						class="w-full h-full object-cover"
					/>
				</div>
				<div class="relative z-20 max-w-4xl mx-auto mt-8">
					<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
						Sushi Wave
					</h1>
				</div>
			</section>

			<!-- Welcome Section & Video Grid -->
			<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
				<div class="max-w-7xl mx-auto">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
						
						<!-- Left Side: Welcome texts -->
						<div class="col-span-1 lg:col-span-7 text-left">
							<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6 leading-tight">
								Bienvenidos a Sushi Wave
							</h2>
							
							<div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal">
								<p>
									El oasis gastronómico donde se fusionan las tradiciones culinarias japonesas y peruanas frente a las olas del mar! Sumérgete en una experiencia culinaria única, donde cada bocado es una obra maestra que despierta tus sentidos y te transporta a un mundo de sabores exquisitos.
								</p>
								<p>
									En nuestro vibrante restaurante, te invitamos a descubrir el auténtico arte del sushi y la cocina Nikkei en cada rincón. Desde el relajado Rancho hasta el vibrante Spot de Playa y los acogedores mesones compartidos, cada espacio tiene su encanto único, ofreciéndote una atmósfera inigualable mientras disfrutas de la vista panorámica al océano.
								</p>
								<p>
									Nuestra propuesta culinaria va más allá del delicioso sushi; es una fusión perfecta entre frescura y creatividad que se refleja en cada plato. Deléitate con nuestras irresistibles creaciones, ofreciéndote una experiencia gastronómica memorable.
								</p>
							</div>
						</div>

						<!-- Right Side: Video Thumbnail Widget -->
						<div class="col-span-1 lg:col-span-5">
							<div class="overflow-hidden rounded-lg shadow-2xl relative border border-slate-100 group aspect-video cursor-pointer" id="youtube-play-trigger">
								<!-- Video Cover Image -->
								<img 
									src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80" 
									alt="Cariblue Caribe Costa Rica Video Preview" 
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
								/>
								<div class="absolute inset-0 bg-black/35 group-hover:bg-black/45 transition-colors flex items-center justify-center">
									<!-- Big Red Youtube Play Button -->
									<div class="w-16 h-11 bg-[#FF0000] rounded-lg flex items-center justify-center text-white shadow-xl group-hover:scale-110 transition-transform duration-300">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
											<path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
										</svg>
									</div>
								</div>
								<div class="absolute bottom-3 left-4 text-xs font-semibold text-white drop-shadow">
									Cariblue - Caribe Costa Rica
								</div>
								<div class="absolute bottom-3 right-4 text-[10px] text-white/80 drop-shadow">
									Mirar en <span class="font-bold">YouTube</span>
								</div>
							</div>
						</div>

					</div>
				</div>
			</section>

			<!-- Alternating Block: Sushi roll picture on Left, Copy on Right -->
			<section class="bg-slate-50/50 py-16 px-6 md:px-12 lg:px-24 border-y border-slate-100">
				<div class="max-w-7xl mx-auto">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
						
						<!-- Left Side: Horizontal Gourmet Sushi Roll Image -->
						<div class="col-span-1 lg:col-span-6">
							<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-video relative group">
								<img 
									src="https://images.unsplash.com/photo-1611143669185-af224c5e3252?auto=format&fit=crop&w=1000&q=80" 
									alt="Gourmet Sushi Roll plate with ocean view" 
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								/>
							</div>
						</div>

						<!-- Right Side: Copy -->
						<div class="col-span-1 lg:col-span-6 text-left">
							<p class="text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal">
								Pero no solo nos destacamos por nuestros exquisitos platos, sino también por nuestros innovadores cócteles. En Sushi Wave, la sofisticación se encuentra en cada sorbo. Sumérgete en un mundo de sabores exquisitos, donde cada trago es una experiencia única que complementa a la perfección la excelencia de nuestros platillos.
							</p>
							<p class="text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal mt-4">
								Únete a nosotros y descubre el auténtico arte del sushi y la cocina Nikkei en cada bocado. En Sushi Wave, la frescura, la creatividad y la excelencia se fusionan para brindarte una experiencia culinaria inolvidable. ¡Te invitamos a ser parte del viaje de los sentidos, donde la pasión por la gastronomía se encuentra con la belleza del mar!
							</p>
						</div>

					</div>
				</div>
			</section>

			<!-- Menu Online CTA Button section -->
			<section class="bg-white py-12 text-center">
				<a 
					href="#" 
					class="inline-block bg-[#e60067] hover:bg-[#c20056] text-white font-extrabold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg transition-all duration-300"
				>
					Menú Online
				</a>
			</section>

			<!-- 3 Columns details grid (Beachfront, Schedule, Happy hour) -->
			<section class="bg-white pb-16 px-6 md:px-12 lg:px-24">
				<div class="max-w-5xl mx-auto border-t border-slate-100 pt-16">
					<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
						{stats.map((stat) => (
							<div class="flex flex-col items-center">
								<div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center mb-4 border border-slate-100">
									<Fragment set:html={stat.icon} />
								</div>
								<h3 class="text-sm font-bold text-[#0f2e59] uppercase tracking-wider mb-2">{stat.title}</h3>
								<p class="text-xs text-slate-500 font-light leading-relaxed max-w-xs">{stat.text}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Food Photo Grid Gallery -->
			<section class="bg-slate-50/50 py-24 px-6 md:px-12 lg:px-24 border-t border-slate-100">
				<div class="max-w-7xl mx-auto text-center">
					<div class="mb-12">
						<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-3">Nuestra Cocina Nikkei</h2>
						<p class="text-[10px] md:text-xs font-bold tracking-[0.25em] text-[#e60067] uppercase">
							SABOR JAPONÉS-PERUANO DE CARA AL MAR CARIBE
						</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
						{galleryDishes.map((dish) => (
							<div class="overflow-hidden rounded shadow-lg border border-slate-100 relative group aspect-square bg-white">
								<img 
									src={dish.img} 
									alt={dish.title} 
									class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
								/>
								<div class="absolute inset-0 bg-[#0f2e59]/85 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-4">
									<h4 class="text-white font-serif font-bold text-lg md:text-xl mb-2">{dish.title}</h4>
									<span class="text-[#e60067] font-semibold uppercase tracking-wider text-[10px]">Sushi Wave Restaurant</span>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Youtube Play Modal -->
			<div id="video-modal-yt" class="fixed inset-0 bg-black/95 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
				<button id="close-modal-yt" class="absolute top-6 right-6 text-white hover:text-[#e60067] transition-colors focus:outline-none" aria-label="Close Video">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
					</svg>
				</button>
				<div class="w-full max-w-4xl aspect-video rounded-lg overflow-hidden shadow-2xl bg-black">
					<iframe 
						id="modal-iframe-yt"
						class="w-full h-full" 
						src="" 
						title="Cariblue Sushi Wave Video" 
						frameborder="0" 
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
						allowfullscreen
					></iframe>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<script>
	const trigger = document.getElementById('youtube-play-trigger');
	const modal = document.getElementById('video-modal-yt');
	const closeModal = document.getElementById('close-modal-yt');
	const iframe = document.getElementById('modal-iframe-yt') as HTMLIFrameElement;

	const youtubeUrl = "https://www.youtube.com/embed/l59Z_Z59gYw?autoplay=1"; // Great travel video

	if (trigger && modal && closeModal && iframe) {
		trigger.addEventListener('click', () => {
			iframe.src = youtubeUrl;
			modal.classList.remove('opacity-0', 'pointer-events-none');
		});

		const hideModal = () => {
			modal.classList.add('opacity-0', 'pointer-events-none');
			iframe.src = "";
		};

		closeModal.addEventListener('click', hideModal);
		modal.addEventListener('click', (e) => {
			if (e.target === modal) {
				hideModal();
			}
		});
	}
</script>
