---
import Layout from "../layouts/Layout.astro";

const menuUrl = "https://cariblue.kivly.store/menu/6a049c88bccc7a670c0df3c8?tab=carta";
const whatsappUrl = "https://wa.me/50683141965";
const directionsUrl = "https://maps.app.goo.gl/NwJjTVxUU8TakKxr6";

const valueFeatures = [
	{
		title: "Cocina Nikkei",
		text: "Fusión japonesa–peruana en cada plato.",
	},
	{
		title: "Frescura y sabor",
		text: "Ingredientes frescos y sabores intensos.",
	},
	{
		title: "Frente a la playa",
		text: "Un espacio abierto, relajado y frente al mar.",
	},
];

const menuCategories = [
	"Sushi rolls y nigiris",
	"Ceviches y tiraditos",
	"Opciones calientes y bowls",
	"Cócteles de autor",
];

const keyInfo = [
	{
		title: "Beachfront",
		text: "Mesas en la playa y vista al mar",
		icon: "https://i.imgur.com/N6NmSHp.png",
	},
	{
		title: "Horario de atención",
		text: "Lunes a domingo de 11:00 a.m. a 9:00 p.m.",
		icon: "https://i.imgur.com/s89vBk2.png",
	},
	{
		title: "Happy Hour",
		text: "Todos los días de 4:00 p.m. a 5:00 p.m.",
		icon: "https://i.imgur.com/89Lxb5P.png",
	},
	{
		title: "DJ y fogata en la playa",
		text: "Martes, jueves, viernes y sábado: 4:30 p.m. a 7:30 p.m.",
		icon: null,
	},
];

const socialLinks = [
	{ label: "Facebook", href: "https://www.facebook.com/caribluehotel" },
	{ label: "Instagram", href: "https://www.instagram.com/caribluehotel/" },
	{ label: "TikTok", href: "https://www.tiktok.com/@caribluehotelcr" },
];
---

<Layout
	title="Sushi Wave | Sushi Nikkei frente al mar en Playa Cocles"
	description="Descubre Sushi Wave frente a la playa Cocles: fusión japonesa–peruana, ingredientes frescos, cócteles de autor y una experiencia relajada junto al océano."
>
	<main>
		<section class="relative min-h-[52vh] md:min-h-[62vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 z-10 bg-linear-to-b from-black/20 via-black/25 to-black/55"></div>
				<img src="https://i.imgur.com/CuhZrvU.jpeg" alt="Cena frente a la playa en Sushi Wave" class="h-full w-full object-cover" />
			</div>
			<div class="relative z-20 max-w-5xl mx-auto mt-8 flex flex-col items-center">
				<p class="text-[11px] md:text-xs font-black tracking-[0.35em] uppercase text-white/80">Sushi Nikkei frente al mar</p>
				<h1 class="mt-4 text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Sushi Wave</h1>
				<p class="mt-5 max-w-3xl text-sm md:text-lg font-medium leading-relaxed text-white/95">Fusión japonesa–peruana en un entorno único frente a la playa. Frescura, sabor y una experiencia relajada junto al océano.</p>
				<div class="mt-8 flex flex-col sm:flex-row gap-4">
					<a href={menuUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300">Ver menú</a>
					<a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center border border-white/40 bg-white/10 text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded backdrop-blur transition-all duration-300">Reservar mesa</a>
				</div>
			</div>
		</section>

		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-6">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Propuesta de valor</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight">Mucho más que sushi</h2>
					<p class="mt-6 text-base md:text-lg text-slate-700 leading-relaxed">Sushi Wave combina técnica, frescura y creatividad en un ambiente frente al mar.</p>
					<div class="mt-8 flex flex-col sm:flex-row gap-4">
						<a href={menuUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300">Ver menú</a>
						<a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center border border-slate-200 bg-white text-[#0f2e59] font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded transition-all duration-300">Reservar mesa</a>
					</div>
				</div>
				<div class="lg:col-span-6">
					<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-5/4 relative group">
						<img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80" alt="Plato fresco servido en Sushi Wave" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
				</div>
			</div>

			<div class="max-w-7xl mx-auto mt-16">
				<div class="flex items-center gap-4 mb-8">
					<div class="h-px flex-1 bg-slate-200"></div>
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-[#0f2e59]">La propuesta Sushi Wave</p>
					<div class="h-px flex-1 bg-slate-200"></div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
					{valueFeatures.map((item, index) => (
						<div class="rounded bg-[#0f2e59] px-6 py-7 text-white shadow-lg">
							<div class="flex items-center justify-center w-12 h-12 rounded-full bg-white/12 border border-white/15 mb-5 text-lg font-bold">{index + 1}</div>
							<h3 class="text-base font-bold tracking-wide mb-3">{item.title}</h3>
							<p class="text-sm text-white/78 leading-relaxed">{item.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-[#f6efe4] py-20 px-6 md:px-12 lg:px-24 border-y border-[#eadbc7]">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-5 order-2 lg:order-1">
					<div class="overflow-hidden rounded shadow-2xl border border-white/50 aspect-4/5 relative group">
						<img src="/sushi_wave.webp" alt="Sushi Wave frente al mar" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
				</div>
				<div class="lg:col-span-7 order-1 lg:order-2">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Menú</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight">Una carta fresca y versátil</h2>
					<p class="mt-6 text-sm md:text-[15px] text-slate-700 leading-relaxed">Opciones ligeras, sabores intensos y combinaciones pensadas para compartir.</p>
					<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
						{menuCategories.map((category, index) => (
							<div class="rounded bg-white/80 backdrop-blur px-5 py-5 border border-[#eadbc7] shadow-sm">
								<div class="flex items-center gap-3">
									<div class="flex items-center justify-center w-9 h-9 rounded-full bg-accent/10 text-accent text-sm font-bold">{index + 1}</div>
									<h3 class="text-sm font-bold text-[#0f2e59]">{category}</h3>
								</div>
							</div>
						))}
					</div>
					<a href={menuUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center justify-center bg-[#0f2e59] text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300">Ver menú</a>
				</div>
			</div>

			<div class="max-w-7xl mx-auto mt-16">
				<div class="flex items-center gap-4 mb-8">
					<div class="h-px flex-1 bg-[#eadbc7]"></div>
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-[#0f2e59]">Info clave</p>
					<div class="h-px flex-1 bg-[#eadbc7]"></div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
					{keyInfo.map((item, index) => (
						<div class="rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
							<div class="w-16 h-16 rounded-full bg-white flex items-center justify-center mb-5 border border-[#eadbc7] text-accent font-bold text-sm">
								{item.icon ? <img src={item.icon} alt="" class="max-h-10 max-w-10" /> : <span>DJ</span>}
							</div>
							<h3 class="text-base font-bold text-[#0f2e59] mb-2">{item.title}</h3>
							<p class="text-sm text-slate-600 leading-relaxed">{item.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-white py-20 px-6 text-center border-t border-slate-100">
			<div class="max-w-4xl mx-auto">
				<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Sushi Wave</p>
				<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6 leading-tight">Ven por el sushi, quédate por la experiencia</h2>
				<p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">Abierto a huéspedes y visitantes. Siempre hay una mesa esperándote frente al mar.</p>
				<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
					<a href={menuUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300">Ver menú</a>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center border border-slate-200 bg-white text-[#0f2e59] font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded transition-all duration-300">Cómo llegar</a>
				</div>
				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					{socialLinks.map((social) => (
						<a href={social.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center border border-[#0f2e59]/15 bg-white text-[#0f2e59] font-bold text-[11px] tracking-[0.16em] uppercase px-5 py-3 rounded transition-all duration-300">{social.label}</a>
					))}
				</div>
			</div>
		</section>
	</main>
</Layout>
