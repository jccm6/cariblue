---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const events = [
  {
    title: "Cumpleaños",
    text: "¡Celebra tu cumpleaños en grande en nuestro hotel junto a tus amigos y familiares! Puedes disfrutar de una celebración única mientras utilizas todas las instalaciones de nuestro hotel. Ya sea disfrutando de la piscina, restaurantes y bares. Tenemos todo lo que necesitas para hacer de tu cumpleaños una experiencia especial.",
    btnText: "Organizar Mi Cumple",
    image: "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=800&q=80",
    alt: "Celebrating birthday party with a cake"
  },
  {
    title: "Bodas",
    text: "¡Celebren su amor con una vista inolvidable en frente al mar! Con el sonido relajante de las olas y el paisaje espectacular como telón de fondo, su boda será un momento mágico y romántico que recordarán para siempre. ¡Déjennos hacer de su día especial un sueño hecho realidad.",
    btnText: "Planear Mi Boda",
    image: "https://images.unsplash.com/photo-1519225495810-7512c696505a?auto=format&fit=crop&w=800&q=80",
    alt: "Beachfront wedding ceremony with guests"
  },
  {
    title: "Fiestas de Empresas",
    text: "Celebra el éxito de tu empresa con tu personal en un entorno único. Ofrecemos espacios versátiles y bien equipados para eventos corporativos, desde cenas hasta fiestas de fin de año. Disfruta de un servicio excepcional y un ambiente acogedor y exclusivo que hará de tu evento un éxito memorable.",
    btnText: "Planificar Evento",
    image: "https://images.unsplash.com/photo-1519671482749-fd09be7ccebf?auto=format&fit=crop&w=800&q=80",
    alt: "Toasting champagne flutes at a business corporate event"
  },
  {
    title: "Capacitaciones",
    text: "Organiza tus sesiones de capacitación en un entorno que inspira y motiva. Con nuestras instalaciones confortables, podrás ofrecer formación de calidad en un ambiente relajante y libre de distracciones. Aprovecha nuestro servicio de restaurante para garantizar una experiencia productiva y agradable.",
    btnText: "Agendar Capacitación",
    image: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=800&q=80",
    alt: "Corporate training presentation around a table"
  },
  {
    title: "Cenas de Graduación",
    text: "Festeja el logro de tus graduados en un lugar especial con una celebración a la altura. Ofrecemos espacios adaptables para cenas de graduación, con un servicio atento y opciones gastronómicas que harán de esta ocasión un recuerdo inolvidable. Nuestro equipo se encargará de cada detalle, desde el menú hasta la decoración, para que puedas enfocarte en disfrutar el momento con familiares y amigos.",
    btnText: "Celebrar Graduación",
    image: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=800&q=80",
    alt: "Elegant dining room table setup for graduation dinner"
  }
];
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Eventos Exclusivos y Bodas | Cariblue Resort Costa Rica</title>
		<meta name="description" content="Celebra cumpleaños, bodas frente al mar, fiestas corporativas, capacitaciones y cenas de graduación en el paradisíaco entorno de Cariblue Resort." />
	</head>
	<body class="bg-white text-slate-800 antialiased overflow-x-hidden selection:bg-[#e60067] selection:text-white">
		<Header />

		<main>
			<!-- Hero Banner -->
			<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
				<div class="absolute inset-0 z-0">
					<div class="absolute inset-0 bg-[#05152b]/55 z-10"></div>
					<img 
						src="https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=2000&q=80" 
						alt="Aerial beachfront island background" 
						class="w-full h-full object-cover"
					/>
				</div>
				<div class="relative z-20 max-w-4xl mx-auto mt-8">
					<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
						Eventos
					</h1>
				</div>
			</section>

			<!-- Intro Section -->
			<section class="bg-white py-16 px-6 md:px-12 lg:px-24 border-b border-slate-100">
				<div class="max-w-4xl mx-auto text-center flex flex-col items-center">
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6">
						Eventos Exclusivos
					</h2>
					<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-light max-w-3xl">
						¡Vive momentos inolvidables en el paraíso del Caribe Sur, con nuestros eventos exclusivos! Desde bodas de ensueño hasta celebraciones de cumpleaños espectaculares, te invitamos a descubrir la magia de celebrar en nuestro impresionante entorno tropical y paisajes paradisiacos. Contamos con un equipo dedicado a hacer realidad tus sueños, cada evento en nuestro hotel es una experiencia única e inolvidable. ¡Deja que nosotros nos encarguemos de cada detalle para que tú y tus seres queridos puedan disfrutar al máximo!
					</p>
				</div>
			</section>

			<!-- 5 Events Stacked Rows (Left Text, Right Image) -->
			<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
				<div class="max-w-5xl mx-auto space-y-16 lg:space-y-24">
					{events.map((evt) => (
						<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16 last:border-0 last:pb-0">
							
							<!-- Text details (7 columns on desktop) -->
							<div class="col-span-1 md:col-span-6 text-left">
								<h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">
									{evt.title}
								</h3>
								<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal mb-6">
									{evt.text}
								</p>
								<a 
									href="https://wa.me/50683141965" 
									target="_blank"
									class="inline-block bg-[#e60067] hover:bg-[#c20056] text-white font-extrabold text-[10px] tracking-widest uppercase px-6 py-3 rounded-xs shadow-md transition-colors"
								>
									{evt.btnText}
								</a>
							</div>

							<!-- Image (5 columns on desktop) -->
							<div class="col-span-1 md:col-span-6">
								<div class="overflow-hidden rounded shadow-xl border border-slate-100 relative group aspect-video">
									<img 
										src={evt.image} 
										alt={evt.alt} 
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									/>
								</div>
							</div>

						</div>
					))}
				</div>
			</section>

			<!-- Call To Action Section -->
			<section class="bg-slate-50/50 py-20 px-6 text-center border-t border-slate-100">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-8 leading-tight">
						No esperes más para organizar tu evento
					</h2>
					<a 
						href="https://wa.me/50683141965" 
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block bg-[#e60067] hover:bg-[#c20056] text-white font-bold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg hover:shadow-pink-600/30 transition-all duration-300"
					>
						Contáctanos
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
