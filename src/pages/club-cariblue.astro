<script>
	const dialog = document.querySelector<HTMLDialogElement>("#join-dialog")!;

	document.querySelectorAll<HTMLAnchorElement>(".join").forEach((link) => {
		link.addEventListener("click", (event) => {
			if (typeof dialog.showModal === "function") {
				event.preventDefault();
				dialog.showModal();
			}
		});
	});

	dialog.querySelector<HTMLButtonElement>(".close")!.addEventListener("click", () => dialog.close());
	dialog.addEventListener("click", (event) => {
		if (event.target === dialog) {
			const bounds = dialog.getBoundingClientRect();
			if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
				dialog.close();
			}
		}
	});
</script>
