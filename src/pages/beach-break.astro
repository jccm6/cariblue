---
import Layout from "../layouts/Layout.astro";

const highlights = [
	"Pantallas en salón para vivir cada partido",
	"Mesas en la playa con ambiente relajado",
	"Comida de alta calidad y cócteles refrescantes",
	"El equilibrio perfecto entre energía y chill caribeño",
];

const menuCategories = [
	"Hamburguesas y clásicos del sport bar",
	"Bowls y ensaladas frescas",
	"Especiales de la casa",
	"Tacos",
	"Alitas",
	"Aperitivos",
	"Postres",
	"Coctelería y bar",
];

const keyInfo = [
	{
		title: "Beachfront",
		text: "Mesas en la playa y salón con pantallas",
		icon: "https://i.imgur.com/N6NmSHp.png",
	},
	{
		title: "Horario de atención",
		text: "Lunes a domingo de 11:00 a.m. a 9:00 p.m.",
		icon: "https://i.imgur.com/s89vBk2.png",
	},
	{
		title: "Happy Hour",
		text: "Todos los días de 4:00 p.m. a 7:00 p.m.",
		icon: "https://i.imgur.com/89Lxb5P.png",
	},
];

const activationItems = ["DJ en vivo: martes, jueves, viernes y sábado", "Horario: 5:30 p.m. a 8:30 p.m.", "Fogata en la playa al atardecer"];
---

<Layout
	title="Beach Break | Sport bar frente al mar en Playa Cocles"
	description="Descubre Beach Break en Cariblue Resort: deportes, buena comida y cócteles frente a la playa con ambiente relajado y energía caribeña."
>
	<main>
		<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 z-10 bg-black/20"></div>
				<img src="/vista_al_mar.webp" alt="Vista frente al mar en Beach Break" class="h-full w-full object-cover" />
			</div>
			<div class="relative z-20 max-w-4xl mx-auto mt-8">
				<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Beach Break</h1>
				<p class="mt-4 text-sm md:text-lg font-medium tracking-[0.2em] uppercase text-white/90">Sport bar frente al mar</p>
			</div>
		</section>

		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-6">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Valor</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight mb-6">Mucho más que un sport bar</h2>
					<p class="text-sm md:text-[15px] text-slate-600 leading-relaxed">Deportes, buena comida y cócteles frente a la playa.</p>
					<p class="mt-4 text-sm md:text-[15px] text-slate-600 leading-relaxed">Beach Break combina la emoción del deporte con una experiencia relajada frente al mar.</p>
					<ul class="mt-8 space-y-4">
						{
							highlights.map((item) => (
								<li class="flex items-start gap-3 text-sm md:text-[15px] text-slate-700 leading-relaxed">
									<span class="mt-1 h-2.5 w-2.5 rounded-full bg-accent shrink-0" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<div class="mt-8 flex flex-col sm:flex-row gap-4">
						<a
							href="https://oddmenu.com/es/p/beach-break"
							target="_blank"
							class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
						>
							Ver menú
						</a>
						<a
							href="https://wa.me/message/75TXOCRHFENEO1"
							target="_blank"
							class="inline-flex items-center justify-center border border-slate-200 bg-white text-[#0f2e59] font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded transition-all duration-300"
						>
							Reservar mesa (WhatsApp)
						</a>
					</div>
				</div>
				<div class="lg:col-span-6">
					<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-4/3 relative group">
						<img src="/coctel.webp" alt="Cócteles y ambiente relajado en Beach Break" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
				</div>
			</div>
		</section>

		<section class="bg-slate-50/60 py-20 px-6 md:px-12 lg:px-24 border-y border-slate-100">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-5">
					<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-4/5 relative group">
						<img
							src="/restaurante_la_jungla.webp"
							alt="Comida para compartir en Beach Break"
							class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
				</div>
				<div class="lg:col-span-7">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Menú</p>
					<p class="text-sm md:text-[15px] text-slate-600 leading-relaxed">Una carta pensada para compartir, disfrutar y acompañar cualquier momento del día.</p>
					<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
						{menuCategories.map((item) => <div class="rounded border border-slate-200 bg-white px-5 py-4 text-sm md:text-[15px] text-[#0f2e59] font-semibold">{item}</div>)}
					</div>
					<p class="mt-8 text-sm md:text-[15px] text-slate-600 leading-relaxed">Perfecto para ver el partido, compartir con amigos o disfrutar un atardecer frente al mar.</p>
				</div>
			</div>
		</section>

		<section class="bg-white py-16 px-6 md:px-12 lg:px-24">
			<div class="max-w-5xl mx-auto border-t border-slate-100 pt-16">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
					{
						keyInfo.map((item) => (
							<div class="flex flex-col items-center">
								<div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center mb-4 border border-slate-100">
									<img src={item.icon} alt={item.title} />
								</div>
								<h3 class="text-sm font-bold text-[#0f2e59] uppercase tracking-wider mb-2">{item.title}</h3>
								<p class="text-xs text-slate-500 font-light leading-relaxed max-w-xs">{item.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="bg-[#0f2e59] py-20 px-6 md:px-12 lg:px-24 text-white">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-7">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Activación</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold leading-tight mb-6">Atardeceres con energía</h2>
					<p class="text-sm md:text-[15px] text-white/80 leading-relaxed">La mejor combinación entre deporte, música y playa.</p>
					<ul class="mt-8 space-y-4">
						{
							activationItems.map((item) => (
								<li class="flex items-start gap-3 text-sm md:text-[15px] text-white/90 leading-relaxed">
									<span class="mt-1 h-2.5 w-2.5 rounded-full bg-accent shrink-0" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<p class="mt-8 text-lg md:text-xl font-medium text-white">Ven por el juego, quédate por la vibra.</p>
					<p class="mt-6 text-sm md:text-[15px] text-white/75 leading-relaxed">Abierto a huéspedes y visitantes. Siempre hay un buen momento esperándote frente al mar.</p>
					<div class="mt-8 flex flex-col sm:flex-row gap-4">
						<a
							href="https://oddmenu.com/es/p/beach-break"
							target="_blank"
							class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300"
						>
							Ver menú
						</a>
						<a
							href="https://maps.app.goo.gl/NwJjTVxUU8TakKxr6"
							target="_blank"
							class="inline-flex items-center justify-center border border-white/35 bg-white/10 text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded transition-all duration-300"
						>
							Cómo llegar
						</a>
					</div>
				</div>
				<div class="lg:col-span-5">
					<div class="overflow-hidden rounded shadow-2xl border border-white/10 aspect-4/5 relative group">
						<img src="/sushi_wave.webp" alt="Atardecer frente al mar en Beach Break" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
