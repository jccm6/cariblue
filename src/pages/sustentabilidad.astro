---
import Layout from '../layouts/Layout.astro';

const coreActions = [
  {
    title: "Limpieza",
    text: "Reducimos 168 galones de envases plásticos al mes al trabajar con proveedores que usan envases retornables o biodegradables."
  },
  {
    title: "Agua Potable",
    text: "Instalamos una estación de agua purificada para que los huéspedes rellenen sus botellas, eliminando el uso de más de 180 botellas plásticas al mes."
  },
  {
    title: "Amenities",
    text: "Sustituimos más de 4.200 botellas pequeñas por dispensadores recargables con productos biodegradables."
  },
  {
    title: "Manejo de residuos",
    text: "Reciclamos y clasificamos los desechos generados en el resort para garantizar su correcta disposición."
  },
  {
    title: "Restaurante",
    text: "Usamos ingredientes frescos, locales y producidos de forma responsable para ofrecer alimentos saludables y sostenibles."
  },
  {
    title: "Toallas de piscina",
    text: "Optamos por toallas de microfibra, que reducen el consumo de agua y energía al secarse más rápido y requerir menos lavados."
  }
];

const alliances = [
  {
    logo: "https://i.imgur.com/IeqyG8A.png",
    title: "Rainforest Alliance",
    text: "Protege y conserva los arrecifes del Caribe. ¿Sabías que el 25% de la vida marina depende de los corales? Promueven la educación ambiental y las limpiezas de playa."
  },
  {
    title: "The Sloth Conservation Foundation",
    logo: "https://i.imgur.com/d8909Kt.png",
    text: "Protege a los osos perezosos, símbolo nacional de Costa Rica. Junto a ellos creamos una red de puentes aéreos que permiten su movilidad segura en la jungla."
  },
  {
    title: "Planta mi Árbol",
    logo: "https://i.imgur.com/XiGAyrg.png",
    text: "Financiamos la plantación de 100 árboles mensuales en zonas deforestadas de Costa Rica, ayudando a restaurar ecosistemas y absorber CO₂."
  },
  {
    title: "Planet Conservation",
    logo: "https://i.imgur.com/rK1M8oH.png",
    text: "Organización dedicada a la protección de tortugas marinas, reciclaje y educación ambiental, ofreciendo también programas de voluntariado."
  },
  {
    title: "Salud para Todos",
    logo: "https://i.imgur.com/Pl7vZe3.png",
    text: "Fundación local que brinda acceso a atención médica básica y de especialidad a las comunidades del Caribe Sur que más lo necesitan."
  },
  {
    title: "Puerto Viejo Limpio",
    logo: "https://i.imgur.com/jh4aTj6.png",
    text: "Proyecto local independiente que impulsa intensas jornadas de limpieza de playas y la concientización ambiental en toda nuestra comunidad."
  }
];

const recommendations = [
  {
    title: "1. Cuidar el espacio y los objetos",
    text: "Cuidar el espacio y los objetos que se encuentran en el hotel, el objetivo es extender la vida útil para así disminuir la demanda de recursos naturales para fabricar nuevos objetos.",
    icon: "https://i.imgur.com/Lc5bg0O.png"
  },
  {
    title: "2. Elegir productos ecológicos",
    text: "Elegir productos con envases reutilizables o sin envases para reducir drásticamente la cantidad de desechos producidos durante tu viaje.",
    icon: "https://i.imgur.com/GDYKk7i.png"
  },
  {
    title: "3. Estaciones de agua potable",
    text: "Rellenar agua en botellas reutilizables en nuestra estación de agua purificada, para disminuir drásticamente el uso de botellas plásticas desechables.",
    icon: "https://i.imgur.com/e1r4dyw.png"
  },
  {
    title: "4. Clasificar residuos",
    text: "Seleccionar y apartar los desechos no orgánicos en los contenedores correctos para facilitar la gestión, reciclaje y compostaje interno del resort.",
    icon: "https://i.imgur.com/axPlXvl.png"
  },
  {
    title: "5. Souvenirs y economía local",
    text: "Compra los souvenirs y regalos a las pequeñas tiendas de artesanías locales, que se fabrican en Puerto Viejo y alrededores de forma justa.",
    icon: "https://i.imgur.com/oYTF1k2.png"
  },
  {
    title: "6. Respetar los senderos",
    text: "Respetar los senderos marcados, no alimentar a animales silvestres, no dejar basura y ojalá traer la basura que se encuentre cuando se salga a pasear.",
    icon: "https://i.imgur.com/wGxootJ.png"
  }
];
---

<Layout 
	title="Sustentabilidad y Eco-compromiso | Cariblue Resort Costa Rica"
	description="Descubre nuestros esfuerzos y programas de sostenibilidad en Cariblue Resort. Prácticas eco-amigables, reducción de plástico y apoyo a la biodiversidad local."
>
	<main>
		<!-- Hero Section Banner -->
		<section class="relative min-h-[40vh] md:min-h-[50vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-black/45 z-10"></div>
				<img 
					src="https://i.imgur.com/FMNK8bT.jpeg" 
					alt="Exuberant tropical jungle canopy background" 
					class="w-full h-full object-cover"
				/>
			</div>
			<div class="relative z-20 max-w-4xl mx-auto mt-8">
				<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
					Sustentabilidad
				</h1>
			</div>
		</section>

		<!-- Sustainability Intro Section -->
		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
					
					<!-- Left Side: Copy details -->
					<div class="col-span-1 lg:col-span-7 text-left">
						<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] mb-6 leading-tight">
							Sustentabilidad
						</h2>
						<div class="space-y-4 text-xs md:text-[13px] text-slate-600 leading-relaxed font-normal">
							<p>
								Cariblue Jungle & Beach Resort está inmerso en más de 20.000 m² de jungla tropical, hogar de una increíble diversidad de vida silvestre.
							</p>
							<p>
								Vivimos en armonía con la naturaleza y trabajamos cada día para protegerla, implementando acciones que reducen nuestro impacto ambiental y promueven el respeto por la flora y fauna que nos rodea.
							</p>
							<p class="font-semibold text-[#0f2e59] italic border-l-2 border-accent pl-4">
								Nuestro compromiso es simple: cuidar este paraíso y compartirlo de forma responsable con quienes nos visitan.
							</p>
						</div>
					</div>

					<!-- Right Side: Sloth/Monkeys Image -->
					<div class="col-span-1 lg:col-span-5">
						<div class="overflow-hidden rounded-lg shadow-2xl relative border border-slate-100 group aspect-video">
							<img 
								src="https://i.imgur.com/go0oipy.png" 
								alt="Monkeys in the trees - Cariblue Sustainability" 
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
							/>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- "Así cuidamos nuestro entorno" Grid -->
		<section class="bg-primary py-24 px-6 md:px-12 lg:px-24 text-white">
			<div class="max-w-7xl mx-auto text-center">
				<div class="mb-14">
					<h2 class="text-3xl md:text-5xl font-serif font-bold mb-4">
						Así cuidamos nuestro entorno
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
					{coreActions.map((action) => (
						<div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-lg p-6 md:p-8 flex flex-col justify-center items-center text-center shadow-lg hover:bg-white/15 transition-all">
							<h3 class="text-base font-bold uppercase tracking-wider mb-3 text-slate-100">{action.title}</h3>
							<p class="text-xs text-slate-200/90 leading-relaxed font-light">{action.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Supported Projects Mid-bar -->
		<section class="relative min-h-87.5 flex items-center justify-center text-white py-24 px-6 overflow-hidden">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-black/60 z-10"></div>
				<img 
					src="https://i.imgur.com/WtPRlPF.jpeg" 
					alt="Jungle canopy green view" 
					class="w-full h-full object-cover"
				/>
			</div>
			<div class="relative z-20 max-w-4xl mx-auto text-center flex flex-col items-center">
				<h2 class="text-2xl md:text-4xl font-serif font-bold tracking-wide leading-tight mb-4 drop-shadow-xl max-w-2xl">
					Proyectos e iniciativas que apoyamos: Juntos por un mejor planeta
				</h2>
				<p class="text-xs md:text-sm font-light max-w-2xl text-slate-200/90 leading-relaxed drop-shadow-md">
					En Cariblue formamos parte de diversas iniciativas locales y globales que promueven la conservación, la educación ambiental y el bienestar de nuestra comunidad. Creemos que el cambio comienza cuando trabajamos juntos.
				</p>
			</div>
		</section>

		<!-- All Alliances Projects Listing -->
		<section class="bg-white py-24 px-6 md:px-12 lg:px-24">
			<div class="max-w-6xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
					{alliances.map((alliance) => (
						<div class="flex flex-col justify-between items-center text-center p-6 bg-white border border-slate-50 shadow-lg rounded-lg hover:shadow-xl transition-shadow duration-300">
							<div>
								<img src={alliance.logo} alt={alliance.title} class="mb-6 m-auto">
								<h3 class="text-sm font-bold text-[#0f2e59] uppercase tracking-wider mb-3 leading-tight">{alliance.title}</h3>
								<p class="text-[11px] text-slate-500 leading-relaxed font-light mb-6">{alliance.text}</p>
							</div>
							<a 
								href="https://wa.me/50683141965" 
								target="_blank"
								class="bg-accent hover:bg-accent text-white font-extrabold text-[10px] tracking-widest uppercase px-6 py-2.5 rounded-xs transition-colors shadow-sm"
							>
								Más Información
							</a>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Recommendations Section -->
		<section class="bg-slate-50/50 py-24 px-6 md:px-12 lg:px-24 border-t border-slate-100">
			<div class="max-w-5xl mx-auto text-center">
				<div class="max-w-3xl mx-auto mb-16 text-center">
					<p class="text-xs md:text-sm text-slate-500 leading-relaxed mb-6 font-normal">
						Cariblue Jungle and Beach Resort se compromete de sobremanera para mantener un ambiente equilibrado con el ecosistema donde se mezclan los esfuerzos tanto de nuestras estrategias, colaboradores y huéspedes.
					</p>
					<p class="text-sm font-bold text-[#0f2e59] tracking-wider uppercase">
						Instamos a nuestros huéspedes a ser parte de este cambio y dejar su huella positiva con las siguientes recomendaciones:
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 text-left">
					{recommendations.map((rec) => (
						<div class="flex flex-col bg-white border border-slate-100 rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300">
							<div class="w-12 h-12 rounded-full bg-slate-50 flex items-center justify-center mb-5 border border-slate-100 shrink-0">
								<img src={rec.icon}/>
							</div>
							<h3 class="text-xs font-bold text-[#0f2e59] uppercase tracking-wider mb-2.5 leading-tight">{rec.title}</h3>
							<p class="text-[11px] text-slate-500 leading-relaxed font-light">{rec.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
</Layout>
