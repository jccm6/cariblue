---
import Layout from '../layouts/Layout.astro';

const dayPassFeatures = [
  {
    title: "Valor",
    text: "El precio es de 15.000 colones por persona. Niños de 5-12 años pagan 50%. Niños menores de 5 años no pagan.",
    image: "https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=800&q=80",
    alt: "Friends raising cocktails by the pool"
  },
  {
    title: "Restaurante",
    text: "El precio es consumible en nuestro bar y restaurante La Jungla, donde podrás disfrutar de platos y bebidas.",
    image: "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=800&q=80",
    alt: "Gourmet burger served on a plate"
  },
  {
    title: "Instalaciones",
    text: "Pueden utilizar todas las instalaciones del hotel tales como, bares, piscinas, restaurantes y espacios comunes y la mesa de pool.",
    image: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=800&q=80",
    alt: "Guests playing pool at the resort lounge"
  },
  {
    title: "Horario",
    text: "El horario es de 11 a 18 hrs.",
    image: "https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=800&q=80",
    alt: "Family enjoying the swimming pool"
  }
];
---

<Layout 
	title="Day Pass | Cariblue Beach & Jungle Resort Costa Rica"
	description="Disfruta un día inolvidable en Cariblue Resort con nuestro Day Pass. Acceso a piscinas, jacuzzis, bares y consumo de 15.000 colones en el restaurante."
>
	<main>
		<!-- Hero Section Banner -->
		<section class="relative min-h-[40vh] md:min-h-[50vh] flex flex-col items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-[#05152b]/50 z-10"></div>
				<img 
					src="https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?auto=format&fit=crop&w=2000&q=80" 
					alt="Pool sunbathing floating lounge background" 
					class="w-full h-full object-cover"
				/>
			</div>
			<div class="relative z-20 max-w-4xl mx-auto mt-8 flex flex-col items-center">
				<h1 class="text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">
					Day Pass
				</h1>
			</div>
		</section>

		<!-- "¿Qué Incluye?" Intro Section -->
		<section class="bg-white py-16 px-6 md:px-12 lg:px-24">
			<div class="max-w-4xl mx-auto text-center flex flex-col items-center">
				<h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-5">
					¿Qué Incluye?
				</h2>
				<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-light max-w-3xl">
					Disfruta de acceso completo a todas nuestras instalaciones durante todo el día por sólo <span class="font-bold text-[#e60067]">₡15.000 consumibles</span> para disfrutar en nuestro restaurante La Jungla, donde podrás deleitarte con nuestros deliciosos platos y cócteles. ¡Disfruta y crea recuerdos inolvidables con amigos y familiares!
				</p>
			</div>
		</section>

		<!-- 4 Detailed Rows Stacked (Left Text, Right Image) -->
		<section class="bg-white pb-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-5xl mx-auto space-y-16 lg:space-y-24">
				{dayPassFeatures.map((feat) => (
					<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-50 pb-16 last:border-0 last:pb-0">
						
						<!-- Text details (7 columns on desktop) -->
						<div class="col-span-1 md:col-span-6 text-left">
							<h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0f2e59] mb-4">
								{feat.title}
							</h3>
							<p class="text-xs md:text-[13px] text-slate-500 leading-relaxed font-normal">
								{feat.text}
							</p>
						</div>

						<!-- Image (5 columns on desktop) -->
						<div class="col-span-1 md:col-span-6">
							<div class="overflow-hidden rounded shadow-xl border border-slate-100 relative group aspect-video">
								<img 
									src={feat.image} 
									alt={feat.alt} 
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								/>
							</div>
						</div>

					</div>
				))}
			</div>
		</section>

		<!-- Call To Action Section -->
		<section class="bg-slate-50/50 py-20 px-6 text-center border-t border-slate-100">
			<div class="max-w-3xl mx-auto">
				<h2 class="text-2xl md:text-4xl font-serif font-bold text-[#0f2e59] mb-8 leading-tight">
					¡No esperes más para pasar un día en Cariblue!
				</h2>
				<a 
					href="https://wa.me/50683141965" 
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block bg-[#e60067] hover:bg-[#c20056] text-white font-bold text-xs tracking-widest uppercase px-12 py-4 rounded shadow-lg hover:shadow-pink-600/30 transition-all duration-300"
				>
					Contáctanos
				</a>
			</div>
		</section>
	</main>
</Layout>
