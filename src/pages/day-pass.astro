---
import Layout from "../layouts/Layout.astro";

const regularFeatures = [
	{
		title: "Instalaciones del resort",
		text: "Acceso a todas las instalaciones del resort.",
	},
	{
		title: "Piscinas",
		text: "Disfruta el uso de nuestras piscinas durante el día.",
	},
	{
		title: "Actividades programadas",
		text: "Acceso a las actividades programadas del hotel durante el día.",
	},
	{
		title: "Consumo incluido",
		text: "₡15.000 consumibles en alimentos y bebidas en Restaurante La Jungla.",
	},
];

const allInclusiveAccess = [
	"Uso de piscinas.",
	"Acceso a las áreas comunes.",
	"Actividades programadas durante el día.",
	"Uso de gimnasio con reserva previa según disponibilidad.",
];

const mealOptions = [
	{
		title: "Opción 1",
		subtitle: "Desayuno Buffet + Almuerzo",
		items: [
			"Desayuno Buffet: 9:00 a.m. – 10:00 a.m.",
			"Almuerzo: 12:00 p.m. – 5:00 p.m.",
			"Incluye entrada del día, plato fuerte a elegir del menú y postre.",
		],
	},
	{
		title: "Opción 2",
		subtitle: "Almuerzo + Cena",
		items: [
			"Almuerzo: 12:00 p.m. – 5:00 p.m.",
			"Cena: 5:00 p.m. – 7:00 p.m.",
			"Cada tiempo incluye entrada del día, plato fuerte y postre.",
		],
	},
];

const openBarItems = [
	"Cervezas nacionales.",
	"Café chorreado.",
	"Té e infusiones.",
	"Leche con chocolate.",
	"Refrescos y gaseosas.",
	"Jugo natural seleccionado del día.",
	"Copa de vino de la casa (blanco, tinto o rosado).",
	"Cócteles seleccionados.",
];
---

<Layout
	title="Day Pass | Cariblue Beach & Jungle Resort Costa Rica"
	description="Vive un día de vacaciones en el Caribe con el Day Pass Regular o Todo Incluido de Cariblue Resort. Disfruta nuestras instalaciones, piscinas, actividades, comidas y barra libre sin hospedarte."
>
	<main>
		<section class="relative min-h-[42vh] md:min-h-[52vh] flex items-center justify-center text-white text-center px-4 overflow-hidden pt-28">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 z-10 bg-linear-to-b from-black/20 via-black/25 to-black/45"></div>
				<img src="https://i.imgur.com/3l7ZTne.png" alt="Huéspedes disfrutando la piscina de Cariblue" class="h-full w-full object-cover" />
			</div>
			<div class="relative z-20 max-w-5xl mx-auto mt-8">
				<p class="text-[11px] md:text-xs font-black tracking-[0.35em] uppercase text-white/80">Cariblue Resort</p>
				<h1 class="mt-4 text-4xl md:text-7xl font-serif font-bold tracking-wide drop-shadow-lg leading-tight select-none">Day Pass Cariblue</h1>
				<p class="mt-5 text-sm md:text-lg font-medium tracking-[0.18em] uppercase text-white/90">Vive un día de vacaciones en el Caribe</p>
				<p class="mt-4 text-sm md:text-base text-white/90">No necesitas hospedarte para disfrutar de la experiencia Cariblue.</p>
			</div>
		</section>

		<section class="bg-white py-20 px-6 md:px-12 lg:px-24">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-6">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Day Pass Regular</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight">Disfruta Cariblue a tu manera</h2>
					<p class="mt-6 text-base md:text-lg text-slate-700 leading-relaxed">Ideal para quienes desean pasar el día en nuestras instalaciones y disfrutar de un excelente día en un ambiente tropical.</p>
					<p class="mt-4 text-sm md:text-[15px] text-slate-600 leading-relaxed">Perfecto para disfrutar cumpleaños, aniversarios u otros momentos especiales.</p>
					<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div class="rounded bg-[#0f2e59] px-5 py-5 text-white shadow-lg">
							<p class="text-[11px] font-black tracking-[0.2em] uppercase text-white/70">Precio</p>
							<p class="mt-2 text-2xl font-serif font-bold">₡15.000</p>
							<p class="mt-1 text-sm text-white/80">por persona</p>
						</div>
						<div class="rounded border border-[#eadbc7] bg-[#f6efe4] px-5 py-5">
							<p class="text-[11px] font-black tracking-[0.2em] uppercase text-accent">Política para niños</p>
							<p class="mt-2 text-sm text-slate-700 leading-relaxed">0 a 2 años: ingreso sin plan de comidas. 3 a 12 años: pagan el 50% de la tarifa.</p>
						</div>
					</div>
					<p class="mt-6 text-sm font-semibold text-[#0f2e59]">Grupos +10 personas requieren reservación previa.</p>
					<a href="https://wa.me/50683141965" target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center justify-center bg-accent text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300">Reserva grupos aquí</a>
				</div>
				<div class="lg:col-span-6">
					<div class="overflow-hidden rounded shadow-2xl border border-slate-100 aspect-5/4 relative group">
						<img src="https://i.imgur.com/Pb4VtVh.png" alt="Amigos disfrutando bebidas junto a la piscina" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
				</div>
			</div>

			<div class="max-w-7xl mx-auto mt-16">
				<div class="flex items-center gap-4 mb-8">
					<div class="h-px flex-1 bg-slate-200"></div>
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-[#0f2e59]">Incluye</p>
					<div class="h-px flex-1 bg-slate-200"></div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
					{regularFeatures.map((item, index) => (
						<div class="rounded bg-[#0f2e59] px-6 py-7 text-white shadow-lg">
							<div class="flex items-center justify-center w-12 h-12 rounded-full bg-white/12 border border-white/15 mb-5 text-lg font-bold">{index + 1}</div>
							<h3 class="text-base font-bold tracking-wide mb-3">{item.title}</h3>
							<p class="text-sm text-white/78 leading-relaxed">{item.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-[#f6efe4] py-20 px-6 md:px-12 lg:px-24 border-y border-[#eadbc7]">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="lg:col-span-5 order-2 lg:order-1">
					<div class="overflow-hidden rounded shadow-2xl border border-white/50 aspect-4/5 relative group">
						<img src="https://i.imgur.com/xUxe0xj.png" alt="Comida servida en Restaurante La Jungla" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
				</div>
				<div class="lg:col-span-7 order-1 lg:order-2">
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-accent mb-4">Day Pass Todo Incluido</p>
					<h2 class="text-3xl md:text-5xl font-serif font-bold text-[#0f2e59] leading-tight">La experiencia Cariblue sin límites</h2>
					<p class="mt-6 text-sm md:text-[15px] text-slate-700 leading-relaxed">Disfruta un día completo con comidas, bebidas, acceso a las instalaciones y todo lo necesario para relajarte.</p>
					<p class="mt-4 text-sm md:text-[15px] text-slate-700 leading-relaxed">Perfecto para parejas, familias y grupos que desean vivir la experiencia All Inclusive sin hospedarse.</p>
					<div class="mt-8 rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
						<h3 class="text-xl font-serif font-bold text-[#0f2e59] mb-4">Acceso al hotel</h3>
						<ul class="space-y-2 text-sm text-slate-600 leading-relaxed list-disc list-inside">
							{allInclusiveAccess.map((item) => <li>{item}</li>)}
						</ul>
						<p class="mt-4 text-sm font-semibold text-[#0f2e59]">Grupos +10 personas requieren reservación previa.</p>
					</div>
				</div>
			</div>

			<div class="max-w-7xl mx-auto mt-16">
				<div class="flex items-center gap-4 mb-8">
					<div class="h-px flex-1 bg-[#eadbc7]"></div>
					<p class="text-[11px] md:text-xs font-black tracking-[0.28em] uppercase text-[#0f2e59]">Comidas y bebidas</p>
					<div class="h-px flex-1 bg-[#eadbc7]"></div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					{mealOptions.map((option) => (
						<div class="rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
							<p class="text-[11px] font-black tracking-[0.2em] uppercase text-accent mb-2">{option.title}</p>
							<h3 class="text-xl font-serif font-bold text-[#0f2e59] mb-4">{option.subtitle}</h3>
							<ul class="space-y-2 text-sm text-slate-600 leading-relaxed list-disc list-inside">
								{option.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))}
				</div>

				<div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-5">
					<div class="rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
						<h3 class="text-xl font-serif font-bold text-[#0f2e59] mb-3">Snack</h3>
						<p class="text-sm text-slate-600 leading-relaxed">Incluye 1 snack personal por persona, disponible en nuestro Wet Bar.</p>
					</div>
					<div class="rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
						<h3 class="text-xl font-serif font-bold text-[#0f2e59] mb-3">Barra libre</h3>
						<p class="text-sm text-slate-600 leading-relaxed mb-4">Disponible de 11:00 a.m. a 6:00 p.m. en La Jungla y Wet Bar.</p>
						<ul class="space-y-2 text-sm text-slate-600 leading-relaxed list-disc list-inside">
							{openBarItems.map((item) => <li>{item}</li>)}
						</ul>
						<p class="mt-4 text-xs text-slate-500 leading-relaxed">Los licores premium y cócteles no seleccionados tienen un costo adicional.</p>
					</div>
				</div>
			</div>

			<div class="max-w-7xl mx-auto mt-16 grid grid-cols-1 lg:grid-cols-12 gap-5">
				<div class="lg:col-span-5 overflow-hidden rounded shadow-xl border border-white/50 aspect-5/4 relative group">
					<img src="https://i.imgur.com/Vf3BfEO.png" alt="Área de entretenimiento en Cariblue" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
				</div>
				<div class="lg:col-span-3 rounded bg-[#0f2e59] px-6 py-7 text-white shadow-lg flex flex-col justify-center">
					<p class="text-[11px] font-black tracking-[0.2em] uppercase text-white/70">Horario del Wet Bar</p>
					<p class="mt-3 text-2xl font-serif font-bold">12:00 p.m. – 5:00 p.m.</p>
				</div>
				<div class="lg:col-span-4 self-stretch min-h-[260px] lg:min-h-0 overflow-hidden rounded shadow-xl border border-white/50 relative group">
					<img src="https://i.imgur.com/kDB5tha.png" alt="Familia disfrutando la piscina de Cariblue" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
				</div>
			</div>

			<div class="max-w-7xl mx-auto mt-16 grid grid-cols-1 md:grid-cols-2 gap-5">
				<div class="rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
					<h3 class="text-xl font-serif font-bold text-[#0f2e59] mb-3">Niños</h3>
					<p class="text-sm text-slate-600 leading-relaxed">Niños de 0 a 2 años: ingreso sin plan de comidas.</p>
					<p class="mt-2 text-sm text-slate-600 leading-relaxed">Niños de 3 a 11 años: pagan el 50% de la tarifa, con menú infantil.</p>
				</div>
				<div class="rounded bg-white/80 backdrop-blur px-6 py-6 border border-[#eadbc7] shadow-sm">
					<h3 class="text-xl font-serif font-bold text-[#0f2e59] mb-3">Precio</h3>
					<p class="text-sm text-slate-600 leading-relaxed"><span class="font-bold text-[#0f2e59]">Adultos:</span> ₡40.000 por persona</p>
					<p class="mt-2 text-sm text-slate-600 leading-relaxed"><span class="font-bold text-[#0f2e59]">Niños (3 a 11 años):</span> ₡20.000 por niño</p>
				</div>
			</div>

			<div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="https://wa.me/50683141965" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-[#0f2e59] text-white font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded shadow-lg transition-all duration-300">Reserva grupos aquí</a>
				<a href="https://maps.app.goo.gl/NwJjTVxUU8TakKxr6" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center border border-[#0f2e59]/15 bg-white text-[#0f2e59] font-extrabold text-xs tracking-[0.18em] uppercase px-8 py-4 rounded transition-all duration-300">Cómo llegar</a>
			</div>
		</section>
	</main>
</Layout>
