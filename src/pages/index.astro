---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import Rooms from '../components/Rooms.astro';
import VacationBanner from '../components/VacationBanner.astro';
import ViveCaribe from '../components/ViveCaribe.astro';
import Testimonials from '../components/Testimonials.astro';
import Sustainability from '../components/Sustainability.astro';
import FindUs from '../components/FindUs.astro';
---

<Layout 
	title="Cariblue Beach & Jungle Resort | Puerto Viejo, Costa Rica"
	description="Bienvenido a Cariblue Beach & Jungle Resort en Playa Cocles, Puerto Viejo. Experimenta la mezcla perfecta de jungla y playa en nuestro resort de lujo en el Caribe costarricense."
>
	<!-- Hero Section & Booking Bar -->
	<Hero />

	<!-- Welcome Description & Stats Dashboard -->
	<Welcome />

	<!-- Rooms Slider -->
	<Rooms />

	<!-- Interactive Vacation Video Callout -->
	<VacationBanner />

	<!-- Brand Split and Nature Slideshow -->
	<ViveCaribe />

	<!-- Booking/TripAdvisor Testimonials -->
	<Testimonials />

	<!-- Sustainability Columns -->
	<Sustainability />

	<!-- Contact Map & Phone Widget -->
	<FindUs />
</Layout>
